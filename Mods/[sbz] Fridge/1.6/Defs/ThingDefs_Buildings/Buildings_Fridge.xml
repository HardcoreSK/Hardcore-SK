<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef Name="sbzFridgeBase" ParentName="AdaptiveStorageBase" Abstract="True">
		<fillPercent>0.3</fillPercent>
		<rotatable>true</rotatable>
		<defaultPlacingRot>North</defaultPlacingRot>
		<researchPrerequisites>
			<li>AirConditioning</li>
		</researchPrerequisites>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
           	<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<fixedStorageSettings>
				<filter>
					<categories>
                        <li>Foods</li>
						<li>Manufactured</li>
						<li>ResourcesRaw</li>
						<li>Items</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Normal</priority>
				<filter>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<isHopper>true</isHopper>
			<paintable>true</paintable>
		</building>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsNeatStorage</li>
		</thingCategories>
		<designationCategory Inherit="false">Temperature</designationCategory>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(100,100,130,0)</glowColor>
				<colorPickerEnabled>true</colorPickerEnabled>
				<darklightToggle>true</darklightToggle>
			</li>
		</comps>
		<modExtensions>
			<li Class="AdaptiveStorage.Extension">
				<temperature>
					<coolingOffset>100</coolingOffset>
					<coolingMin>-10</coolingMin>
				</temperature>
			</li>
		</modExtensions>
	</ThingDef>

