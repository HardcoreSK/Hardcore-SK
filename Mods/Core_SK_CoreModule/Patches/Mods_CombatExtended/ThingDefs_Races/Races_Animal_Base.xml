<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="BasePawn"]</xpath>
		<value>
			<statBases Merge="true">
				<MeleeDodgeChance>0</MeleeDodgeChance>
				<MeleeCritChance>0</MeleeCritChance>
				<MeleeParryChance>0</MeleeParryChance>
			</statBases>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="BasePawn"]/inspectorTabs/li[.="ITab_Pawn_Gear"]</xpath>
		<value>
			<li>CombatExtended.ITab_Inventory</li>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="BasePawn"]</xpath>
		<value>
			<comps Merge="true">
				<li>
					<compClass>CombatExtended.CompPawnGizmo</compClass>
				</li>
				<li Class="CombatExtended.CompProperties_Inventory" />
				<li Class="CombatExtended.CompProperties_TacticalManager" />
			</comps>
		</value>
	</Operation>

	<!-- Remove comp added by CE in BaseMechanoid. Mechanoids still inherit this Comp from BasePawn-->
<!-- 	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[@Name="BaseMechanoid"]/comps/li[compClass="CombatExtended.CompPawnGizmo"]</xpath>
	</Operation> -->

</Patch>
