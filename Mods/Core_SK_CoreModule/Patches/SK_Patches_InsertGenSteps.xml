<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/MapGeneratorDef[@Name = "MapCommonBase"]/genSteps</xpath>
        <value>
            <li>AlgaeSpawn</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
      <xpath>Defs/MapGeneratorDef[@Name="Base_Player"]/genSteps</xpath>
      <value>
        <li>ScatterAncientStargate</li>
        <li>ScatterWoodenDebris</li>
        <li>ScatterCairns</li>
        <li>ScatterCrashedShipWrecks</li>
        <li>ScatterShipWrecks</li>
      </value>
    </Operation>
    
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/MapGeneratorDef[defName="Encounter"]/genSteps/li["RocksFromGrid_NoMinerals"]</xpath>
        <value>
            <li>RocksFromGrid</li>
        </value>
    </Operation>

    <!-- Minerals -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GenStepDef[defName = "PreciousLump"]/genStep[@Class = "GenStep_PreciousLump"]/mineables</xpath>
        <value>
            <mineables>
                <li>SolidOreGold</li>
                <li>SolidOreSilver</li>
                <li>SolidOreSteel</li>
                <li>SolidOreNickel</li>
                <li>WeatheredOreTech</li>
                <li>SolidOreUranium</li>
                <li>SolidOreJade</li>
                <li>SolidOreTungsten</li>
                <li>SolidOreTitanium</li>
                <li>SolidOreAluminum</li>
                <li>SolidOreCopper</li>
                <li>SolidOreTin</li>
                <li>SolidOreCoal</li>
                <li>SolidOreLead</li>
                <li>SolidOreNitre</li>
                <li>SolidOreSalt</li>
                <li>SolidOreGlowstone</li>
                <li>SolidOreColdstone</li>
            </mineables>
        </value>
    </Operation>

    <!-- Long Range Scanner -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/GenStepDef[defName="PreciousLump"]/genStep[@Class="GenStep_PreciousLump"]/totalValueRange</xpath>
        <value>
            <totalValueRange>
                <min>3500</min>
                <max>30000</max>
            </totalValueRange>
        </value>
    </Operation>
</Patch>
