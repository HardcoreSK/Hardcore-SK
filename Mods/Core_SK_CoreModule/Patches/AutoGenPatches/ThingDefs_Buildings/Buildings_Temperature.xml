<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Campfire"]</xpath>
    <value>
      <drawerType>MapMeshAndRealTime</drawerType>
      <fillPercent>0.1</fillPercent>
      <statBases Merge="true">
        <MaxHitPoints>20</MaxHitPoints>
        <WorkToBuild>300</WorkToBuild>
        <Flammability>0</Flammability>
        <WorkTableWorkSpeedFactor>0.7</WorkTableWorkSpeedFactor>
        <MeditationFocusStrength>0</MeditationFocusStrength>
      </statBases>
      <size>(1,1)</size>
      <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
      <inspectorTabs>
        <li>SK.ITab_Fuel</li>
        <li>ITab_Bills</li>
      </inspectorTabs>
      <comps>
        <li>
          <compClass>CompGatherSpot</compClass>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>8</glowRadius>
          <glowColor>(252,187,113,0)</glowColor>
        </li>
        <li Class="SK.CompProperties_HeatPusherAdvanced">
          <compClass>SK.CompHeatPusherAdvanced</compClass>
          <heatPerSecond>18</heatPerSecond>
          <heatPushMaxTemperature>30</heatPushMaxTemperature>
        </li>
        <li Class="SK.CompFueled_Properties">
          <operatingTemp>300</operatingTemp>
          <fireDrawOffset>(0,0.15,0.25)</fireDrawOffset>
          <smokeDrawOffset>(0,0,0.1)</smokeDrawOffset>
          <fuelDrawOffset>(0,0.1,0.01)</fuelDrawOffset>
          <fuelDrawScale>0.7</fuelDrawScale>
          <fuelCapacity>10</fuelCapacity>
          <burnFuelMultiplier>1</burnFuelMultiplier>
          <smokesize>0.3</smokesize>
          <canAutoBurn>true</canAutoBurn>
          <effectOnWeather>true</effectOnWeather>
          <smokeDensity>2</smokeDensity>
          <fuelFilter>
            <thingDefs>
              <li>Charcoal</li>
              <li>Coal</li>
              <li>Kindling</li>
              <li>Tallow</li>
            </thingDefs>
            <categories>
              <li>Wooden</li>
              <li>Woody</li>
            </categories>
          </fuelFilter>
        </li>
        <li Class="CompProperties_MeditationFocus">
          <statDef>MeditationFocusStrength</statDef>
          <focusTypes>
            <li>Flame</li>
          </focusTypes>
          <offsets>
            <li Class="FocusStrengthOffset_Lit">
              <offset>0.12</offset>
            </li>
            <li Class="FocusStrengthOffset_BuildingDefsLit">
              <defs>
                <li>Campfire</li>
                <li>BowlLamp</li>
                <li>Candle</li>
                <li>TorchLamp</li>
                <li>TorchWallLamp</li>
                <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
                <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
                <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
                <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
              </defs>
              <radius>9.9</radius>
              <maxBuildings>8</maxBuildings>
              <offsetPerBuilding>0.02</offsetPerBuilding>
              <explanationKey>MeditationFocusPerFlame</explanationKey>
              <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
            </li>
          </offsets>
        </li>
      </comps>
      <recipes>
        <li>CremateCorpse</li>
        <li>BurnApparel</li>
        <li>BurnDrugs</li>
        <li>BurnWeapon</li>
        <li>BurnThings</li>
        <li>RoastingCoffeeBeans</li>
        <li>BrewCoffeeSingle</li>
        <li>MakeCharcoal_Hand</li>
        <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFood</li>
        <li MayRequire="Ludeon.RimWorld.Biotech">Make_BabyFoodBulk</li>
      </recipes>
    </value>
  </Operation>


  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Heater"]</xpath>
    <value>
      <pathCost>40</pathCost>
      <canOverlapZones>false</canOverlapZones>
      <statBases Merge="true">
        <WorkToBuild>600</WorkToBuild>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>50</costStuffCount>
      <costList>
        <ComponentIndustrial>5</ComponentIndustrial>
        <ElectronicComponents>3</ElectronicComponents>
        <Mechanism>3</Mechanism>
      </costList>
      <researchPrerequisites>
        <li>AirConditioning</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="PassiveCooler"]</xpath>
    <value>
      <description>A traditional unpowered cooler that works by water evaporation. While it's not strong enough to refridgerate food, it can help survive a heat wave.</description>
      <canOverlapZones>false</canOverlapZones>
      <pathCost>50</pathCost>
      <statBases Merge="true">
        <WorkToBuild>120</WorkToBuild>
        <Flammability>0</Flammability>
      </statBases>
      <costList>
        <ComponentMedieval>20</ComponentMedieval>
      </costList>
      <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
      <comps Merge="true">
        <li Class="CompProperties_HeatPusher">
          <compClass>CompHeatPusherPowered</compClass>
          <heatPerSecond>-13</heatPerSecond>
          <heatPushMinTemperature>15</heatPushMinTemperature>
        </li>
      </comps>
      <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Cooler"]</xpath>
    <value>
      <blocksAltitudes>
        <li>BuildingOnTop</li>
      </blocksAltitudes>
      <graphicData>
        <texPath>Things/Building/Temperature/Cooler/CoolerB</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <damageData>
          <cornerTL>Damage/Corner</cornerTL>
          <cornerTR>Damage/Corner</cornerTR>
          <cornerBL>Damage/Corner</cornerBL>
          <cornerBR>Damage/Corner</cornerBR>
        </damageData>
      </graphicData>
      <altitudeLayer>PawnUnused</altitudeLayer>
      <fillPercent>0.99</fillPercent>
      <clearBuildingArea>false</clearBuildingArea>
      <statBases Merge="true">
        <Beauty>-6</Beauty>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>70</costStuffCount>
      <costList>
        <ComponentIndustrial>7</ComponentIndustrial>
        <ElectronicComponents>3</ElectronicComponents>
        <Mechanism>3</Mechanism>
      </costList>
      <placeWorkers>
        <li>PlaceWorker_Cooler</li>
        <li>SK.PlaceWorker_OnlyOnThing</li>
        <li>SK.PlaceWorker_OnWall</li>
      </placeWorkers>
      <building>
        <canPlaceOverWall>true</canPlaceOverWall>
        <isEdifice>false</isEdifice>
      </building>
      <comps>
        <li Class="SK.CompProperties_RestrictedPlacement">
          <compClass>SK.CompRestrictedPlacement</compClass>
          <thingDefs>
            <li>Wall</li>
            <li>ClutterSilverWall</li>
            <li>UtilityWall</li>
            <li>ClutterUWallLight</li>
            <li MayRequire="ludeon.rimworld.odyssey">GravshipHull</li>
          </thingDefs>
        </li>
        <li Class="SK.CompProperties_IdlePower">
          <soundPowerOn>Power_OnSmall</soundPowerOn>
          <soundPowerOff>Power_OffSmall</soundPowerOff>
          <basePowerConsumption>350</basePowerConsumption>
        </li>
        <li Class="CompProperties_TempControl">
          <compClass>CompTempControl</compClass>
          <energyPerSecond>-36</energyPerSecond>
        </li>
        <li Class="CompProperties_Flickable"/>
        <li Class="CompProperties_Breakdownable"/>
      </comps>
      <researchPrerequisites>
        <li>Temperature_control_C2</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Vent"]</xpath>
    <value>
      <label>closable vent</label>
      <thingClass>SK.Building_ClosableVent</thingClass>
      <graphicData>
        <texPath>Things/Building/Temperature/Vent/ActiveVent</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <damageData>
          <cornerTL>Damage/Corner</cornerTL>
          <cornerTR>Damage/Corner</cornerTR>
          <cornerBL>Damage/Corner</cornerBL>
          <cornerBR>Damage/Corner</cornerBR>
        </damageData>
      </graphicData>
      <altitudeLayer>BuildingOnTop</altitudeLayer>
      <passability>PassThroughOnly</passability>
      <blockLight>false</blockLight>
      <castEdgeShadows>false</castEdgeShadows>
      <fillPercent>1</fillPercent>
      <statBases Merge="true">
        <WorkToBuild>700</WorkToBuild>
      </statBases>
      <size>(1,1)</size>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>35</costStuffCount>
      <costList>
        <ComponentIndustrial>3</ComponentIndustrial>
        <Mechanism>1</Mechanism>
      </costList>
      <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
      <placeWorkers>
        <li>PlaceWorker_Vent</li>
        <li>SK.PlaceWorker_OnlyOnWall</li>
      </placeWorkers>
      <modExtensions>
        <li Class="SK.WallAttachmentExtension"/>
      </modExtensions>
      <building>
        <canPlaceOverWall>true</canPlaceOverWall>
        <canExchangeVacuum>true</canExchangeVacuum>
        <isEdifice>true</isEdifice>
      </building>
      <comps>
        <li Class="CompProperties_Flickable">
          <commandTexture>UI/Commands/Vent</commandTexture>
          <commandLabelKey>CommandDesignateOpenCloseVentLabel</commandLabelKey>
          <commandDescKey>CommandDesignateOpenCloseVentDesc</commandDescKey>
        </li>
        <li Class="SK.CompProperties_RestrictedPlacement">
          <compClass>SK.CompRestrictedPlacement</compClass>
        </li>
      </comps>
      <researchPrerequisites>
        <li>AirConditioning</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    </value>
  </Operation>

</Patch>
