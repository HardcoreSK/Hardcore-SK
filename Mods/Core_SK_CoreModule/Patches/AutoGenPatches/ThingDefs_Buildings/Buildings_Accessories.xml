<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="PlantPot"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.PlantGrowerBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="PlantPot"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Building/Furniture/Pots/circleflowerbed</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData>
          <volume>(0.5, 0.2, 0.5)</volume>
        </shadowData>
        <damageData>
          <rect>(0.2,0.2,0.6,0.6)</rect>
        </damageData>
        <drawSize>(1.0,1.0)</drawSize>
        <shaderType>CutoutComplex</shaderType>
      </graphicData>
      <size>(1,1)</size>
      <minifiedDef>MinifiedThing</minifiedDef>
      <statBases Merge="true">
        <MaxHitPoints>100</MaxHitPoints>
        <WorkToBuild>410</WorkToBuild>
        <Beauty>5</Beauty>
        <Bulk>13</Bulk>
        <Mass>4</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
      </statBases>
      <costList>
        <Fertilizer>5</Fertilizer>
      </costList>
      <stuffCategories Merge="true">
        <li>Metallic</li>
        <li>Woody</li>
        <li>Plastic</li>
        <li>Precious</li>
        <li>Glass</li>
        <li>Ceramic</li>
      </stuffCategories>
      <costStuffCount>14</costStuffCount>
	  <comps/>
      <building>
        <defaultPlantToGrow>Plant_Dandelion</defaultPlantToGrow>
        <uninstallWork>200</uninstallWork>
        <sowTag>Decorative</sowTag>
        <paintable>true</paintable>
      </building>
      <researchPrerequisites>
        <li>Accessory_B1</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="LampBase"]</xpath>
    <value>
		<pathCost>0</pathCost>
		<building>
			<uninstallWork>200</uninstallWork>
		</building>
		<designationCategory>Accessories</designationCategory>
		<thingCategories>
			<li>BuildingsAccessories</li>
		</thingCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="StandingLamp"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.SK_LampBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="StandingLamp"]</xpath>
    <value>
      <thingClass>SK.Building_Lamp</thingClass>
      <graphicData>
        <texPath>Things/Building/Furniture/Lights/lamp</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData>
          <volume>(0.3, 0.6, 0.3)</volume>
          <offset>(0,0,-0.1)</offset>
        </shadowData>
        <damageData>
          <rect>(0.2,0.2,0.6,0.6)</rect>
        </damageData>
      </graphicData>
      <fillPercent>0.20</fillPercent>
      <minifiedDef>MinifiedThing</minifiedDef>
      <statBases>
        <MaxHitPoints>60</MaxHitPoints>
        <WorkToBuild>850</WorkToBuild>
        <Bulk>17</Bulk>
        <Mass>5</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
      </statBases>
      <description>A standing lamp that lights an area. Requires 80 W. People need light to move and work at full speed.</description>
      <costList>
        <ComponentIndustrial>3</ComponentIndustrial>
        <Glass>5</Glass>
        <ElectronicComponents>1</ElectronicComponents>
      </costList>
      <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
      <comps>
        <li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
          <basePowerConsumption>80</basePowerConsumption>
          <shortCircuitInRain>false</shortCircuitInRain>
          <soundPowerOn>Power_OnSmall</soundPowerOn>
          <soundPowerOff>Power_OffSmall</soundPowerOff>
          <powerUpgrades>
            <li>
              <researchProject>ColoredLights</researchProject>
              <factor>0.5</factor>
            </li>
          </powerUpgrades>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>12</glowRadius>
          <glowColor>(217,217,208,0)</glowColor>
          <colorPickerEnabled>true</colorPickerEnabled>
          <darklightToggle>true</darklightToggle>
        </li>
        <li Class="CompProperties_Flickable"/>
      </comps>
      <building>
        <uninstallWork>150</uninstallWork>
      </building>
      <rotatable>false</rotatable>
      <filthLeaving>Filth_BrokenGlass</filthLeaving>
      <researchPrerequisites>
        <li>Light_C1</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="TorchLamp"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.SK_LampBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="TorchLamp"]</xpath>
    <value>
      <description>A wooden torch for lighting an area. People need light to move and work at full speed. Can be refueled with kindling. Produces a small amount of heat.</description>
      <graphicData>
        <texPath>Things/Building/Furniture/Lights/torch</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawRotated>false</drawRotated>
        <shadowData>
          <volume>(0.2, 0.3, 0.2)</volume>
          <offset>(0,0,0)</offset>
        </shadowData>
        <damageData>
          <rect>(0.35,0.35,0.3,0.3)</rect>
        </damageData>
      </graphicData>
      <rotatable>false</rotatable>
      <pathCost>8</pathCost>
      <tickerType>Normal</tickerType>
      <drawerType>RealtimeOnly</drawerType>
      <fillPercent>0.15</fillPercent>
      <minifiedDef>MinifiedThing</minifiedDef>
      <statBases>
        <MaxHitPoints>80</MaxHitPoints>
        <WorkToBuild>130</WorkToBuild>
        <Flammability>0</Flammability>
        <Bulk>7</Bulk>
        <Mass>2</Mass>
        <MeditationFocusStrength>0.0</MeditationFocusStrength>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
      </statBases>
      <stuffCategories>
        <li>Kindlingstuff</li>
      </stuffCategories>
      <costStuffCount>10</costStuffCount>
      <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
      <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
      <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
      <comps>
        <li Class="CompProperties_Refuelable">
          <fuelConsumptionRate>4.0</fuelConsumptionRate>
          <fuelCapacity>10.0</fuelCapacity>
          <fuelConsumptionPerTickInRain>0.045</fuelConsumptionPerTickInRain>
          <fuelFilter>
            <thingDefs>
              <li>Kindling</li>
            </thingDefs>
          </fuelFilter>
          <initialFuelPercent>0</initialFuelPercent>
          <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>9</glowRadius>
          <glowColor>(217,177,113,0)</glowColor>
        </li>
        <li Class="SK.CompProperties_HeatPusherAdvanced">
          <compClass>SK.CompHeatPusherAdvanced</compClass>
          <heatPerSecond>4</heatPerSecond>
          <heatPushMaxTemperature>23</heatPushMaxTemperature>
        </li>
        <li Class="SK.CompProperties_FireOverlayMod">
          <fireSize>0.3</fireSize>
          <offset>(0.55,0.0,0.0)</offset>
        </li>
        <li Class="CompProperties_MeditationFocus">
          <statDef>MeditationFocusStrength</statDef>
          <focusTypes>
            <li>Flame</li>
          </focusTypes>
          <offsets>
            <li Class="FocusStrengthOffset_Lit">
              <offset>0.1</offset>
            </li>
            <li Class="FocusStrengthOffset_BuildingDefsLit">
              <defs>
                <li>Campfire</li>
                <li>BowlLamp</li>
                <li>Candle</li>
                <li>TorchLamp</li>
                <li>TorchWallLamp</li>
                <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
                <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
                <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
                <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
              </defs>
              <offsetPerBuilding>0.01</offsetPerBuilding>
              <radius>9.9</radius>
              <maxBuildings>8</maxBuildings>
              <explanationKey>MeditationFocusPerFlame</explanationKey>
              <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
              <drawRingRadius>false</drawRingRadius>
            </li>
          </offsets>
        </li>
      </comps>
      <building>
        <uninstallWork>30</uninstallWork>
        <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      </building>
      <constructionSkillPrerequisite>1</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="WallLamp"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.SK_LampBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="WallLamp"]</xpath>
    <value>
      <thingClass>SK.Building_Lamp</thingClass>
      <graphicData>
        <texPath>Things/Building/Furniture/Lights/walllamp</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1.0,2.0)</drawSize>
        <drawRotated>true</drawRotated>
        <allowFlip>true</allowFlip>
      </graphicData>
      <uiIconPath>Things/Building/Furniture/Lights/walllamp_ui</uiIconPath>
      <altitudeLayer>PawnUnused</altitudeLayer>
      <fillPercent>0.2</fillPercent>
      <drawerType>RealtimeOnly</drawerType>
      <minifiedDef>MinifiedThing</minifiedDef>
      <statBases>
        <MaxHitPoints>65</MaxHitPoints>
        <WorkToBuild>360</WorkToBuild>
        <Beauty>10</Beauty>
        <Bulk>8</Bulk>
        <Mass>3</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">4</StyleDominance>
      </statBases>
      <description>A lamp that must be placed against a supporting wall. People need light to move and work at full speed. Requires 80 W. It has a bigger glow than most lights.</description>
      <costList>
        <Glass>5</Glass>
        <ComponentIndustrial>3</ComponentIndustrial>
        <ElectronicComponents>1</ElectronicComponents>
      </costList>
      <comps>
        <li Class="CompProperties_Flickable"/>
        <li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
          <basePowerConsumption>80</basePowerConsumption>
          <shortCircuitInRain>false</shortCircuitInRain>
          <soundPowerOn>Power_OnSmall</soundPowerOn>
          <soundPowerOff>Power_OffSmall</soundPowerOff>
          <powerUpgrades>
            <li>
              <researchProject>ColoredLights</researchProject>
              <factor>0.5</factor>
            </li>
          </powerUpgrades>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>10</glowRadius>
          <glowColor>(217,217,208,0)</glowColor>
          <colorPickerEnabled>true</colorPickerEnabled>
          <darklightToggle>true</darklightToggle>
        </li>
        <li Class="SK.CompProperties_RestrictedPlacement">
          <compClass>SK.CompRestrictedPlacement</compClass>
        </li>
      </comps>
      <tickerType>Rare</tickerType>
      <placeWorkers>
        <li>SK.PlaceWorker_NotOnWall</li>
        <li>SK.PlaceWorker_WallAttachment</li>
      </placeWorkers>
      <building>
        <uninstallWork>400</uninstallWork>
        <isEdifice>false</isEdifice>
        <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      </building>
      <clearBuildingArea>false</clearBuildingArea>
      <designationHotKey>Misc3</designationHotKey>
      <researchPrerequisites>
        <li>Light_C2</li>
      </researchPrerequisites>
      <filthLeaving>Filth_BrokenGlass</filthLeaving>
      <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
      <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    </value>
  </Operation>

</Patch>
