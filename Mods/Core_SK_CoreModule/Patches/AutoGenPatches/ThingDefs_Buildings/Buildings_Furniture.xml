      <statBases>
        <MaxHitPoints>100</MaxHitPoints>
        <WorkToBuild>1100</WorkToBuild>
        <Mass>23</Mass>
        <Bulk>75</Bulk>
        <Flammability>1.0</Flammability>
        <Beauty>10</Beauty>
      </statBases>
      <size>(1,1)</size>
      <stuffCategories>
        <li>Metallic</li>
        <li>Woody</li>
        <li>Plastic</li>
        <li>Precious</li>
      </stuffCategories>
      <costStuffCount>25</costStuffCount>
      <costList>
        <ComponentIndustrial>4</ComponentIndustrial>
        <Glass>3</Glass>
        <ElectronicComponents>1</ElectronicComponents>
      </costList>
      <pathCost>70</pathCost>
      <passability>PassThroughOnly</passability>
      <rotatable>true</rotatable>
      <tickerType>Rare</tickerType>
      <comps>
        <li Class="CompProperties_Flickable"/>
        <li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
          <basePowerConsumption>20</basePowerConsumption>
          <soundPowerOn>Power_OnSmall</soundPowerOn>
          <soundPowerOff>Power_OffSmall</soundPowerOff>
          <powerUpgrades>
            <li>
              <researchProject>ColoredLights</researchProject>
              <factor>0.5</factor>
            </li>
          </powerUpgrades>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>4</glowRadius>
          <glowColor>(217,217,208,0)</glowColor>
          <colorPickerEnabled>true</colorPickerEnabled>
          <darklightToggle>true</darklightToggle>
        </li>
        <li Class="CompProperties_Facility">
          <statOffsets>
            <BedRestEffectiveness>0.06</BedRestEffectiveness>
            <Comfort>0.09</Comfort>
            <Beauty>4</Beauty>
          </statOffsets>
          <maxSimultaneous>1</maxSimultaneous>
          <mustBePlacedAdjacentCardinalToBedHead>true</mustBePlacedAdjacentCardinalToBedHead>
        </li>
      </comps>
      <filthLeaving>Filth_BrokenGlass</filthLeaving>
      <researchPrerequisites>
        <li>Beds_C2</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    </value>
