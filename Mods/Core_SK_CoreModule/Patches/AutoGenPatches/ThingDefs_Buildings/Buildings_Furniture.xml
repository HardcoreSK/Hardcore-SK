  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="EndTable"]</xpath>
    <value>
      <label>end table with lamp</label>
      <description>A small table with a lamp and a drawer. It would be a nice addition beside a bed. Uses 20 W to light a small area.</description>
      <thingClass>SK.ClothLocker</thingClass>
      <graphicData>
        <texPath>Things/Building/Furniture/Containers/ellightnightstand</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>CutoutComplex</shaderType>
