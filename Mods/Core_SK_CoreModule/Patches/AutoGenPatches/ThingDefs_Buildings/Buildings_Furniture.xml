<Patch>

<!-- StandardBuilding inherits BuildingBase 
	So StandardBuilding stats added to FurnitureBase to include
	As im unsure of compatibility, ill keep this SK abstract
			<li>
				<compClass>SK.CompFadingShadowThrower</compClass>
			</li>
-->
  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[@Name="FurnitureBase"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.StandardBuildingDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="FurnitureBase"]</xpath>
