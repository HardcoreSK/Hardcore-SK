<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="ArtBuildingBase"]</xpath>
    <value>
		<fillPercent>0.9</fillPercent>
		<pathCost>70</pathCost>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Styleable"/>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes>
					<li>Artistic</li>
				</focusTypes>
				<offsets>
					<li Class="FocusStrengthOffset_Quality">
						<curve>
							<points>
								<li>(0,0.12)</li><!-- awful -->
								<li>(1,0.16)</li><!-- poor -->
								<li>(2,0.20)</li><!-- normal -->
								<li>(3,0.22)</li><!-- good -->
								<li>(4,0.24)</li><!-- excellent -->
								<li>(5,0.26)</li><!-- masterwork -->
								<li>(6,0.28)</li><!-- legendary -->
							</points>
						</curve>
					</li>
					<li Class="FocusStrengthOffset_BuildingDefsWithQuality">
						<defs>
							<li>SculptureSmall</li>
							<li>SculptureLarge</li>
							<li>SculptureGrand</li>
							<li>MuffaloArt</li>
							<li>QueenArt</li>
							<li>NymphArt</li>
							<li>GreenyArt</li>
							<li>WolfArt</li>
							<li>DragonArt</li>
							<li>ZeonArt</li>							
							<li>DecorativeUrnSmall</li>
							<li>SmallPottery</li>
						</defs>
						<radius>9.9</radius>
						<maxBuildings>8</maxBuildings>
						<focusPerQuality>
							<points>
								<li>(0,0.0)</li><!-- awful -->
								<li>(1,0.0)</li><!-- poor -->
								<li>(2,0.01)</li><!-- normal -->
								<li>(3,0.01)</li><!-- good -->
								<li>(4,0.01)</li><!-- excellent -->
								<li>(5,0.02)</li><!-- masterwork -->
								<li>(6,0.02)</li><!-- legendary -->
							</points>
						</focusPerQuality>
						<explanationKey>MeditationFocusPerSculpture</explanationKey>
						<explanationKeyAbstract>MeditationFocusPerSculptureAbstract</explanationKeyAbstract>
					</li>
				</offsets>
			</li>
		</comps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="SculptureBase"]</xpath>
    <value>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Artistic</workSkill>
			<unfinishedThingDef>UnfinishedSculpture</unfinishedThingDef>
			<effectWorking>Sculpt</effectWorking>
			<soundWorking>Recipe_Sculpt</soundWorking>
			<recipeUsers>
				<li>TableSculpting</li>
			</recipeUsers>
			<defaultIngredientFilter>
				<categories>
					<li>Root</li>
				</categories>
				<disallowedThingDefs>
					<li>Uranium</li>
					<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</recipeMaker>
		<building>
			<uninstallWork>600</uninstallWork>
			<paintable>true</paintable>
		</building>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SculptureSmall"]</xpath>
    <value>
      <statBases>
        <MaxHitPoints>90</MaxHitPoints>
        <Beauty>20</Beauty>
        <WorkToMake>10000</WorkToMake>
        <Bulk>50</Bulk>
        <Mass>30</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
        <li>Precious</li>
        <li>Woody</li>
        <li>Stony</li>
        <li>Bricks</li>
        <li>Ceramic</li>
      </stuffCategories>
      <costStuffCount>60</costStuffCount>
      <recipeMaker>
        <researchPrerequisite>Art_B1</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SculptureLarge"]</xpath>
    <value>
      <statBases>
        <MaxHitPoints>150</MaxHitPoints>
        <Beauty>32</Beauty>
        <WorkToMake>15000</WorkToMake>
        <Bulk>140</Bulk>
        <Mass>90</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">20</StyleDominance>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
        <li>Precious</li>
        <li>Woody</li>
        <li>Stony</li>
        <li>Bricks</li>
        <li>Ceramic</li>
      </stuffCategories>
      <costStuffCount>110</costStuffCount>
      <recipeMaker>
        <researchPrerequisite>Art_B2</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SculptureGrand"]</xpath>
    <value>
      <description>A car-sized piece of material sculpted into an artistic form.</description>
      <statBases>
        <MaxHitPoints>220</MaxHitPoints>
        <Beauty>60</Beauty>
        <WorkToMake>25000</WorkToMake>
        <Bulk>260</Bulk>
        <Mass>220</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">40</StyleDominance>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
        <li>Precious</li>
        <li>Woody</li>
        <li>Stony</li>
        <li>Bricks</li>
        <li>Ceramic</li>
      </stuffCategories>
      <costStuffCount>200</costStuffCount>
      <recipeMaker>
        <researchPrerequisite>Art_B2</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Snowman"]</xpath>
    <value>
      <pathCost>25</pathCost>
      <statBases>
        <MaxHitPoints>50</MaxHitPoints>
        <Beauty>4</Beauty>
        <WorkToBuild>600</WorkToBuild>
        <MarketValue>0</MarketValue>
      </statBases>
    </value>
  </Operation>

</Patch>
