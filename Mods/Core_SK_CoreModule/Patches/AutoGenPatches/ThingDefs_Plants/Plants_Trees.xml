<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="TreeBase"]</xpath>
    <value>
		<description>A tree.</description>
		<hideAtSnowOrSandDepth>99999</hideAtSnowOrSandDepth>
		<pathCost>130</pathCost>
		<plant Merge="true">
			<fertilityMin>0.3</fertilityMin>
			<sowWork>750</sowWork>
			<harvestYield>50</harvestYield>
		</plant>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Plant_TreePalm"]</xpath>
    <value>
      <description>A tropical tree with a tall, naked trunk topped by a cluster of very broad leaves. Produces hard, fibrous fruits called coconuts. The palm tree will remain after harvesting and will start another cycle of coconut production.</description>
      <graphicData>
        <texPath>Things/Plant/PlantCoconutPalmTree</texPath>
        <graphicClass>Graphic_Random</graphicClass>
        <shadowData>
          <volume>(0.1, 0.3, 0.1)</volume>
          <offset>(0,0,0)</offset>
        </shadowData>
      </graphicData>
      <statBases Merge="true">
        <Beauty>7</Beauty>
        <BeautyOutdoors>7</BeautyOutdoors>
        <Nutrition>1.2</Nutrition>
      </statBases>
      <plant Merge="true">
        <sowMinSkill>9</sowMinSkill>
        <sowResearchPrerequisites>
          <li>Fruit_Plants_B1</li>
        </sowResearchPrerequisites>
        <visualSizeRange>1.2~3.4</visualSizeRange>
        <growDays>12</growDays>
        <fertilitySensitivity>0.25</fertilitySensitivity>
        <harvestWork>550</harvestWork>
        <harvestYield>22</harvestYield>
        <harvestedThingDef>RawCoconut</harvestedThingDef>
        <fertilityMin>0.03</fertilityMin>
      </plant>
    </value>
  </Operation>

