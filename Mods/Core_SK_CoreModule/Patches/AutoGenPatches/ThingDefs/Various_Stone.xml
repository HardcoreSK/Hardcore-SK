<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="ChunkBase"]</xpath>
    <value>
		<fillPercent>0.4</fillPercent>
		<statBases Merge="true">
			<MaxHitPoints>200</MaxHitPoints>
			<Beauty>-10</Beauty>
		</statBases>
		<pathCost>55</pathCost>
		<damageMultipliers>
			<li>
				<damageDef>Bomb</damageDef>
				<multiplier>1.4</multiplier>
			</li>
			<li>
				<damageDef>Thermobaric</damageDef>
				<multiplier>3</multiplier>
			</li>
			<li>
				<damageDef>Bullet</damageDef>
				<multiplier>0.3</multiplier>
			</li>
			<li>
				<damageDef>Arrow</damageDef>
				<multiplier>0.05</multiplier>
			</li>
			<li>
				<damageDef>Beanbag</damageDef>
				<multiplier>0.1</multiplier>
			</li>
			<li>
				<damageDef>LaserBurn</damageDef>
				<multiplier>1.0</multiplier>
			</li>
			<li>
				<damageDef>Optic</damageDef>
				<multiplier>0.7</multiplier>
			</li>
			<li>
				<damageDef>Plasma</damageDef>
				<multiplier>1.4</multiplier>
			</li>
			<li>
				<damageDef>Microwave</damageDef>
				<multiplier>1.2</multiplier>
			</li>
			<li>
				<damageDef>Blunt</damageDef>
				<multiplier>0.5</multiplier>
			</li>
			<li>
				<damageDef>Cut</damageDef>
				<multiplier>0.4</multiplier>
			</li>
			<li>
				<damageDef>Electrical</damageDef>
				<multiplier>1.0</multiplier>
			</li>
		</damageMultipliers>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="ChunkRockBase"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Item/Chunk/Stone</texPath> <!-- Have modded stones use our texture -->
        <graphicClass>Graphic_Random</graphicClass>
      </graphicData>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="StoneBlocksBase"]</xpath>
    <value>
		<graphicData>
			<texPath>Things/Item/Resource/Blocks</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
		</graphicData>
		<statBases Merge="true">
			<MarketValue>1.9</MarketValue>
			<Beauty>-6</Beauty>
			<StuffPower_Armor_Sharp>0.7</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.35</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>0.54</StuffPower_Armor_Heat>
		</statBases>
		<stuffProps Merge="true">
			<statOffsets>
				<WorkToMake>120</WorkToMake>
				<WorkToBuild>120</WorkToBuild>
			</statOffsets>
			<statFactors>
				<Beauty>1.2</Beauty>
				<MaxHitPoints>2.4</MaxHitPoints>
				<WorkToMake>4.0</WorkToMake>
				<WorkToBuild>4.5</WorkToBuild>
				<MeleeWeapon_CooldownMultiplier>1.35</MeleeWeapon_CooldownMultiplier>
				<MeleePenetrationFactor>0.6</MeleePenetrationFactor>
				<Mass>1.2</Mass>
			</statFactors>
		</stuffProps>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="ChunkSlagSteel"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.SK_MetalChunkBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkSlagSteel"]</xpath>
    <value>
      <label>Slag Chunk</label>
	  <graphicData>
		  <texPath>Things/Item/Chunk/Slag</texPath>
		  <graphicClass>Graphic_Random</graphicClass>
	  </graphicData>
      <smeltProducts>
        <Steel>10</Steel>
        <AluminiumBar>5</AluminiumBar>
        <CopperBar>3</CopperBar>
      </smeltProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Sandstone"]</xpath>
    <value>
      <label>Sandstone Deposit</label>
      <statBases>
        <MaxHitPoints>1100</MaxHitPoints>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkSandstone"]</xpath>
    <value>
      <label>Sandstone Chunk</label>
      <description>Sandstone is a sedimentary rock that is composed of sand particles that have been compressed together. This is a large chunk of rock that can be cut into blocks.</description>
      <statBases>
        <Mass>10</Mass>
      </statBases>
      <butcherProducts>
        <BlocksSandstone>20</BlocksSandstone>
        <CrushedStone>5</CrushedStone>
        <SandResource>20</SandResource>
      </butcherProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="BlocksSandstone"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>1.9</MarketValue>
      </statBases>
      <stuffProps Merge="true">
        <statFactors>
          <MarketValue>0.4</MarketValue>
          <Mass>1.05</Mass>
        </statFactors>
      </stuffProps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_StoneBlocksSandstone"]</xpath>
    <value>
      <label>Make Sandstone Blocks</label>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Granite"]</xpath>
    <value>
      <label>Granite Deposit</label>
      <description>Granite is a very hard igneous rock.</description>
      <statBases>
        <MaxHitPoints>1700</MaxHitPoints>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SmoothedGranite"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>9</MarketValue>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkGranite"]</xpath>
    <value>
      <label>Granite Chunk</label>
      <description>Granite is a very hard igneous rock. This is a large chunk of rock that can be cut into blocks.</description>
      <statBases>
        <Mass>15</Mass>
      </statBases>
      <butcherProducts>
        <BlocksGranite>20</BlocksGranite>
        <CrushedStone>5</CrushedStone>
        <SandResource>20</SandResource>
      </butcherProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="BlocksGranite"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>2.1</MarketValue>
      </statBases>
      <stuffProps Merge="true">
        <statFactors>
          <MarketValue>0.5</MarketValue>
          <Mass>1.45</Mass>
        </statFactors>
      </stuffProps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_StoneBlocksGranite"]</xpath>
    <value>
      <label>Make Granite Blocks</label>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Limestone"]</xpath>
    <value>
      <label>Limestone Deposit</label>
      <description>Limestone is a sedimentary rock formed from the compacted remains of ancient seashells.</description>
      <statBases>
        <MaxHitPoints>1300</MaxHitPoints>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkLimestone"]</xpath>
    <value>
      <label>Limestone Chunk</label>
      <description>Limestone is a sedimentary rock formed from the compacted remains of ancient seashells. This is a large chunk of rock that can be cut into blocks.</description>
      <statBases>
        <Mass>12</Mass>
      </statBases>
      <butcherProducts>
        <BlocksLimestone>20</BlocksLimestone>
        <CrushedStone>5</CrushedStone>
        <SandResource>20</SandResource>
      </butcherProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="BlocksLimestone"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>1.9</MarketValue>
      </statBases>
      <stuffProps Merge="true">
        <statFactors Merge="true">
          <MarketValue>0.4</MarketValue>
          <Mass>1.2</Mass>
        </statFactors>
      </stuffProps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_StoneBlocksLimestone"]</xpath>
    <value>
      <label>Make Limestone Blocks</label>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Slate"]</xpath>
    <value>
      <label>Slate Deposit</label>
      <description>Slate is a dark-colored metamorphic rock. Its fine layers are emblematic of slaty cleavage.</description>
      <statBases>
        <MaxHitPoints>1400</MaxHitPoints>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SmoothedSlate"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>8</MarketValue>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkSlate"]</xpath>
    <value>
      <label>Slate Chunk</label>
      <description>Slate is a dark-colored metamorphic rock. Its fine layers are emblematic of slaty cleavage. This is a large chunk of rock that can be cut into blocks.</description>
      <statBases>
        <Mass>8</Mass>
      </statBases>
      <butcherProducts>
        <BlocksSlate>20</BlocksSlate>
        <CrushedStone>5</CrushedStone>
        <SandResource>20</SandResource>
      </butcherProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="BlocksSlate"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>1.9</MarketValue>
      </statBases>
      <stuffProps Merge="true">
        <statFactors>
          <MarketValue>0.38</MarketValue>
          <Mass>1.4</Mass>
        </statFactors>
      </stuffProps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_StoneBlocksSlate"]</xpath>
    <value>
      <label>Make Slate Blocks</label>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Marble"]</xpath>
    <value>
      <label>Marble Deposit</label>
      <description>Marble is a soft metamorphic rock composed of recrystallized carbonate minerals. It is commonly used in sculptures.</description>
      <graphicData>
        <color>(151,156,151)</color>
      </graphicData>
      <statBases Merge="true">
        <MaxHitPoints>1250</MaxHitPoints>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SmoothedMarble"]</xpath>
    <value>
      <statBases Merge="true">
        <MarketValue>12</MarketValue>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ChunkMarble"]</xpath>
    <value>
      <label>Marble Chunk</label>
      <description>Marble is a soft metamorphic rock composed of recrystallized carbonate minerals. It is commonly used in sculptures. This is a large chunk of rock that can be cut into blocks.</description>
      <graphicData>
        <color>(151,156,151)</color>
      </graphicData>
      <statBases>
        <Mass>14</Mass>
      </statBases>
      <butcherProducts>
        <BlocksMarble>20</BlocksMarble>
        <CrushedStone>5</CrushedStone>
        <SandResource>20</SandResource>
      </butcherProducts>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="BlocksMarble"]</xpath>
    <value>
      <graphicData>
        <color>(151,156,151)</color>
      </graphicData>
      <statBases Merge="true">
        <MarketValue>1.9</MarketValue>
      </statBases>
      <stuffProps Merge="true">
        <statFactors>
          <Beauty>1.45</Beauty>
          <MarketValue>0.7</MarketValue>
          <Mass>1.3</Mass>
        </statFactors>
      </stuffProps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_StoneBlocksMarble"]</xpath>
    <value>
      <label>Make Marble Blocks</label>
