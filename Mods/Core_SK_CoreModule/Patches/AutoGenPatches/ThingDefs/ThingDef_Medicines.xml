<?xml version='1.0' encoding='utf-8'?>
<Patch>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MedicineHerbal"]</xpath>
		<value>
			<thingClass>Medicine</thingClass>
			<label>Raw herbal medicine</label>
			<graphicData>
				<texPath>Things/Item/Resource/RawXerigium</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<soundInteract>Standard_Drop</soundInteract>
			<soundDrop>Standard_Drop</soundDrop>
			<statBases Merge="True">
				<MaxHitPoints>60</MaxHitPoints>
				<MarketValue>8</MarketValue>
				<Mass>0.1</Mass>
				<Bulk>0.1</Bulk>
				<DeteriorationRate>15</DeteriorationRate>
				<MedicalPotency>0.30</MedicalPotency>
				<MedicalQualityMax>0.60</MedicalQualityMax>
			</statBases>
			<tickerType>Rare</tickerType>
			<stackLimit>75</stackLimit>
			<thingCategories>
				<li>PlantMatter</li>
			</thingCategories>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>30</daysToRotStart>
					<rotDestroys>true</rotDestroys>
				</li>
			</comps>
			<thingSetMakerTags>
				<li>HSKhumanitarianSuppliesTierOne</li>
			</thingSetMakerTags>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MedicineIndustrial"]</xpath>
		<value>
			<thingClass>Medicine</thingClass>
			<possessionCount>2</possessionCount>
			<soundInteract>Standard_Drop</soundInteract>
			<soundDrop>Standard_Drop</soundDrop>
			<tickerType>Rare</tickerType>
			<statBases Merge="True">
				<MaxHitPoints>60</MaxHitPoints>
				<MarketValue>35</MarketValue>
				<Bulk>0.6</Bulk>
				<DeteriorationRate>10</DeteriorationRate>
				<Flammability>1</Flammability>
			</statBases>
			<stackLimit>25</stackLimit>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>120</daysToRotStart>
					<rotDestroys>true</rotDestroys>
				</li>
			</comps>
			<thingSetMakerTags>
				<li>HSKhumanitarianSuppliesTierFour</li>
			</thingSetMakerTags>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MedicineUltratech"]</xpath>
		<value>
			<label>Advanced Medicine</label>
			<thingClass>Medicine</thingClass>
			<possessionCount>1</possessionCount>
			<soundInteract>Standard_Drop</soundInteract>
			<soundDrop>Standard_Drop</soundDrop>
			<statBases Merge="True">
				<MaxHitPoints>60</MaxHitPoints>
				<MarketValue>130</MarketValue>
				<Mass>0.4</Mass>
				<Bulk>0.5</Bulk>
				<Flammability>1.0</Flammability>
				<MedicalPotency>1.3</MedicalPotency>
			</statBases>
			<stackLimit>25</stackLimit>
			<tradeTags>
				<li>Exotic</li>
				<li>ExoticMisc</li>
			</tradeTags>
			<thingSetMakerTags>
				<li>RewardStandardHighFreq</li>
			</thingSetMakerTags>
		</value>
	</Operation>
</Patch>