<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnsArrivalModeDef[defName="EdgeDropGroups"]</xpath>
    <value>
      <minTechLevel>Spacer</minTechLevel>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnsArrivalModeDef[defName="CenterDrop"]</xpath>
    <value>
      <selectionWeightCurve>
        <points>
          <li>(250, 0)</li>
          <li>(800, 20)</li>
          <li>(2000, 30)</li>
        </points>
      </selectionWeightCurve>
      <pointsFactorCurve>
        <points>
          <li>0, 0.8</li>
          <li>13000, 0.7</li>
          <li>18000, 0.6</li>
        </points>
      </pointsFactorCurve>
      <minTechLevel>Spacer</minTechLevel>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnsArrivalModeDef[defName="RandomDrop"]</xpath>
    <value>
      <selectionWeightCurve>
        <points>
          <li>(300, 0)</li>
          <li>(700, 1.5)</li>
        </points>
      </selectionWeightCurve>
      <pointsFactorCurve>
        <points>
          <li>0, 0.75</li>
          <li>14000, 0.65</li>
          <li>18000, 0.55</li>
        </points>
      </pointsFactorCurve>
      <minTechLevel>Spacer</minTechLevel>
    </value>
  </Operation>

</Patch>
