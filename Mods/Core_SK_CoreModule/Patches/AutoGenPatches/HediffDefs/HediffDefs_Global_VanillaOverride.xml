<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/HediffDef[defName="CatatonicBreakdown"]</xpath>
    <value>
      <comps>
        <li Class="HediffCompProperties_Disappears">
          <disappearsAfterTicks>70000~200000</disappearsAfterTicks>
        </li>
      </comps>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/HediffDef[defName="FoodPoisoning"]</xpath>
    <value Merge="true">
      <comps>
        <li Class="HediffCompProperties_SeverityPerDay">
          <severityPerDay>-1.5</severityPerDay>
        </li>
      </comps>
      <stages>
        <li>
          <label>recovering</label>
          <vomitMtbDays>0.4</vomitMtbDays>
          <painOffset>0.2</painOffset>
          <capMods>
            <li>
              <capacity>Consciousness</capacity>
              <postFactor>0.8</postFactor>
            </li>
            <li>
              <capacity>Moving</capacity>
              <postFactor>0.95</postFactor>
            </li>
            <li>
              <capacity>Manipulation</capacity>
              <postFactor>0.9</postFactor>
            </li>
            <li>
              <capacity>BloodFiltration</capacity>
              <postFactor>0.95</postFactor>
            </li>
            <li>
              <capacity>Eating</capacity>
              <postFactor>0.6</postFactor>
            </li>
          </capMods>
        </li>
        <li>
          <label>major</label>
          <minSeverity>0.2</minSeverity>
          <vomitMtbDays>0.2</vomitMtbDays>
          <painOffset>0.4</painOffset>
          <capMods>
            <li>
              <capacity>Consciousness</capacity>
              <postFactor>0.7</postFactor>
            </li>
            <li>
              <capacity>Moving</capacity>
              <postFactor>0.7</postFactor>
            </li>
            <li>
              <capacity>Manipulation</capacity>
              <postFactor>0.85</postFactor>
            </li>
            <li>
              <capacity>BloodFiltration</capacity>
              <postFactor>0.85</postFactor>
            </li>
            <li>
              <capacity>Talking</capacity>
              <postFactor>0.8</postFactor>
            </li>
            <li>
              <capacity>Eating</capacity>
              <postFactor>0.45</postFactor>
            </li>
          </capMods>
        </li>
        <li>
          <label>initial</label>
          <minSeverity>0.8</minSeverity>
          <vomitMtbDays>0.3</vomitMtbDays>
          <painOffset>0.2</painOffset>
          <capMods>
            <li>
              <capacity>Consciousness</capacity>
              <postFactor>0.75</postFactor>
            </li>
            <li>
              <capacity>Moving</capacity>
              <postFactor>0.85</postFactor>
            </li>
            <li>
              <capacity>Manipulation</capacity>
              <postFactor>0.9</postFactor>
            </li>
            <li>
              <capacity>BloodFiltration</capacity>
              <postFactor>0.95</postFactor>
            </li>
            <li>
              <capacity>Eating</capacity>
              <postFactor>0.55</postFactor>
            </li>
          </capMods>
        </li>
      </stages>
    </value>
  </Operation>

</Patch>
