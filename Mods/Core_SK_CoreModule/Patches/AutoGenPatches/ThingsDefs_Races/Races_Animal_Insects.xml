<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ThingDef[defName="Megascarab"]</xpath>
    <attribute>ParentName</attribute>
    <value>SK.SK_InsectThingBaseDummy</value>
  </Operation>
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Megascarab"]</xpath>
    <value>
      <label>Megascarab</label>
      <description>A large, genetically-engineered beetle. What was once the worker caste of an artifical ecosystem of insectoids designed to fight Mechanoid invasions, it is now usually seen without its deadlier insectoid cousins. Still, its size and hard shell make it dangerous when it attacks. An eusocial creature, it cannot reproduce individually.</description>
      <statBases Merge="true">
        <Mass>15</Mass>
        <MoveSpeed>4.1</MoveSpeed>
        <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
        <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
        <ComfyTemperatureMin>-25</ComfyTemperatureMin>
        <MarketValue>250</MarketValue>
        <ImmunityGainSpeed>2.5</ImmunityGainSpeed>
        <MeleeDodgeChance>0</MeleeDodgeChance>
        <MeleeCritChance>0.02</MeleeCritChance>
        <Wildness>0.82</Wildness>
      </statBases>
      <tools DeepReplace="true">
        <li Class="CombatExtended.ToolCE">
          <capacities>
            <li>Bite</li>
          </capacities>
          <power>4</power>
          <cooldownTime>1.8</cooldownTime>
          <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
          <armorPenetrationSharp>1.8</armorPenetrationSharp>
          <armorPenetrationBlunt>1.6</armorPenetrationBlunt>
        </li>
        <li Class="CombatExtended.ToolCE">
          <label>head</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>2</power>
          <cooldownTime>1.45</cooldownTime>
          <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
          <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
          <chanceFactor>0.2</chanceFactor>
          <armorPenetrationBlunt>1.5</armorPenetrationBlunt>
        </li>
      </tools>
      <comps Merge="true">
          <li Class="SK.CompProperties_ShearableRenameable">
            <compClass>SK.CompShearableRenameable</compClass>
            <growthLabel>Chitin</growthLabel>
            <woolDef>Chitin</woolDef>
            <shearIntervalDays>5</shearIntervalDays>
            <woolAmount>30</woolAmount>
          </li>
          <li Class="CombatExtended.CompProperties_ArmorDurability">
            <Durability>150</Durability>
            <Regenerates>true</Regenerates>
            <RegenInterval>600</RegenInterval>
            <RegenValue>5</RegenValue>
            <MinArmorPct>0.5</MinArmorPct>
          </li>
      </comps>
      <butcherProducts DeepReplace="true">
        <Chitin>5</Chitin>
      </butcherProducts>
      <race Merge="true">
        <baseBodySize>0.35</baseBodySize>
        <baseHungerRate>0.4</baseHungerRate>
        <baseHealthScale>0.75</baseHealthScale>
        <trainableTags DeepReplace="true">
          <li>Basic</li>
          <li>Combat</li>
        </trainableTags>
        <untrainableTags DeepReplace="true">
          <li>Help</li>
          <li>Work</li>
        </untrainableTags>
        <lifeStageAges Inherit="False" DeepReplace="true">
          <li>
            <def>EusocialInsectLarva</def>
            <minAge>0</minAge>
          </li>
          <li>
            <def>EusocialInsectJuvenile</def>
            <minAge>0.03</minAge>
          </li>
          <li>
            <def>EusocialInsectAdultShearable</def>
            <minAge>0.4</minAge>
            <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
            <soundDeath>Pawn_Megascarab_Death</soundDeath>
            <soundCall>Pawn_Megascarab_Call</soundCall>
            <soundAngry>Pawn_Megascarab_Angry</soundAngry>
          </li>
        </lifeStageAges>
      </race>
      <modExtensions Merge="true">
        <li Class="CombatExtended.RacePropertiesExtensionCE">
          <bodyShape>Serpentine</bodyShape>
        </li>
      </modExtensions>
    </value>
  </Operation>
