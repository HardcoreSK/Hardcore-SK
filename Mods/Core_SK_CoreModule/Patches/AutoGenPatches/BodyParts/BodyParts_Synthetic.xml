<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="BionicHeart" or
                            defName="BionicStomach"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.BodyPartBase_SyntheticDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="BionicStomach"]</xpath>
        <value>
            <label>synthetic stomach</label>
            <description>An enhanced stomach augmented with synthetic fibres to decrease rejection rate.</description>
            <graphicData>
                <texPath>Things/Item/BodyPart/Core/SyntheticStomach</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.80</drawSize>
                <color>(1,1,1)</color>
            </graphicData>
            <statBases>
                <Mass>1</Mass>
                <MaxHitPoints>100</MaxHitPoints>
            </statBases>
            <costList>
                <Hyperweave>23</Hyperweave>
                <CarbonAlloy>3</CarbonAlloy>
                <SyntheticFibers>7</SyntheticFibers>
                <Electronics>2</Electronics>
            </costList>
            <recipeMaker>
                <productCount>1</productCount>
                <skillRequirements>
                    <Crafting>14</Crafting>
                </skillRequirements>
                <researchPrerequisite>Prosthesis_making_D4</researchPrerequisite>
            </recipeMaker>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/HediffDef[defName="BionicStomach"]</xpath>
        <value>
            <label>synthetic stomach</label>
            <description>An installed enhanced stomach augmented with synthetic fibres to decrease rejection rate.</description>
            <labelNoun>a synthetic stomach</labelNoun>
            <addedPartProps>
                <solid>true</solid>
                <partEfficiency>1.15</partEfficiency>
                <betterThanNatural>true</betterThanNatural>
            </addedPartProps>
            <stages>
                <li>
                    <makeImmuneTo>
                        <li>GutWorms</li>
                    </makeImmuneTo>
                    <foodPoisoningChanceFactor>0.5</foodPoisoningChanceFactor>
                    <capMods>
                        <li>
                            <capacity>Eating</capacity>
                            <offset>0.09</offset>
                        </li>
                    </capMods>
                </li>
            </stages>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="InstallBionicStomach"]</xpath>
        <value>
            <label>Install synthetic stomach</label>
            <description>Installs a Synthetic Stomach.</description>
            <workerClass>Recipe_InstallArtificialBodyPart</workerClass>
            <jobString>Installing Synthetic Stomach.</jobString>
            <workAmount>3200</workAmount>
            <descriptionHyperlinks>
                <ThingDef>BionicStomach</ThingDef>
            </descriptionHyperlinks>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>Medicine</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
                <li>
                    <filter>
                        <thingDefs>
                            <li>BionicStomach</li>
                        </thingDefs>
                    </filter>
                    <count>1</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>Medicine</li>
                </categories>
                <thingDefs>
                    <li>BionicStomach</li>
                </thingDefs>
            </fixedIngredientFilter>
            <skillRequirements>
                <Medicine>13</Medicine>
            </skillRequirements>
            <researchPrerequisite>Prosthesis_install_D2</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="BionicHeart"]</xpath>
