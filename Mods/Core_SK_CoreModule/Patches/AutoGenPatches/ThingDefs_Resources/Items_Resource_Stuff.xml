<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Core_SK uses ResourceBase instead of WoolBase for these wool resources. -->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="WoolMegasloth" or defName="WoolMuffalo" or defName="WoolAlpaca" or defName="WoolBison" or defName="WoolSheep"]</xpath>
		<attribute>ParentName</attribute>
		<value>ResourceBase</value>
	</Operation>

	<!-- ThingDef: Cloth -->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Cloth"]</xpath>
		<value Merge="true">
			<description>Cloth is woven from the raw organic fibers of a Cotton Bush. These fibers are called Raw Cotton.</description>
			<graphicData DeepReplace="true">
				<texPath>Things/Item/Resource/Cloth</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
			</graphicData>
			<statBases DeepReplace="true">
				<MaxHitPoints>100</MaxHitPoints>
				<MarketValue>1.5</MarketValue>
				<Flammability>1.75</Flammability>
				<DeteriorationRate>0</DeteriorationRate>
				<StuffPower_Armor_Blunt>0.95</StuffPower_Armor_Blunt>
				<StuffPower_Armor_Sharp>0.6</StuffPower_Armor_Sharp>
				<StuffPower_Armor_Heat>0.09</StuffPower_Armor_Heat>
				<StuffPower_Insulation_Cold>10</StuffPower_Insulation_Cold>
				<StuffPower_Insulation_Heat>11</StuffPower_Insulation_Heat>
				<Mass>0.01</Mass>
				<Bulk>0.01</Bulk>
			</statBases>
			<stackLimit>300</stackLimit>
			<techLevel>Medieval</techLevel>
			<stuffProps DeepReplace="true">
				<categories>
					<li>Fabric</li>
				</categories>
				<color>(162,157,152)</color>
				<statFactors>
					<MaxHitPoints>1.5</MaxHitPoints>
					<Beauty>1.1</Beauty>
					<MoveSpeed>1</MoveSpeed>
					<MarketValue>0.8</MarketValue>
					<WorkToMake>0.9</WorkToMake>
					<WorkToBuild>0.9</WorkToBuild>
					<BedRestEffectiveness>1.1</BedRestEffectiveness>
					<ImmunityGainSpeedFactor>0.9</ImmunityGainSpeedFactor>
					<Mass>0.4</Mass>
				</statFactors>
				<commonality>1.4</commonality>
				<allowColorGenerators>true</allowColorGenerators>
				<canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
			</stuffProps>
			<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
			<thingCategories DeepReplace="true">
				<li>BTextiles</li>
			</thingCategories>
			<burnableByRecipe>True</burnableByRecipe>
			<allowedArchonexusCount>100</allowedArchonexusCount>
		</value>
	</Operation>

