<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnKindDef[@Name="BasePlayerPawnKind"]</xpath>
    <value>
		<combatPower>80</combatPower>
		<minGenerationAge>18</minGenerationAge>
		<techHediffsChance>0.03</techHediffsChance>
		<techHediffsMoney>50~800</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
		</techHediffsTags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnKindDef[defName="Colonist"]</xpath>
    <value>
      <defaultFactionType>PlayerColony</defaultFactionType>
      <apparelTags>
        <li>CryptosleepSpacer</li>
        <li>Apparel_Ushanka</li>
      </apparelTags>
      <apparelMoney>1800~2400</apparelMoney>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnKindDef[defName="Tribesperson"]</xpath>
    <value>
      <defaultFactionType>PlayerTribe</defaultFactionType>
      <apparelTags>
        <li>Tribal</li>
      </apparelTags>
      <apparelMoney>200~400</apparelMoney>
      <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
      <techHediffsTags Inherit="false">
        <li>Poor</li>
      </techHediffsTags>
      <techHediffsDisallowTags>
        <li>PainCauser</li>
      </techHediffsDisallowTags>
    </value>
  </Operation>

</Patch>
