<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnKindDef[defName="Tribal_Breacher"]</xpath>
    <value>
      <combatPower>135</combatPower>
      <apparelTags>
        <li>Tribal</li>
      </apparelTags>
      <apparelMoney>360~700</apparelMoney>
      <weaponMoney>500~600</weaponMoney>
      <disallowedTraits>
        <li>Brawler</li>
      </disallowedTraits>
      <modExtensions>
        <li Class="CombatExtended.LoadoutPropertiesExtension">
          <primaryMagazineCount>
            <min>2</min>
            <max>4</max>
          </primaryMagazineCount>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/PawnKindDef[defName="Mech_Termite_Breach"]</xpath>
    <value>
      <combatPower>470</combatPower>
    </value>
  </Operation>

</Patch>
