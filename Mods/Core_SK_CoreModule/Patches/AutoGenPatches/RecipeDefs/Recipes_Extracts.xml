<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="ExtractMetalFromSlag"]</xpath>
        <value>
            <description>Use heat and strong electromagnets to separate useful metal from slag chunks.</description>
            <workAmount>1200</workAmount>
            <specialProducts>
                <li>Smelted</li>
            </specialProducts>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <workSkill>Crafting</workSkill>
            <workSkillLearnFactor>0.8</workSkillLearnFactor>
            <researchPrerequisite>Metals_C1</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="SmeltWeapon"]</xpath>
        <value>
            <label>smelt metal from melee weapon</label>
            <description>Use heat to separate useful metal from weapons.</description>
            <jobString>Smelting metal from weapon.</jobString>
            <workAmount>600</workAmount>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <workSkill>Crafting</workSkill>
            <workSkillLearnFactor>0.8</workSkillLearnFactor>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>WeaponsMelee</li>
                            <li>SurvivalTools</li>
                            <li>SpecialWeapons</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>WeaponsMelee</li>
                    <li>SurvivalTools</li>
                    <li>SpecialWeapons</li>
                </categories>
                <specialFiltersToDisallow>
                    <li>AllowNonSmeltableWeapons</li>
                </specialFiltersToDisallow>
            </fixedIngredientFilter>
            <!--<forceHiddenSpecialFilters>
                <li>AllowNonSmeltableWeapons</li>
                <li>AllowSmeltable</li>
                <li>AllowNonBurnableWeapons</li>
                <li>AllowBurnableWeapons</li>
            </forceHiddenSpecialFilters>-->
            <researchPrerequisite>Craft_B1</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="DestroyWeapon"]</xpath>
        <value Merge="true">
            <description>Use heat to destroy unwanted weapons. Faster than smelting, and works on non-smeltable items, but yields no resources.</description>
            <defaultIngredientFilter>
                <categories>
                    <li>Weapons</li>
                </categories>
                <disallowedThingDefs>
                    <li>Gun_DoomsdayRocket</li>
                    <li>Gun_TripleRocket</li>
                    <li>OrbitalTargeterPowerBeam</li>
                    <li>OrbitalTargeterBombardment</li>
                    <li>TornadoGenerator</li>
                </disallowedThingDefs>
            </defaultIngredientFilter>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="ButcherCorpseFlesh"]</xpath>
        <value Merge="true">
            <label>butcher corpse</label>
            <workSkillLearnFactor>0.8</workSkillLearnFactor>
            <fixedIngredientFilter>
                <categories>
                    <li>Corpses</li>
                </categories>
                <disallowedCategories>
                    <li>CorpsesMechanoid</li>
					<li>Fish</li>
                </disallowedCategories>
                <disallowedThingDefs>
                    <li>Corpse_Abomination</li>
                    <li>Corpse_Mosquito</li>
                    <li>Corpse_Fly</li>
                    <li>Corpse_Flea</li>
                </disallowedThingDefs>
                <specialFiltersToDisallow>
                    <li>AllowRotten</li>
                </specialFiltersToDisallow>
                <disallowDoesntProduceMeat>true</disallowDoesntProduceMeat>
            </fixedIngredientFilter>
            <researchPrerequisite>Food_0</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[@Name="MakeStoneBlocksBase"]</xpath>
        <value>
            <jobString>Cutting stone blocks from chunk.</jobString>
            <workSpeedStat>StonecuttingSpeed</workSpeedStat>
            <effectWorking>CutStone</effectWorking>
            <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
            <targetCountAdjustment>20</targetCountAdjustment>
            <workAmount>1600</workAmount>
            <recipeUsers>
                <li>TableStonecutterNeolithic</li>
                <li>TableStonecutter</li>
                <li>TableMachining</li>
            </recipeUsers>
            <workSkill>Crafting</workSkill>
            <workSkillLearnFactor>0.05</workSkillLearnFactor>
            <researchPrerequisite>Craft_0</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="Make_StoneBlocksAny"]</xpath>
        <value>
            <jobString>Cutting rock chunk into blocks.</jobString>
            <recipeUsers>
                <li>TableMachining</li>
            </recipeUsers>
            <workSkill>Crafting</workSkill>
            <workSkillLearnFactor>0.3</workSkillLearnFactor>
        </value>
    </Operation>

</Patch>
