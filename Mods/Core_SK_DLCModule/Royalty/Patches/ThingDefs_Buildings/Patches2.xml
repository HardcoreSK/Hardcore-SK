			<stuffCategories DeepReplace="true">
				<li>Woody</li>
			</stuffCategories>
			<costStuffCount>150</costStuffCount>
			<costList IsNull="true" DeepReplace="true" />
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName = "Harpsichord"]</xpath>
