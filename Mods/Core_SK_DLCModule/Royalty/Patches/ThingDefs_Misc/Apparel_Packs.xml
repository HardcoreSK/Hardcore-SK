<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- ========== Jumppack and Broadshield Pack ========== -->
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="SK.PatchOperationReplaceExtended">
                <xpath>Defs/ThingDef[defName="Apparel_PackJump"]</xpath>
                <value>
                    <statBases Merge="True">
                        <Bulk>8</Bulk>
                        <WornBulk>3</WornBulk>
                    </statBases>
                    <recipeMaker DeepReplace="True" Inherit="False">
                        <workSpeedStat>SmithingSpeed</workSpeedStat>
                        <workSkill>Crafting</workSkill>
                        <effectWorking>Smith</effectWorking>
                        <soundWorking>Recipe_Machining</soundWorking>
                        <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
                        <researchPrerequisite>JumpPack</researchPrerequisite>
                        <useIngredientsForColor>false</useIngredientsForColor>
                        <skillRequirements>
                            <Crafting>9</Crafting>
                        </skillRequirements>
                        <recipeUsers>
                            <li>TableElectronics</li>
                        </recipeUsers>
                    </recipeMaker>
                </value>
            </li>
            <li Class="SK.PatchOperationReplaceExtended">
                <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]</xpath>
                <value>
                    <statBases Merge="True">
                        <Bulk>8</Bulk>
                        <WornBulk>3</WornBulk>
                        <JumpRange>30</JumpRange>
                    </statBases>
                    <apparel Merge="True">
                        <tags DeepReplace="True">
                            <li>BroadshieldPack</li>
                        </tags>
                    </apparel>
                    <recipeMaker DeepReplace="True" Inherit="False">
                        <workSpeedStat>SmithingSpeed</workSpeedStat>
                        <workSkill>Crafting</workSkill>
                        <effectWorking>Smith</effectWorking>
                        <soundWorking>Recipe_Machining</soundWorking>
                        <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
                        <researchPrerequisite>Fortification_E1</researchPrerequisite>
                        <useIngredientsForColor>false</useIngredientsForColor>
                        <skillRequirements>
                            <Crafting>8</Crafting>
                        </skillRequirements>
                        <recipeUsers>
                            <li>TableElectronics</li>
                        </recipeUsers>
                    </recipeMaker>
                </value>
            </li>
        </operations>
    </Operation>

</Patch>