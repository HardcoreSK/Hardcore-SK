<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[@Name="GeneSetHolderBase" or defName="HumanOvum" or defName="HumanEmbryo"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>GeneticItems</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="PoluxSeed"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>SpecialTreesSeeds</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[
                    defName="ArchiteCapsule" or 
                    defName="MechanoidTransponder"
                ]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>HighTechItems</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[
                    @Name="SubcoreBase" or 
                    @Name="MechResourceBase"
                ]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>CoresAndChips</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DeathrestCapacitySerum"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>Serums</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="HemogenPack"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>MedicalDrugs</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BabyFood"]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>FoodMeals</li>
            </thingCategories>
        </value>
    </Operation>
</Patch>
