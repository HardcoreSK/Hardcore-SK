<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!--Non-Gravship-->

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ResearchProjectDef[defName="Fishing"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.PrimitiveBaseDummy</value>
	</Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ResearchProjectDef[defName="Fish_A1"]</xpath>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ResearchProjectDef[defName="Fishing"]</xpath>
        <value>
            <baseCost>150</baseCost>
            <researchViewX>2.00</researchViewX>
            <researchViewY>50.00</researchViewY>
            <tab>Animal_SK</tab>
            <tags Merge="True">
                <li>NorbalStart</li>
            </tags>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ResearchProjectDef[defName="Fish_C1"]</xpath>
        <value>
            <prerequisites>
                <li>Fishing</li>
                <li>Oil_Industry_C5</li>
            </prerequisites>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="MakeFishingBait" or defName="ProcessSmallFish"]</xpath>
        <value>
            <researchPrerequisite>Fishing</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="HSK_FishingSpotSpawner" or defName="HSK_FishTrap"]</xpath>
        <value>
            <researchPrerequisites Replace="True">
                <li>Fishing</li>
            </researchPrerequisites>
        </value>
    </Operation>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ResearchProjectDef[defName="HeavyBridges"]</xpath>
