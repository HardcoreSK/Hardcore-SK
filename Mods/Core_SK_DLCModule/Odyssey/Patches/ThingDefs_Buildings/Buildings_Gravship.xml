<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <!--Better spaceship stats-->
    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="GravEngine"]/statBases</xpath>
        <value>
            <SubstructureSupport>1000</SubstructureSupport>
            <MarketValue>25000</MarketValue>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GravEngine"]/comps/li[@Class="CompProperties_SubstructureFootprint"]/radius</xpath>
        <value>
            <radius>25.9</radius>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GravshipShieldGenerator"]/comps/li[@Class="CompProperties_ProjectileInterceptor"]/radius</xpath>
        <value>
            <radius>32.9</radius>
        </value>
    </Operation>
    
    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="GravFieldExtender"]/comps/li[@Class="CompProperties_GravshipFacility"]</xpath>
        <value>
            <statOffsets>
              <SubstructureSupport>400</SubstructureSupport>
            </statOffsets>
            <maxSimultaneous>10</maxSimultaneous>
            <maxDistance>25.9</maxDistance>
        </value>
    </Operation>
    
    <!--HSK is power-hungry-->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GravcorePowerCell"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
        <value>
            <basePowerConsumption>-5000</basePowerConsumption>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="GravshipShieldGenerator"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
