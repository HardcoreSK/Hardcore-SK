<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="SentienceCatalyst"]/thingCategories</xpath>
                <value>
                    <thingCategories>
                        <li>Serums</li>
                    </thingCategories>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[
                    defName="MastodonTusk" or
                    defName="AlphaThrumboHorn"
                ]/thingCategories</xpath>
                <value>
                    <thingCategories>
                        <li>ExoticHorns</li>
                    </thingCategories>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="ArcheanSeed"]/thingCategories</xpath>
                <value>
                    <thingCategories>
                        <li>SpecialTreesSeeds</li>
                    </thingCategories>
                </value>
            </li>
        </operations>
    </Operation>
</Patch>
