<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/PawnKindDef[defName="Tiger"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_AnimalKindBaseDummy</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/PawnKindDef[defName="Tiger"]</xpath>
		<value>
			<label>Tiger</label>
			<combatPower>170</combatPower>
			<ecoSystemWeight>0.4</ecoSystemWeight>
			<wildGroupSize>1~3</wildGroupSize>
			<lifeStages>
				<li>
					<label>Tiger kitten</label>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Tiger</texPath>
						<drawSize>1.25</drawSize>
					</bodyGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
						<drawSize>1.25</drawSize>
					</dessicatedBodyGraphicData>
				</li>
				<li>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Tiger</texPath>
						<drawSize>1.8</drawSize>
						<shadowData>
							<volume>(0.4, 0.4, 0.4)</volume>
							<offset>(0,0,-0.2)</offset>
						</shadowData>
					</bodyGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
						<drawSize>1.8</drawSize>
					</dessicatedBodyGraphicData>
				</li>
				<li>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Tiger</texPath>
						<drawSize>2.2</drawSize>
						<shadowData>
							<volume>(0.4, 0.4, 0.4)</volume>
							<offset>(0,0,-0.2)</offset>
						</shadowData>
					</bodyGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Cougar/Dessicated_Cougar</texPath>
						<drawSize>2.2</drawSize>
					</dessicatedBodyGraphicData>
				</li>
			</lifeStages>
		</value>
	</Operation>
</Patch>