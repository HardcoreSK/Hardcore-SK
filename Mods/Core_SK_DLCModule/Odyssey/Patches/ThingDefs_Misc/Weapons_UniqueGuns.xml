<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Gun_Revolver_Unique"]/comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]</xpath>
		<value>
			<ammoSet>AmmoSet_45ACP</ammoSet>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Gun_ChargeLance_Unique"]/comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]</xpath>
		<value>
			<ammoSet>AmmoSet_12x64mmCharged</ammoSet>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_BeamRepeater"]</xpath>
		<value>
			<ammoTypes>
				<Ammo_ChargedLaser>Bullet_Laser_BeamRepeater</Ammo_ChargedLaser>
				<Ammo_ChargedLaser_Electromagnetic>Bullet_Laser_BeamRepeater_Mech</Ammo_ChargedLaser_Electromagnetic>
			</ammoTypes>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Bow_Great_Unique"]/comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]</xpath>
		<value>
			<ammoSet>AmmoSet_Arrow</ammoSet>
		</value>
	</Operation>

	<!-- Add quality-based weapon art without replacing existing names, traits or CE components. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Bow_Great_Unique"][not(comps/li[@Class="CompProperties_Art" or @Class="RimWorld.CompProperties_Art" or compClass="CompArt" or compClass="RimWorld.CompArt"])]</xpath>
		<match Class="SK.PatchOperationReplaceExtended">
			<xpath>Defs/ThingDef[defName="Bow_Great_Unique"][not(comps/li[@Class="CompProperties_Art" or @Class="RimWorld.CompProperties_Art" or compClass="CompArt" or compClass="RimWorld.CompArt"])]</xpath>
			<value Merge="true">
				<comps>
					<li Class="CompProperties_Art">
						<nameMaker>NamerArtWeaponGun</nameMaker>
						<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
						<minQualityForArtistic>Excellent</minQualityForArtistic>
					</li>
				</comps>
			</value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Bow_Great_Unique"][not(inspectorTabs/li="ITab_Art" or inspectorTabs/li="RimWorld.ITab_Art")]</xpath>
		<match Class="SK.PatchOperationReplaceExtended">
			<xpath>Defs/ThingDef[defName="Bow_Great_Unique"][not(inspectorTabs/li="ITab_Art" or inspectorTabs/li="RimWorld.ITab_Art")]</xpath>
			<value Merge="true">
				<inspectorTabs>
					<li>ITab_Art</li>
				</inspectorTabs>
			</value>
		</match>
	</Operation>
</Patch>
