<?xml version="1.0" encoding="UTF-8"?>
<Patch>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_CeremonialCultistMask"]</xpath>
        <value>
            <costList>
                <BioferriteAlloy>10</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_DisruptorFlarePack"]</xpath>
        <value>
            <costList>
                <ComponentIndustrial>1</ComponentIndustrial>
                <BioferriteAlloy>10</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Apparel_PackTurret"]</xpath>
		<value>
            <recipeMaker DeepReplace="True" Inherit="False">
                <workSpeedStat>SmithingSpeed</workSpeedStat>
                <workSkill>Crafting</workSkill>
                <effectWorking>Smith</effectWorking>
                <soundWorking>Recipe_Machining</soundWorking>
                <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
                <researchPrerequisite>TurretPack</researchPrerequisite>
                <skillRequirements>
                    <Crafting>8</Crafting>
                </skillRequirements>
                <recipeUsers>
                    <li>TableElectronics</li>
                </recipeUsers>
            </recipeMaker>
			<stuffCategories>
				<li>StrongMetallic</li>
			</stuffCategories>
			<costStuffCount>150</costStuffCount>
			<costList>
				<Weapon_Parts>5</Weapon_Parts>
				<Electronics>5</Electronics>
				<ComponentIndustrial>4</ComponentIndustrial>
				<Mechanism>3</Mechanism>
			</costList>
		</value>
	</Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_DeadlifePack"]</xpath>
        <value>
            <costList>
                <Shard>1</Shard>
                <BioferriteAlloy>20</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_ShardPsychicShockLance"]</xpath>
        <value>
            <costList>
                <Shard>1</Shard>
                <BioferriteAlloy>60</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_ShardPsychicInsanityLance"]</xpath>
        <value>
            <costList>
                <Shard>1</Shard>
                <BioferriteAlloy>75</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_BiomutationLance"]</xpath>
        <value>
            <costList>
                <Shard>1</Shard>
                <BioferriteAlloy>50</BioferriteAlloy>
                <Meat_Twisted>20</Meat_Twisted>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="NerveSpiker"]</xpath>
        <value>
            <costList>
                <ComponentMedieval>7</ComponentMedieval>
                <BioferriteAlloy>30</BioferriteAlloy>
            </costList>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Apparel_CeremonialCultistMask" or defName="Apparel_CultistMask"]</xpath>
        <value>
            <thingCategories Inherit="False">
                <li>HeaddressCat</li>
            </thingCategories>
        </value>
    </Operation>

</Patch>