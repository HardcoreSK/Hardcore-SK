<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Reliquary patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Reliquary"]/costList</xpath>
		<value>
			<costList>
				<GoldBar>100</GoldBar>
				<ComponentMedieval>30</ComponentMedieval>
			</costList>
		</value>
	</Operation>
	<!-- Styling station patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="StylingStation"]/costList</xpath>
		<value>
			<costList>
				<Glass>20</Glass>
				<ComponentMedieval>8</ComponentMedieval>
			</costList>
		</value>
	</Operation>
	<!-- Lightball patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="LightBall"]/costList</xpath>
		<value>
			<costList>
				<ComponentIndustrial>5</ComponentIndustrial>
				<Glass>8</Glass>
				<ElectronicComponents>1</ElectronicComponents>
			</costList>
		</value>
	</Operation>
	<!-- Loudspeaker patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Loudspeaker"]/costList</xpath>
		<value>
			<stuffCategories>
				<li>Woody</li>
				<li>Metallic</li>
			</stuffCategories>
			<costStuffCount>80</costStuffCount>
			<costList>
				<ComponentIndustrial>2</ComponentIndustrial>
				<ElectronicComponents>1</ElectronicComponents>
			</costList>
		</value>
	</Operation>
	<!-- Drum patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Drum"]/costList</xpath>
		<value>
			<costList>
				<ComponentMedieval>12</ComponentMedieval>
			</costList>
		</value>
	</Operation>
	<!-- Pew and kneel sheet and kneel pillow and bonsai pot patches -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Pew" or defName="KneelSheet" or defName="KneelPillow" or defName="PlantPot_Bonsai"]</xpath>
		<value>
			<costList>
				<ComponentMedieval>4</ComponentMedieval>
			</costList>
		</value>
	</Operation>
	<!-- Slab beds patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SlabBed"]/stuffCategories</xpath>
		<value>
			<stuffCategories Inherit="False">
				<li>Stony</li>
			</stuffCategories>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SlabDoubleBed"]/stuffCategories</xpath>
		<value>
			<stuffCategories Inherit="False">
				<li>Stony</li>
			</stuffCategories>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SlabBed"]/costStuffCount</xpath>
		<value>
			<costStuffCount>60</costStuffCount>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SlabDoubleBed"]/costStuffCount</xpath>
		<value>
			<costStuffCount>120</costStuffCount>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SlabBed" or defName="SlabDoubleBed"]/statBases/ImmunityGainSpeedFactor</xpath>
		<value>
			<ImmunityGainSpeedFactor>1</ImmunityGainSpeedFactor>
		</value>
	</Operation>
	<!-- Autobong patches -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Autobong"]/costList</xpath>
		<value>
			<ElectronicComponents>1</ElectronicComponents>
		</value>
	</Operation>
	<!--Pot Bonsai patches-->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="PlantPot_Bonsai"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Building/Furniture/Pots/circleflowerbed</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<designationCategory>Accessories</designationCategory>
			<costList>
				<Fertilizer>7</Fertilizer>
			</costList>
			<researchPrerequisites>
				<li>Accessory_B1</li>
			</researchPrerequisites>
		</value>
	</Operation>
</Patch>
