<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Darktorch patches -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Darktorch"]</xpath>
		<value>
			<costList Inherit="False">
				<Kindling>10</Kindling>
			</costList>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Darktorch"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
		<value>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>3.1</fuelConsumptionRate>
				<fuelCapacity>10</fuelCapacity>
				<fuelConsumptionPerTickInRain>0.035</fuelConsumptionPerTickInRain>
				<fuelFilter>
					<thingDefs>
						<li>Kindling</li>
					</thingDefs>
				</fuelFilter>
				<initialFuelPercent>0</initialFuelPercent>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Darktorch"]</xpath>
		<value>
			<inspectorTabs IsNull="True" />
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Darktorch"]/uiIconPath</xpath>
		<value>
			<uiIconPath>Things/Building/Misc/Darktorch</uiIconPath>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Darktorch"]/comps/li[@Class="CompProperties_DarklightOverlay"]</xpath>
		<value>
			<li Class="SK.CompProperties_FireOverlayMod">
				<texPath>Things/Special/Darklight</texPath>
				<fireSize>0.5</fireSize>
				<offset>(0.4,0.0,-0.02)</offset>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DarktorchFungus"]/uiIconPath</xpath>
		<value>
			<uiIconPath>Things/Building/Misc/FungusDarktorch/FungusDarkTorch_MenuIcon</uiIconPath>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="DarktorchFungus"]/comps/li[@Class="CompProperties_DarklightOverlay"]</xpath>
		<value>
			<li Class="SK.CompProperties_FireOverlayMod">
				<texPath>Things/Special/Darklight</texPath>
				<fireSize>0.6</fireSize>
				<offset>(0.41,0.0,-0.05)</offset>
			</li>
		</value>
	</Operation>
	<!-- Ideogram patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Ideogram"]/costList</xpath>
		<value>
			<stuffCategories>
				<li>Metallic</li>
			</stuffCategories>
			<costStuffCount>50</costStuffCount>
		</value>
	</Operation>
	<!-- Sleep accelerator patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="SleepAccelerator"]/costList</xpath>
		<value>
			<stuffCategories>
				<li>RuggedMetallic</li>
			</stuffCategories>
			<costStuffCount>50</costStuffCount>
			<costList>
				<ComponentIndustrial>5</ComponentIndustrial>
				<ElectronicComponents>2</ElectronicComponents>
			</costList>
		</value>
	</Operation>
	<!-- Biosculpter pod patches -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BiosculpterPod"]/costList</xpath>
		<value>
