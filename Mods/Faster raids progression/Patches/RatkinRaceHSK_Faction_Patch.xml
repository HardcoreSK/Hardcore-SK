<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>NewRatkinPlus</li>
		</mods>
		<match Class="PatchOperationSequence">
			<success>Normal</success>
			<operations>
				<li Class="SK.PatchOperationReplaceExtended">
					<xpath>Defs/FactionDef[@Name="RatkinFactionBase"]</xpath>
					<value Merge="true">
						<earliestRaidDays>96</earliestRaidDays>
						<raidCommonalityFromPointsCurve DeepReplace="true">
							<points>
								<li>(750, 0.1)</li>
								<li>(1500, 0.2)</li>
								<li>(2500, 0.3)</li>
								<li>(3200, 0.5)</li>
								<li>(4300, 0.7)</li>
								<li>(5400, 0.6)</li>
								<li>(6800, 0.5)</li>
								<li>(12500, 0.4)</li>
							</points>
						</raidCommonalityFromPointsCurve>
						<maxPawnCostPerTotalPointsCurve DeepReplace="true">
							<points>
								<li>(0, 160)</li>
								<li>(4300, 215)</li>
								<li>(5400, 265)</li>
								<li>(6800, 290)</li>
								<li>(8900, 325)</li>
								<li>(10000, 350)</li>
								<li>(11750, 400)</li>
								<li>(100000, 10000)</li>
							</points>
						</maxPawnCostPerTotalPointsCurve>
					</value>
				</li>
				<!--
				Retired for the current Ratkin layout: RatkinFactionBase now has five combat groups,
				and the old eighth group has no direct semantic equivalent.
				<li Class="PatchOperationReplace">
					<xpath>Defs/FactionDef[@Name="RatkinFactionBase"]/pawnGroupMakers/li[8]/commonality</xpath>
					<value>
						<commonality>75</commonality>
					</value>
				</li>
				-->
				<li Class="SK.PatchOperationReplaceExtended">
					<xpath>Defs/IncidentDef[defName="RatkinTunnel_Guerrilla"]</xpath>
					<value Merge="true">
						<earliestDay>245</earliestDay>
						<minThreatPoints>9000</minThreatPoints>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>