<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ScenarioDef[defName="RevengeAsari"]/scenario/parts/li[@Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs"]</xpath>
		<value>
			<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
				<def>ConfigurePawnsXenotypes</def>
				<pawnChoiceCount>8</pawnChoiceCount>
				<customSummary>Colonize the planet with the asari to rise again, restore the good name of a great race and strike back at the approaching threat.</customSummary>
				<xenotypeCounts>
					<li>
						<xenotype>Baseline_Asari</xenotype>
						<count>3</count>
						<requiredAtStart>true</requiredAtStart>
						<allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
					</li>
				</xenotypeCounts>
			</li>
			
		</value>
	</Operation>

</Patch>	