<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[
            defName="AIPersonaCore" or
            defName="TechprofSubpersonaCore"
        ]/thingCategories</xpath>
        <value>
            <thingCategories>
                <li>HighTechItems</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Chocolate"]/thingCategories</xpath>
        <value>
            <thingCategories Inherit="False">
                <li>SweetMeals</li>
            </thingCategories>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Jade"]/thingCategories</xpath>
        <value>
            <thingCategories Inherit="False">
                <li>PRS</li>
            </thingCategories>
        </value>
    </Operation>
</Patch>
