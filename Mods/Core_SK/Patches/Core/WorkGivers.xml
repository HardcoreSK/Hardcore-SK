<?xml version="1.0" encoding="UTF-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/WorkGiverDef[defName="DoBillsCook" 
                              or defName="DoBillsCremate"
                              or defName="DoBillsButcherFlesh"
                              or defName="DoBillsCookCampfire"
                              or defName="DoBillsBrew"
                              or defName="DoBillsMakeWeapons"
                              or defName="DoBillsFabricationBench"
                              or defName="DoBillsMakeApparel"
                              or defName="DoBillsStonecut"
                              or defName="DoBillsUseCraftingSpot"]</xpath>
    <attribute>ParentName</attribute>
    <value>SK.WorkGiverPrioritizeSustainsDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/WorkGiverDef[defName="DoBillsCook"]</xpath>
    <value>
      <fixedBillGiverDefs Merge="True">
        <li>TableOven</li>
        <li>ElectricOven</li>
        <li>TableGrill</li>
        <li>ElectricStove_Pro</li>
        <li>soylenttable</li>
        <li>Canningstove</li>
        <li>TableCoffee</li>
      </fixedBillGiverDefs>
    </value>
  </Operation>

