<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Misc. Bees'n'Honey</li>
        </mods>
        <match Class="PatchOperationSequence">
        <operations>
            <li Class="SK.PatchOperationReplaceExtended">
                <xpath>Defs/ThingDef[defName="TreeBeeHive"]</xpath>
                <value Merge="true">
                    <thingCategories>
                        <li>Plants</li>
                    </thingCategories>
                    <!-- Plant.Print scales the mesh with growth; RealtimeOnly bypasses that path. -->
                    <drawerType>MapMeshOnly</drawerType>
                    <graphicData>
                        <drawSize>(1,1)</drawSize>
                        <shaderType>CutoutPlant</shaderType>
                    </graphicData>
                    <!-- Explicit child overrides; range matches the resolved HSK oak in Unified.xml.
                         Merge preserves queen-bee harvesting, graphics and all biome weights. -->
                    <plant>
                        <visualSizeRange>1.2~3.0</visualSizeRange>
                        <topWindExposure>0.25</topWindExposure>
                        <harvestTag>Wood</harvestTag>
                    </plant>
                </value>
            </li>
            <!-- RimWorld - Odyssey DLC -->
            <li Class="PatchOperationConditional">
                <xpath>Defs[BiomeDef[defName='Grasslands']]/ThingDef[defName='TreeBeeHive']/plant/wildBiomes[not(Grasslands)]</xpath>
                <match Class="PatchOperationAdd">
                    <xpath>Defs[BiomeDef[defName='Grasslands']]/ThingDef[defName='TreeBeeHive']/plant/wildBiomes[not(Grasslands)]</xpath>
                    <value>
                        <Grasslands>0.006</Grasslands>
                    </value>
                </match>
            </li>

            <!-- Core SK - archipelagos -->
            <li Class="PatchOperationConditional">
                <xpath>Defs[BiomeDef[defName='BorealArchipelago']]/ThingDef[defName='TreeBeeHive']/plant/wildBiomes[not(BorealArchipelago)]</xpath>
