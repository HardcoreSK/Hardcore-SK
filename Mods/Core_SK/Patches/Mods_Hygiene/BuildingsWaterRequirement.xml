<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Dubs Bad Hygiene</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName='HydroponicsBasin' or defName='NewHydroponicsBasin']/tickerType</xpath>
                    <value>
                        <tickerType>Normal</tickerType>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName='HydroponicsBasin']/comps</xpath>
                    <value>
                        <li Class="DubsBadHygiene.CompProperties_Pipe">
                            <mode>Sewage</mode>
                        </li>
                        <li Class="CompProperties_Refuelable">
                            <consumeFuelOnlyWhenPowered>false</consumeFuelOnlyWhenPowered>
                            <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
                            <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
                            <fuelLabel>Water</fuelLabel>
                            <fuelCapacity>4</fuelCapacity>
                            <fuelConsumptionRate>8</fuelConsumptionRate>
                            <fuelMultiplier>0.02</fuelMultiplier>
                            <fuelFilter/>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName='NewHydroponicsBasin']/comps</xpath>
                    <value>
                        <li Class="DubsBadHygiene.CompProperties_Pipe">
                            <mode>Sewage</mode>
                        </li>
                        <li Class="CompProperties_Refuelable">
                            <consumeFuelOnlyWhenPowered>false</consumeFuelOnlyWhenPowered>
                            <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
                            <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
                            <fuelLabel>Water</fuelLabel>
                            <fuelCapacity>2</fuelCapacity>
                            <fuelConsumptionRate>3</fuelConsumptionRate>
                            <fuelMultiplier>0.02</fuelMultiplier>
                            <fuelFilter/>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName='FertilizerPump']/comps</xpath>
                    <value>
                        <li Class="DBH_SK.CompProperties_Pipe_SK">
                            <mode>Sewage</mode>
                        </li>
                        <li Class="CompProperties_Refuelable">
                            <consumeFuelOnlyWhenPowered>true</consumeFuelOnlyWhenPowered>
                            <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
                            <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
                            <fuelLabel>Water</fuelLabel>
                            <fuelCapacity>100.0</fuelCapacity>
                            <fuelConsumptionRate>3000</fuelConsumptionRate>
                            <!-- fuelConsumptionRate / 60,000 = fuel consumed per tick -->
                            <fuelMultiplier>0.002</fuelMultiplier>
                            <!-- fuelConsumptionRate * fuelMultiplier = Total Stored Water required to add to fuel from pipe network -->
                            <!--<factorByDifficulty>false</factorByDifficulty>-->
                            <fuelFilter/>
                        </li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>