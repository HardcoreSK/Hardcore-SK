<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    
    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Deconstruct"]</xpath>
        <order>Append</order> <!--Reverse order in values!-->
        <value>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_AllowAll</li>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_Forbid</li>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_Allow</li>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_SelectSimilar</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Mine"]</xpath>
        <order>Append</order> <!--Reverse order in values!-->
        <value>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_StripMine</li>
            <!--Old broken shit - doesnt actually change sizes-->
            <!--<li>SK.StripMiner</li>-->
            <li>SK.DesognatorMineBrush</li>
            <li>SK.Designator_VeinMiner</li>
            <!--Exists in vanilla but doesnt support minerals mod-->
            <!--<li>Designator_MineVein</li>-->
        </value>
    </Operation>
    
    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_PlantsHarvestWood"]</xpath>
        <order>Append</order> <!--Reverse order in values!-->
        <value>
            <li>Designator_ExtractTree</li>
            <li>SK.Designator_PlantsChopWood</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_PlantsHarvest"]</xpath>
        <order>Append</order> <!--Reverse order in values!-->
        <value>
            <!--Duplicated functions and harder to use-->
            <!--<li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_HarvestFullyGrown</li>-->
            <li>SK.Designator_PlantsHarvestEdibles</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Hunt"]</xpath>
        <value>
            <li MayRequire="UnlimitedHugs.AllowTool">AllowTool.Designator_FinishOff</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationInsert">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Haul"]</xpath>
        <value>
            <li>Designator_Strip</li>
        </value>
    </Operation>
    
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses</xpath>
        <value>
            <li>SK.Designator_HaulPriority</li>
            <li>SK.Designator_HaulPriorityHighPriorityOverride</li>
        </value>
    </Operation>
</Patch>