<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Pila" and @Class="CombatExtended.AmmoDef"]</xpath>
		<value>
			<stackLimit>75</stackLimit>
			<thingCategories Inherit="False">
				<li>ThrownRanged</li>
			</thingCategories>
			<weaponClasses>
				<li>Neolithic</li>
				<li>Ranged</li> <!-- CE -->
			</weaponClasses>
		</value>
	</Operation>
</Patch>