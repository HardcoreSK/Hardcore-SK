<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_AssaultRifle"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>AssaultRifle</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>11</min>
            <max>12</max>
          </volumeRange>
          <pitchRange>
            <min>0.97</min>
            <max>1.03</max>
          </pitchRange>
          <sustainLoop>False</sustainLoop>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="InfernoCannon_Fire"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>InfernoCannon</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>50</min>
            <max>55</max>
          </volumeRange>
          <pitchRange>
            <min>0.97</min>
            <max>1.03</max>
          </pitchRange>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_ChargeRifle"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>ChargeRifle</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>16</min>
            <max>18</max>
          </volumeRange>
          <pitchRange>
            <min>0.97</min>
            <max>1.03</max>
          </pitchRange>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_HeavySMG"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <name>shot</name>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>HeavySMG</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>10</min>
            <max>15</max>
          </volumeRange>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_Shotgun"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>Shotgun</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>15</min>
            <max>18</max>
          </volumeRange>
          <sustainLoop>False</sustainLoop>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_SniperRifle"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>SniperRifle</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>33</min>
            <max>35</max>
          </volumeRange>
          <sustainLoop>False</sustainLoop>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_BoltActionRifle"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>SurvivalRifle</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>30</min>
            <max>32</max>
          </volumeRange>
          <pitchRange>
            <min>0.9770592</min>
            <max>1.114706</max>
          </pitchRange>
          <sustainLoop>False</sustainLoop>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_Minigun"]</xpath>
    <value>
      <eventNames/>
      <maxSimultaneous>1</maxSimultaneous>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Folder">
              <clipFolderPath>LMG</clipFolderPath>
            </li>
          </grains>
          <volumeRange>
            <min>13</min>
            <max>14</max>
          </volumeRange>
          <pitchRange>
            <min>0.99</min>
            <max>1.01</max>
          </pitchRange>
