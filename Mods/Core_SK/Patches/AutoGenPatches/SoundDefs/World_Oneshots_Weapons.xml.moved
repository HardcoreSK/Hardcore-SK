  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Shot_IncendiaryLauncher"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Clip">
              <clipPath>IncendiaryLauncher/IncendiaryLauncher</clipPath>
            </li>
          </grains>
          <volumeRange>
            <min>18</min>
            <max>20</max>
          </volumeRange>
        </li>
      </subSounds>
    </value>
  </Operation>

</Patch>
