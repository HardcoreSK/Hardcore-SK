<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Pawn_Horse_Call"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Clip">
              <clipPath>Horse/horse_snort</clipPath>
            </li>
          </grains>
          <volumeRange>
            <min>8</min>
            <max>8</max>
          </volumeRange>
          <pitchRange>
            <min>0.9082353</min>
            <max>1.114706</max>
          </pitchRange>
          <distRange>
            <min>0</min>
            <max>50</max>
          </distRange>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Pawn_Horse_Angry"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Clip">
              <clipPath>Horse/horse_whinny</clipPath>
            </li>
          </grains>
          <volumeRange>
            <min>20</min>
            <max>20</max>
          </volumeRange>
          <pitchRange>
            <min>0.9311765</min>
            <max>1.091765</max>
          </pitchRange>
          <distRange>
            <min>0</min>
            <max>70</max>
          </distRange>
          <sustainLoop>False</sustainLoop>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Pawn_Horse_Death"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Clip">
              <clipPath>Horse/horse_scream</clipPath>
            </li>
          </grains>
          <volumeRange>
            <min>28.04878</min>
            <max>28.04878</max>
          </volumeRange>
          <pitchRange>
            <min>1.2</min>
            <max>1.2</max>
          </pitchRange>
          <distRange>
            <min>0</min>
            <max>70</max>
          </distRange>
        </li>
      </subSounds>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SoundDef[defName="Pawn_Horse_Wounded"]</xpath>
    <value>
      <eventNames/>
      <subSounds>
        <li>
          <grains>
            <li Class="AudioGrain_Clip">
              <clipPath>Horse/horse_scream</clipPath>
            </li>
          </grains>
          <volumeRange>
            <min>19.5122</min>
            <max>19.5122</max>
          </volumeRange>
          <pitchRange>
            <min>0.8</min>
            <max>1</max>
          </pitchRange>
          <distRange>
            <min>0</min>
            <max>70</max>
          </distRange>
        </li>
      </subSounds>
    </value>
  </Operation>

</Patch>
