<?xml version='1.0' encoding='UTF-8'?>
<Patch>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="SculptureSmall" or defName="SculptureLarge" or defName="SculptureGrand" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_SculptureBaseDummy</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="SculptureSmall"]</xpath>
		<value>
			<statBases>
				<MaxHitPoints>90</MaxHitPoints>
				<Beauty>20</Beauty>
				<WorkToMake>10000</WorkToMake>
				<Bulk>50</Bulk>
				<Mass>30</Mass>
				<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
			</statBases>
			<stuffCategories>
				<li>StrongMetallic</li>
				<li>Precious</li>
				<li>Woody</li>
				<li>Stony</li>
				<li>Bricks</li>
				<li>Ceramic</li>
			</stuffCategories>
			<costStuffCount>60</costStuffCount>
			<recipeMaker>
				<researchPrerequisite>Art_B1</researchPrerequisite>
			</recipeMaker>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="SculptureLarge"]</xpath>
		<value>
			<statBases>
				<MaxHitPoints>150</MaxHitPoints>
				<Beauty>32</Beauty>
