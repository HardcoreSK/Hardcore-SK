				<Bulk>140</Bulk>
				<Mass>90</Mass>
				<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">20</StyleDominance>
			</statBases>
			<stuffCategories>
				<li>StrongMetallic</li>
				<li>Precious</li>
				<li>Woody</li>
				<li>Stony</li>
				<li>Bricks</li>
				<li>Ceramic</li>
			</stuffCategories>
			<costStuffCount>110</costStuffCount>
			<recipeMaker>
				<researchPrerequisite>Art_B2</researchPrerequisite>
			</recipeMaker>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="SculptureGrand"]</xpath>
		<value>
			<description>A car-sized piece of material sculpted into an artistic form.</description>
			<statBases>
				<MaxHitPoints>220</MaxHitPoints>
				<Beauty>60</Beauty>
				<WorkToMake>25000</WorkToMake>
				<Bulk>260</Bulk>
				<Mass>220</Mass>
				<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">40</StyleDominance>
			</statBases>
			<stuffCategories>
				<li>StrongMetallic</li>
				<li>Precious</li>
				<li>Woody</li>
				<li>Stony</li>
				<li>Bricks</li>
				<li>Ceramic</li>
			</stuffCategories>
			<costStuffCount>200</costStuffCount>
			<recipeMaker>
				<researchPrerequisite>Art_B2</researchPrerequisite>
			</recipeMaker>
		</value>
	</Operation>
</Patch>
