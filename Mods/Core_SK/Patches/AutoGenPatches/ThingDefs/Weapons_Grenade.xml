<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeMolotov" or defName="Proj_GrenadeFrag" or defName="Proj_GrenadeEMP"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_BaseGrenadeProjectileDummy</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeFrag"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Projectile/Grenades/Frag</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<explosionRadius>1.5</explosionRadius>
				<damageDef>Bomb</damageDef>
				<damageAmountBase>70</damageAmountBase>
				<explosionDelay>180</explosionDelay>
				<soundExplode>Explosion_Bomb</soundExplode>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<casingFilthDefname>Filth_GrenadeAmmoCasings</casingFilthDefname>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
				<suppressionFactor>3.0</suppressionFactor>
				<dangerFactor>2.0</dangerFactor>
				<airborneSuppressionFactor>0.25</airborneSuppressionFactor>
			</projectile>
			<comps>
				<li Class="CombatExtended.CompProperties_Fragments">
					<fragments>
						<Fragment_GrenadeFrag>90</Fragment_GrenadeFrag>
					</fragments>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeMolotov"]</xpath>
		<value>
			<thingClass>CombatExtended.Projectile_FireTrail</thingClass>
			<graphicData>
				<texPath>Things/Projectile/Grenades/Molotov</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<explosionRadius>1.5</explosionRadius>
				<damageDef>Flame</damageDef>
				<damageAmountBase>15</damageAmountBase>
				<preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
				<preExplosionSpawnChance>1</preExplosionSpawnChance>
				<ai_IsIncendiary>true</ai_IsIncendiary>
				<explosionDelay>30</explosionDelay>
				<dropsCasings>false</dropsCasings>
				<suppressionFactor>2.0</suppressionFactor>
				<dangerFactor>1.5</dangerFactor>
				<airborneSuppressionFactor>0.2</airborneSuppressionFactor>
			</projectile>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeEMP"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
			<graphicData>
				<texPath>Things/Projectile/GrenadeEMP</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<explosionRadius>3</explosionRadius>
				<damageDef>EMP</damageDef>
				<damageAmountBase>110</damageAmountBase>
				<explosionDelay>180</explosionDelay>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<casingFilthDefname>Filth_GrenadeAmmoCasings</casingFilthDefname>
				<suppressionFactor>1.5</suppressionFactor>
				<dangerFactor>1.2</dangerFactor>
				<airborneSuppressionFactor>0.15</airborneSuppressionFactor>
			</projectile>
		</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov" or defName="Weapon_GrenadeFrag" or defName="Weapon_GrenadeEMP"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.BaseGrenadeEquipmentDummy</value>
	</Operation>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov" or defName="Weapon_GrenadeFrag" or defName="Weapon_GrenadeEMP"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeFrag"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Ammo/HandGrenades/Frag</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
			</graphicData>
			<statBases Merge="True">
				<Mass>0.6</Mass>
				<Bulk>1.0</Bulk>
				<MarketValue>40.0</MarketValue>
				<SightsEfficiency>0.6</SightsEfficiency>
				<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			</statBases>
			<equippedStatOffsets>
				<MoveSpeed>-0.01</MoveSpeed>
				<WorkSpeedGlobal>-0.01</WorkSpeedGlobal>
			</equippedStatOffsets>
			<weaponTags Merge="True">
				<li>GrenadeTierThree</li>
				<li>CE_AI_Grenade</li>
				<li>CE_AI_AOE</li>
			</weaponTags>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>throw frag grenade</label>
					<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<range>12</range>
					<minRange>5</minRange>
					<warmupTime>1.35</warmupTime>
					<noiseRadius>4</noiseRadius>
					<ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
					<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
					<soundCast>ThrowGrenade</soundCast>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<defaultProjectile>Proj_GrenadeFrag</defaultProjectile>
					<onlyManualCast>true</onlyManualCast>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
				</li>
			</verbs>
			<detonateProjectile>Proj_GrenadeFrag</detonateProjectile>
			<smeltProducts>
				<Steel>4</Steel>
				<Powder>2</Powder>
				<ComponentIndustrial>1</ComponentIndustrial>
			</smeltProducts>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeMolotov"]</xpath>
		<value>
			<smeltable>True</smeltable>
			<graphicData>
				<texPath>Things/Ammo/HandGrenades/Molotov</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
				<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
			</graphicData>
			<generateAllowChance>0.5</generateAllowChance>
			<generateCommonality>0.7</generateCommonality>
			<statBases Merge="True">
				<Mass>0.5</Mass>
				<Bulk>1.0</Bulk>
				<MarketValue>15</MarketValue>
				<SightsEfficiency>0.35</SightsEfficiency>
				<RangedWeapon_Cooldown>0.65</RangedWeapon_Cooldown>
			</statBases>
			<equippedStatOffsets>
				<MoveSpeed>-0.01</MoveSpeed>
				<WorkSpeedGlobal>-0.01</WorkSpeedGlobal>
			</equippedStatOffsets>
			<weaponTags Merge="True">
				<li>GrenadeTierTwo</li>
				<li>CE_AI_Grenade</li>
				<li>CE_AI_AOE</li>
				<li>GrenadeFlameNeolithic</li>
			</weaponTags>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>throw molotov</label>
					<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<range>11</range>
					<minRange>2</minRange>
					<warmupTime>1.3</warmupTime>
					<noiseRadius>4</noiseRadius>
					<ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
					<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
					<soundCast>ThrowMolotovCocktail</soundCast>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<defaultProjectile>Proj_GrenadeMolotov</defaultProjectile>
					<onlyManualCast>true</onlyManualCast>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
				</li>
			</verbs>
			<detonateProjectile>Proj_GrenadeMolotov</detonateProjectile>
			<smeltProducts>
				<Glass>3</Glass>
				<Cloth>3</Cloth>
				<Napalm>1</Napalm>
			</smeltProducts>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeEMP"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Weapons/Grenades/EMP</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
				<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
			</graphicData>
			<generateAllowChance>0</generateAllowChance>
			<statBases Merge="True">
				<Mass>0.4</Mass>
				<Bulk>1.0</Bulk>
				<MarketValue>60</MarketValue>
				<SightsEfficiency>0.6</SightsEfficiency>
				<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			</statBases>
			<equippedStatOffsets>
				<MoveSpeed>-0.01</MoveSpeed>
				<WorkSpeedGlobal>-0.01</WorkSpeedGlobal>
			</equippedStatOffsets>
			<weaponTags Merge="True">
				<li>CE_AI_Grenade</li>
				<li>CE_AI_AOE</li>
			</weaponTags>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>throw EMP grenade</label>
					<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<range>12</range>
					<minRange>3</minRange>
					<warmupTime>1.4</warmupTime>
					<noiseRadius>4</noiseRadius>
					
					<ai_AvoidFriendlyFireRadius>2</ai_AvoidFriendlyFireRadius>
					<ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
					<soundCast>ThrowGrenade</soundCast>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<defaultProjectile>Proj_GrenadeEMP</defaultProjectile>
					<onlyManualCast>true</onlyManualCast>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
				</li>
			</verbs>
			<detonateProjectile>Proj_GrenadeEMP</detonateProjectile>
			<smeltProducts>
				<Steel>5</Steel>
				<ComponentIndustrial>2</ComponentIndustrial>
				<ElectronicComponents>1</ElectronicComponents>
			</smeltProducts>
		</value>
	</Operation>

</Patch>