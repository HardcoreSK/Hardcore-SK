<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="ResourceBase"]</xpath>
		<value>
			<statBases Merge="True">
				<Beauty>-2</Beauty>
			</statBases>
			<pathCost>15</pathCost>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="LeatherBase"]</xpath>
		<value>
			<statBases Merge="True">
				<DeteriorationRate>0</DeteriorationRate>
				<Mass>0.1</Mass>
				<StuffPower_Armor_Heat>0.1</StuffPower_Armor_Heat>
			</statBases>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="OrganicProductBase"]</xpath>
		<value>
			<ingestible>
				<preferablility>DesperateOnly</preferablility>
				<chairSearchRadius>60</chairSearchRadius>
			</ingestible>
			<statBases Merge="True">
				<Nutrition>0.05</Nutrition>
				<MaxHitPoints>100</MaxHitPoints>
				<DeteriorationRate>10</DeteriorationRate>
				<Mass>0.15</Mass>
				<Bulk>0.15</Bulk>
			</statBases>
		</value>
	</Operation>


</Patch>