<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="MealLavish" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_MealLavishBaseDummy</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="MealFine" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_MealFineBaseDummy</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="MealSurvivalPack" or defName="MealSimple" or defName="MealNutrientPaste" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_MealBaseDummy</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MealSurvivalPack"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Item/Meal128/MRE</texPath>
				<graphicClass>Graphic_MealVariants</graphicClass>
			</graphicData>
			<statBases Merge="True">
				<DeteriorationRate>0.25</DeteriorationRate>
				<MarketValue>30</MarketValue>
				<Bulk>1.50</Bulk>
				<Mass>1.00</Mass>
				<Nutrition>0.9</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<tasteThought>AteFineMeal</tasteThought>
				<optimalityOffsetFeedingAnimals>-5</optimalityOffsetFeedingAnimals>
			</ingestible>
			<thingSetMakerTags>
				<li>HSKhumanitarianSuppliesTierThree</li>
			</thingSetMakerTags>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MealFine"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Item/Meal128/StirFry</texPath>
				<graphicClass>Graphic_MealVariants</graphicClass>
			</graphicData>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MealLavish"]</xpath>
		<value>
			<description>An elborate concoction of food skillfully prepared into a succulent meal.</description>
			<graphicData>
				<texPath>Things/Item/Meal128/SteakDinner</texPath>
				<graphicClass>Graphic_MealVariants</graphicClass>
			</graphicData>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MealSimple"]</xpath>
		<value>
			<label>Fruit Salad</label>
			<description>A fruit salad made from gathered fruit.</description>
			<graphicData>
				<texPath>Things/Item/Meal/Salad/Salad</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<statBases Merge="True">
				<DeteriorationRate>10</DeteriorationRate>
				<MarketValue>12</MarketValue>
				<Bulk>1.50</Bulk>
				<Mass>1.20</Mass>
				<Nutrition>0.6</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<optimalityOffsetFeedingAnimals>0</optimalityOffsetFeedingAnimals>
			</ingestible>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>5</daysToRotStart>
					<rotDestroys>true</rotDestroys>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="MealNutrientPaste"]</xpath>
		<value>
			<graphicData>
				<texPath>Things/Item/Meal/NutrientPaste</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
			</graphicData>
			<statBases Merge="True">
				<DeteriorationRate>10</DeteriorationRate>
				<MarketValue>15</MarketValue>
				<Bulk>1.50</Bulk>
				<Mass>1.20</Mass>
				<Nutrition>1</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<foodType>Meal</foodType>
			</ingestible>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>0.75</daysToRotStart> <!-- short rot time, you want to make them as needed not store them -->
					<rotDestroys>true</rotDestroys>
				</li>
			</comps>
			<modExtensions>
				<li Class="SK.SyntheticMealExtension" />
			</modExtensions>
			<thingSetMakerTags Merge="True">
				<li>HSKhumanitarianSuppliesTierTwo</li>
				<li>HSKhumanitarianSuppliesTierFour</li>
			</thingSetMakerTags>
		</value>
	</Operation>
</Patch>