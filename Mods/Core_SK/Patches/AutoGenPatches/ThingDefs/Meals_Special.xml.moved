<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Milk" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.CropsBaseDummy</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kibble" or defName="InsectJelly" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_OrganicProductBaseDummy</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Chocolate" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SweetMealBaseDummy</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Pemmican" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_MealBaseIngredientlessDummy</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Pemmican"]</xpath>
		<value>
			<statBases Merge="True">
				<MarketValue>3.5</MarketValue>
				<WorkToMake>600</WorkToMake>
				<Mass>0.03</Mass>
				<Bulk>0.06</Bulk>
			</statBases>
			<thingCategories>
				<li>Preserves</li>
			</thingCategories>
			<ingestible Merge="True">
				<preferability>MealAwful</preferability>
				<optimalityOffsetHumanlikes>15</optimalityOffsetHumanlikes>
				<maxNumToIngestAtOnce>12</maxNumToIngestAtOnce>
			</ingestible>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>80</daysToRotStart>
					<rotDestroys>true</rotDestroys>
				</li>
				<li Class="CompProperties_Ingredients">
					<noIngredientsFoodKind>Meat</noIngredientsFoodKind>
				</li>
				<li Class="CompProperties_FoodPoisonable" />
			</comps>
			<stackLimit>150</stackLimit>
			<thingSetMakerTags>
				<li>HSKhumanitarianSuppliesTierOne</li>
			</thingSetMakerTags>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Chocolate"]</xpath>
		<value>
			<allowedArchonexusCount>80</allowedArchonexusCount>
			<possessionCount>10</possessionCount>
			<statBases Merge="True">
				<MaxHitPoints>100</MaxHitPoints>
				<MarketValue>4</MarketValue>
				<Nutrition>0.04</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<maxNumToIngestAtOnce>5</maxNumToIngestAtOnce>
			</ingestible>
			<comps>
				<li Class="CompProperties_Drug">
					<addictiveness>0</addictiveness>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Kibble"]</xpath>
		<value>
			<thingCategories>
				<li>Animalfood</li>
			</thingCategories>
			<statBases Merge="True">
				<MarketValue>1.6</MarketValue>
				<Mass>0.02</Mass>
				<Bulk>0.05</Bulk>
				<DeteriorationRate>2</DeteriorationRate>
				<Nutrition>0.05</Nutrition>
				<FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
			</statBases>
			<ingestible Merge="True">
				<preferability>DesperateOnlyForHumanlikes</preferability>
				<optimalityOffsetFeedingAnimals>15</optimalityOffsetFeedingAnimals>
			</ingestible>
			<comps>
				<li Class="CompProperties_Ingredients">
					<performMergeCompatibilityChecks>false</performMergeCompatibilityChecks>
				</li>
			</comps>
			<stackLimit>150</stackLimit>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Milk"]</xpath>
		<value>
			<description>Milk is a pale liquid produced by the mammary glands of mammals. It can be consumed as a beverage.</description>
			<graphicData>
				<texPath>Things/Item/Resource/Milk</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<soundInteract>Standard_Drop</soundInteract>
			<soundDrop>Standard_Drop</soundDrop>
			<statBases Merge="True">
				<MarketValue>1.9</MarketValue>
				<Flammability>1.0</Flammability>
				<MaxHitPoints>60</MaxHitPoints>
				<Nutrition>0.06</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<maxNumToIngestAtOnce>10</maxNumToIngestAtOnce>
			</ingestible>
			<thingCategories>
				<li>CookingSupplies</li>
			</thingCategories>
			<tickerType>Rare</tickerType>
			<stackLimit>150</stackLimit>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="InsectJelly"]</xpath>
		<value>
			<statBases Merge="True">
				<Nutrition>0.07</Nutrition>
			</statBases>
			<ingestible Merge="True">
				<canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
			</ingestible>
		</value>
	</Operation>
</Patch>