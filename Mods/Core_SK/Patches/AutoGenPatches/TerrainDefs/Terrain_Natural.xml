<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="Soil"]</xpath>
    <value>
      <pathCost>6</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="MossyTerrain"]</xpath>
    <value>
      <pathCost>12</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="MarshyTerrain"]</xpath>
    <value>
      <pathCost>25</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="SoilRich"]</xpath>
    <value>
      <description>Soil that has been enriched with Fertilizer to improve crop growth.</description>
      <pathCost>8</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
      <fertility>1.5</fertility>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="Gravel"]</xpath>
    <value>
      <label>gravel</label>
      <description>Gravel is a composition of small rocks of varying sizes. Rubble can be gathered from it.</description>
      <pathCost>12</pathCost>
      <statBases Merge="true">
        <Beauty>-1</Beauty>
        <Cleanliness>-2</Cleanliness>
      </statBases>
      <fertility>0.5</fertility>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="Sand"]</xpath>
    <value>
      <description>Sand is finely divided rock and mineral particles. Naturally found on beaches and deserts.</description>
      <pathCost>16</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
      <tags>
        <li>Sand</li>
      </tags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="SoftSand"]</xpath>
    <value>
      <description>Sand is finely divided rock and mineral particles. Naturally found on beaches and deserts.</description>
      <texturePath>Terrain/Surfaces/Sand</texturePath>
      <pollutedTexturePath>Terrain/Surfaces/SandPolluted</pollutedTexturePath>
      <pollutionOverlayTexturePath>Terrain/Surfaces/PollutionSand</pollutionOverlayTexturePath>
      <renderPrecedence>350</renderPrecedence>
      <pathCost>20</pathCost>
      <statBases Merge="true">
        <Beauty>-2</Beauty>
      </statBases>
      <scatterType>SoftDry</scatterType>
      <tags>
        <li>Sand</li>
      </tags>
      <takeFootprints>True</takeFootprints>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="Mud"]</xpath>
    <value>
      <pathCost>30</pathCost>
      <affordances Merge="true">
        <li>Light</li>
        <li>Diggable</li>
      </affordances>
    </value>
  </Operation>

</Patch>
