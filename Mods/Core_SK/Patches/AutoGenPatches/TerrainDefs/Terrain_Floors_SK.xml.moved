<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[@Name="FloorBase"]</xpath>
    <value>
		<pathCost>0</pathCost>
		<statBases>
			<WorkToBuild>420</WorkToBuild>
			<CleaningTimeFactor>0.8</CleaningTimeFactor>
		</statBases>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[@Name="TileStoneBase"]</xpath>
    <value>
		<pathCost>0</pathCost>
		<statBases>
			<WorkToBuild>520</WorkToBuild>
			<Beauty>2</Beauty>
			<CleaningTimeFactor>0.9</CleaningTimeFactor>
		</statBases>
		<designatorDropdown IsNull="true" />
		<designationCategory>NaturalFloors</designationCategory>
		<tags>
			<li>Floor</li>
		</tags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="Concrete"]</xpath>
    <value>
      <label>Concrete</label>
      <description>Quick-poured concrete in a flat, grey surface. You'll need to be able to dig out the ground to pour this.</description>
      <renderPrecedence>150</renderPrecedence>
      <pathCost>0</pathCost>
      <statBases Merge="true">
        <WorkToBuild>200</WorkToBuild>
        <Beauty>1</Beauty>
      </statBases>
      <costList>
        <ConcreteResource>3</ConcreteResource>
      </costList>
      <designationCategory>OutsideFloors</designationCategory>
      <researchPrerequisites Inherit="false">
        <li>Concrete_floor_C1</li>
      </researchPrerequisites>
      <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="PavedTile"]</xpath>
    <value>
      <label>Paved Tile</label>
      <description>Large grey tiles with a thick, dark border. Quick to move around on.</description>
      <statBases Merge="true">
        <WorkToBuild>200</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <ConcreteResource>2</ConcreteResource>
        <ComponentIndustrial>1</ComponentIndustrial>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Concrete_floor_C1</li>
      </researchPrerequisites>
      <designationCategory>OutsideFloors</designationCategory>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="TileSandstone"]</xpath>
    <value>
      <label>Sandstone Tile</label>
      <statBases>
        <WorkToBuild>520</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <BlocksSandstone>3</BlocksSandstone>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Stone_floor_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="TileGranite"]</xpath>
    <value>
      <label>Granite Tile</label>
      <statBases>
        <WorkToBuild>520</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <BlocksGranite>3</BlocksGranite>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Stone_floor_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="TileLimestone"]</xpath>
    <value>
      <label>Limestone Tile</label>
      <statBases>
        <WorkToBuild>520</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <BlocksLimestone>3</BlocksLimestone>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Stone_floor_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="TileSlate"]</xpath>
    <value>
      <label>Slate Tile</label>
      <color>(70,70,70)</color>
      <statBases>
        <WorkToBuild>520</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <BlocksSlate>3</BlocksSlate>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Stone_floor_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="TileMarble"]</xpath>
    <value>
      <label>Marble Tile</label>
      <statBases>
        <WorkToBuild>520</WorkToBuild>
        <Beauty>2</Beauty>
      </statBases>
      <costList>
        <BlocksMarble>3</BlocksMarble>
      </costList>
      <researchPrerequisites Inherit="false">
        <li>Stone_floor_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[@Name="FlagstoneBase"]</xpath>
    <value>
		<statBases>
			<WorkToBuild>400</WorkToBuild>
			<Beauty>1</Beauty>
			<CleaningTimeFactor>0.9</CleaningTimeFactor>
		</statBases>
		<designatorDropdown IsNull="true" />
		<tags>
			<li>Road</li>
		</tags>
		<researchPrerequisites Inherit="false">
			<li>Stone_floor_B1</li>
		</researchPrerequisites>
		<designationCategory>NaturalFloors</designationCategory>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="FlagstoneSandstone"]</xpath>
    <value>
      <costList>
        <BlocksSandstone>2</BlocksSandstone>
      </costList>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="FlagstoneGranite"]</xpath>
    <value>
      <costList>
        <BlocksGranite>2</BlocksGranite>
      </costList>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="FlagstoneLimestone"]</xpath>
    <value>
      <costList>
        <BlocksLimestone>2</BlocksLimestone>
      </costList>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="FlagstoneSlate"]</xpath>
    <value>
      <costList>
        <BlocksSlate>2</BlocksSlate>
      </costList>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/TerrainDef[defName="FlagstoneMarble"]</xpath>
    <value>
      <costList>
        <BlocksMarble>2</BlocksMarble>
      </costList>
    </value>
  </Operation>

</Patch>
