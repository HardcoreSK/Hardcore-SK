    <value>
      <label>steam generator</label>
      <thingClass>SK.Building_SteamGenerator</thingClass>
      <graphicData>
        <texPath>Things/Building/Power/SteamGenerator/heatgenerator</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(2,2)</drawSize>
        <shadowData>
          <volume>(1.8, 0.8, 1.8)</volume>
          <offset>(0,0,0)</offset>
        </shadowData>
      </graphicData>
      <statBases>
        <MaxHitPoints>350</MaxHitPoints>
        <WorkToBuild>2100</WorkToBuild>
        <Flammability>1.0</Flammability>
      </statBases>
      <description>The basic Steam Generator that produces electricity. Can be fueled with Charcoal, Kindling and wooden stuff.\nMax. power output: 2,250 W.</description>
      <stuffCategories>
        <li>RuggedMetallic</li>
      </stuffCategories>
      <costStuffCount>110</costStuffCount>
      <costList>
        <ComponentIndustrial>10</ComponentIndustrial>
        <Mechanism>2</Mechanism>
      </costList>
	  <constructEffect IsNull="true"/>
      <comps>
        <li Class="CompProperties_Flickable"/>
        <li Class="CompProperties_Breakdownable"/>
        <li Class="CompProperties_Power">
          <compClass>SK.CompPowerPlantFueled</compClass>
          <basePowerConsumption>-750</basePowerConsumption>
          <transmitsPower>true</transmitsPower>
          <soundAmbientProducingPower>WoodFiredGenerator_Ambience</soundAmbientProducingPower>
        </li>
        <li Class="CompProperties_Glower">
          <glowRadius>3</glowRadius>
          <glowColor>(217,112,33,0)</glowColor>
        </li>
        <li Class="SK.CompProperties_HeatPusherAdvanced">
          <compClass>SK.CompHeatPusherAdvanced</compClass>
          <heatPerSecond>30</heatPerSecond>
          <heatPushMaxTemperature>75</heatPushMaxTemperature>
        </li>
        <li Class="SK.CompFueled_Properties">
          <operatingTemp>500</operatingTemp>
          <drawfirefuel>false</drawfirefuel>
          <canAutoBurn>true</canAutoBurn>
          <smokeDrawOffset>(0,0,0.1)</smokeDrawOffset>
          <smokesize>1.7</smokesize>
          <smokespeeddelay>100</smokespeeddelay>
          <fuelCapacity>40</fuelCapacity>
          <burnFuelMultiplier>0.9</burnFuelMultiplier>
          <smokeDensity>3</smokeDensity>
          <fuelFilter>
            <thingDefs>
              <li>Kindling</li>
            </thingDefs>
            <categories>
              <li>Wooden</li>
              <li>Coal</li>
            </categories>
          </fuelFilter>
        </li>
        <li Class="CompProperties_Stunnable">
          <useLargeEMPEffecter>true</useLargeEMPEffecter>
          <affectedDamageDefs>
            <li>EMP</li>
          </affectedDamageDefs>
        </li>
      </comps>
      <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
      <modExtensions>
        <li Class="SK.Events.AccidentalExplosionExtension">
			</li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Dubs Bad Hygiene</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="WoodFiredGenerator"]/comps</xpath>
          <value>
            <li Class="DubsBadHygiene.CompProperties_Pipe">
              <mode>Sewage</mode>
            </li>
            <li Class="CompProperties_Refuelable">
              <consumeFuelOnlyWhenPowered>false</consumeFuelOnlyWhenPowered>
              <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
              <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
              <fuelLabel>Water</fuelLabel>
			  <fuelGizmoLabel>Water</fuelGizmoLabel>
              <fuelCapacity>100</fuelCapacity>
              <fuelConsumptionRate>300</fuelConsumptionRate>
              <fuelMultiplier>3</fuelMultiplier>
              <fuelFilter />
            </li>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="WoodFiredGenerator"]/description</xpath>
          <value>
			<description>The basic Steam Generator that produces electricity. Can be fueled with Charcoal, Kindling and wooden stuff. Must be provided water via pipes, a well and a pump.\nMax. power output: 2,250 W.</description>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

