<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="ShelfBase"]</xpath>
    <value>
      <statBases Merge="true">
        <Beauty>1.5</Beauty>
      </statBases>
      <stuffCategories>
        <li>Metallic</li>
        <li>Woody</li>
        <li>Plastic</li>
      </stuffCategories>
      <costList>
        <ComponentMedieval>4</ComponentMedieval>
      </costList>
      <researchPrerequisites>
        <li>Storage_B2</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    </value>
  </Operation>
<!-- Add Storage Extension?
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="StorageShelfBase"]</xpath>
    <value>
	 
    </value>
  </Operation>-->

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Shelf"]</xpath>
    <value><!--
	  <thingClass>AdaptiveStorage.ThingClass</thingClass>-->
	  <drawerType>MapMeshAndRealTime</drawerType>
	  <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
      <graphicData>
        <texPath>Things/Building/Storage/Shelf</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2.7,1.8)</drawSize>
      </graphicData>
      <statBases Merge="true">
        <MaxHitPoints>90</MaxHitPoints>
        <WorkToBuild>580</WorkToBuild>
        <Bulk>95</Bulk>
        <Mass>30</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">3</StyleDominance>
      </statBases>
      <costStuffCount>60</costStuffCount>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ShelfSmall"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Building/Storage/Shelf1x1</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>(1.8,1.8)</drawSize>
        <drawRotated>false</drawRotated>
      </graphicData>
      <statBases Merge="true">
        <MaxHitPoints>60</MaxHitPoints>
        <WorkToBuild>380</WorkToBuild>
        <Bulk>55</Bulk>
        <Mass>20</Mass>
        <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">1.5</StyleDominance>
      </statBases>
      <costStuffCount>30</costStuffCount>
      <costList>
        <ComponentMedieval>2</ComponentMedieval>
      </costList>
      <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    </value>
  </Operation>

</Patch>
