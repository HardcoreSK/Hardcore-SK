<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="SleepingSpotBase"]</xpath>
    <value>
      <statBases>
        <WorkToBuild>120</WorkToBuild>
        <Comfort>0.25</Comfort>
        <SurgerySuccessChanceFactor>0.7</SurgerySuccessChanceFactor>
        <MaxHitPoints>0</MaxHitPoints>
        <Flammability>0</Flammability>
        <BedRestEffectiveness>0.75</BedRestEffectiveness>
        <ImmunityGainSpeedFactor>1.0</ImmunityGainSpeedFactor>
        <Bulk>8</Bulk>
        <Mass>3</Mass>
      </statBases>
      <building Merge="true">
        <bed_healPerDay>4</bed_healPerDay>
      </building>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SleepingSpot"]</xpath>
    <value>
      <description>Designates a spot on the ground where people should sleep. Neither comfortable, nor healthy.</description>
      <graphicData>
        <texPath>Things/Building/Furniture/Beds/Spot/SleepSpot</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1,2)</drawSize>
      </graphicData>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="DoubleSleepingSpot"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Building/Furniture/Beds/Spot/DoubleSleepSpot</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2)</drawSize>
      </graphicData>
      <altitudeLayer>FloorEmplacement</altitudeLayer>
      <statBases>
        <WorkToBuild>260</WorkToBuild>
      </statBases>
      <constructionSkillPrerequisite>1</constructionSkillPrerequisite>
    </value>
  </Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="BedBase"]</xpath>
		<value>
		<!-- Even though vanilla has this in BasicBedBase,  
			This abstract has PlaceWorker_ShowFacilitiesConnections,
			meaning errors occur without it here.
		-->
			<comps Merge="true">
				<li Class="CompProperties_AffectedByFacilities">
					<linkableFacilities>
						<li>VitalsMonitor</li>
						<li>AdvancedVitalsMonitor</li>
						<li>Dresser</li>
						<li>EndTable</li>
						<li>EndTableSimple</li>
						<!--<li>ClutterLockerA</li> -->
						<li>JournalTable</li>
						<li>HolographicCell</li>
						<!--<li>Commode</li>-->
						<!--Dont forget to enable CompProperties_Facility in Commode def, if you want enable it again-->
						<!--<li>Storage_Locker</li>-->
						<li>medieval_surg_washpan</li>  
						<li>medieval_surg_instruments</li>
						<li>medieval_surg_lamp</li>
						<li>industrial_surg_instruments</li>
						<li>industrial_surg_lamp</li>
						<li>space_surg_instruments</li>
						<li>space_surg_lamp</li>
						<li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
					</linkableFacilities>
				</li>
			</comps>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="SansComfortBedBase"]</xpath>
		<value>
			<fillPercent>0.3</fillPercent>
			<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
			<!-- Make the default for beds match HSK, so other mod beds inherit -->
			<costList>
				<ComponentIndustrial>4</ComponentIndustrial> <!-- average ingredient cost -->
			</costList>
			<stuffCategories Inherit="false">
				<li>Leathery</li>
				<li>Fabric</li>
				<li>HF</li>
			</stuffCategories>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="BasicBedBase"]</xpath>
		<value>
			<staticSunShadowHeight>0</staticSunShadowHeight>
			<statBases Merge="true">
				<MaxHitPoints>80</MaxHitPoints>
				<Bulk>80</Bulk>
				<Mass>30</Mass>
			</statBases>
		</value>
	</Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="Bedroll"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>BasicBedBase</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Bedroll"]</xpath>
    <value>
      <label>mattress bed</label>
      <description>Sleeping on a platform of logs is as well and good, but a bit of padding goes a long way for a good night's sleep.</description>
      <graphicData>
        <texPath>Things/Building/Furniture/Beds/Norbal/single/norbalbed</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
		<shaderType>CutoutComplex</shaderType>
        <drawSize>(1,2)</drawSize>
        <shadowData>
          <volume>(0.8, 0.15, 1.8)</volume>
        </shadowData>
        <damageData>
          <rect>(0,0.05,1,1.95)</rect>
        </damageData>
      </graphicData>
      <statBases>
		<Flammability>1.0</Flammability>
        <Bulk>90</Bulk>
        <Mass>40</Mass>
		<BedRestEffectiveness>0.87</BedRestEffectiveness>
		<ImmunityGainSpeedFactor>1.0</ImmunityGainSpeedFactor>
		<SurgerySuccessChanceFactor>0.85</SurgerySuccessChanceFactor>
		<Comfort>0.7</Comfort>
		<WorkToBuild>1000</WorkToBuild>
        <Beauty>4</Beauty>
      </statBases>
	  <comps/>
      <stuffCategories Inherit="false">
        <li>Leathery</li>
      </stuffCategories>
      <costList>
        <ComponentMedieval>4</ComponentMedieval>
        <Leather_Patch>30</Leather_Patch>
      </costList>
      <building>
        <bed_showSleeperBody>True</bed_showSleeperBody>
        <bed_healPerDay>7</bed_healPerDay>
        <destroySound>BuildingDestroyed_Soft_Medium</destroySound>
        <destroyShakeAmount>0</destroyShakeAmount>
      </building>
      <researchPrerequisites>
        <li>Beds_A1</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="BedrollDouble"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>BasicBedBase</value>
