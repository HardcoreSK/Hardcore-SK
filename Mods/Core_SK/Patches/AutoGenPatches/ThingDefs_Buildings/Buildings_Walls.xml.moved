<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Wall"]</xpath>
    <value>
      <description>An impassable wall. It is capable of holding up a roof.</description>
      <building Merge="True">
        <relatedBuildCommands>
			<li>Door</li>
			<li>MDoor</li>
			<li>Autodoor</li>
			<li>CellDoor</li>
			<li>OrnateDoor</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly">SecurityDoor</li>
			<li MayRequire="Ludeon.RimWorld.Odyssey">VacBarrier</li>
			<li>Cooler</li>
			<li>Vent</li>
        </relatedBuildCommands>
      </building>
      <statBases Merge="true">
        <MaxHitPoints>380</MaxHitPoints>
        <WorkToBuild>270</WorkToBuild>
        <Flammability>1.0</Flammability>
      </statBases>
      <stuffCategories>
        <li>Stony</li>
        <li>Bricks</li>
        <li>WoodLogs</li>
        <li>Metallic</li>
      </stuffCategories>
      <costStuffCount>6</costStuffCount>
	  <uiIconPathsStuff IsNull="true"/>
    </value>
  </Operation>
<!-- For now going to allow vanilla Stony category
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Fence"]</xpath>
    <value>
      <stuffCategories>
        <li>Metallic</li>
        <li>Woody</li>
      </stuffCategories>
    </value>
  </Operation>
-->
	<Operation Class="PatchOperationAttributeSet">
	<xpath>Defs/ThingDef[defName="Column"]</xpath>
		<attribute>Name</attribute>
		<value>Column</value>
	</Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Column"]</xpath>
    <value>
      <description>A structural column capable of holding up a roof. It does not impede movement or provide cover.</description>
        <graphicData>
        <drawSize>(3,3)</drawSize>
        <texPath>Things/Building/Structures/Columns/Column</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData>
          <volume>(0.3, 0.5, 0.3)</volume>
        </shadowData>
      </graphicData>
	  <uiIconPath>Things/Building/Structures/Columns/Column_Icon</uiIconPath>
	  <statBases Merge="true">
        <MaxHitPoints>250</MaxHitPoints>
        <WorkToBuild>550</WorkToBuild>
        <Flammability>0.2</Flammability>
      </statBases>
      <stuffCategories>
        <li>StrongMetallic</li>
        <li>Stony</li>
        <li>Bricks</li>
      </stuffCategories>
      <costStuffCount>35</costStuffCount>
      <tickerType>Never</tickerType>
      <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
      <blockLight>false</blockLight>
      <researchPrerequisites>
        <li>Construction_B1</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    </value>
  </Operation>

</Patch>
