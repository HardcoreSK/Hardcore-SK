<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="AnimalSleepingSpot"]</xpath>
    <value>
      <useHitPoints>false</useHitPoints>
      <fillPercent>0.11</fillPercent>
      <graphicData>
        <texPath>Things/Building/Furniture/Animal/animallitter</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <statBases>
        <Flammability>0</Flammability>
        <WorkToBuild>300</WorkToBuild>
        <SurgerySuccessChanceFactor>0.7</SurgerySuccessChanceFactor>
        <Bulk>8</Bulk>
        <Mass>2</Mass>
      </statBases>
      <building Merge="true">
        <bed_healPerDay>3</bed_healPerDay>
      </building>
      <constructionSkillPrerequisite>1</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="AnimalSleepingBox"]</xpath>
    <value>
      <label>animal hay sleeping spot</label>
      <description>A small box for animals to sleep in. Fits small animals like chickens, cats, or small dogs. Max animal body size: 0.7</description>
      <graphicData>
        <texPath>Things/Building/Furniture/Animal/strawanimalcouch</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData>
          <volume>(0.8, 0.1, 0.8)</volume>
        </shadowData>
        <damageData>
          <rect>(0.05,0.05,0.9,0.9)</rect>
          <cornerTL>Damage/Corner</cornerTL>
          <cornerTR>Damage/Corner</cornerTR>
          <cornerBL>Damage/Corner</cornerBL>
          <cornerBR>Damage/Corner</cornerBR>
        </damageData>
      </graphicData>
      <size>(1,1)</size>
      <fillPercent>0.25</fillPercent>
      <rotatable>false</rotatable>
      <canOverlapZones>false</canOverlapZones>
      <costList>
        <WoodLog>8</WoodLog>
        <Hay>20</Hay>
      </costList>
	  <stuffCategories IsNull="true"/>
	  <costStuffCount IsNull="true"/>
      <building Merge="true">
        <bed_maxBodySize>0.7</bed_maxBodySize>
        <bed_healPerDay>4</bed_healPerDay>
      </building>
      <statBases Merge="true">
        <WorkToBuild>250</WorkToBuild>
        <Bulk>17</Bulk>
        <Mass>8</Mass>
      </statBases>
      <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="AnimalBed"]</xpath>
    <value>
      <rotatable>false</rotatable>
      <graphicData>
        <texPath>Things/Building/Furniture/Animal/animalbed</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shaderType>CutoutComplex</shaderType>
        <shadowData>
          <volume>(0.8, 0.2, 0.8)</volume>
        </shadowData>
      </graphicData>
      <costStuffCount>50</costStuffCount>
      <costList>
        <ComponentIndustrial>4</ComponentIndustrial>
      </costList>
      <building>
        <bed_healPerDay>5</bed_healPerDay>
        <destroySound>BuildingDestroyed_Soft_Small</destroySound>
      </building>
      <canOverlapZones>false</canOverlapZones>
      <statBases Merge="true">
        <MaxHitPoints>90</MaxHitPoints>
        <WorkToBuild>800</WorkToBuild>
        <BedRestEffectiveness>1</BedRestEffectiveness>
        <Comfort>0.75</Comfort>
        <ImmunityGainSpeedFactor>1.15</ImmunityGainSpeedFactor>
        <SurgerySuccessChanceFactor>1</SurgerySuccessChanceFactor>
        <Bulk>40</Bulk>
        <Mass>15</Mass>
      </statBases>
      <researchPrerequisites>
        <li>Animal_C1</li>
      </researchPrerequisites>
      <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    </value>
  </Operation>

</Patch>
