<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Hive"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Building/Genstep/Hive</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>1.6</drawSize>
      </graphicData>
      <statBases>
        <MaxHitPoints>300</MaxHitPoints>
        <Flammability>1.0</Flammability>
      </statBases>
      <pathCost>70</pathCost>
      <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>
      <building>
        <deconstructible>false</deconstructible>
      </building>
      <damageMultipliers Inherit="false">
        <li>
          <damageDef>Bullet</damageDef>
          <multiplier>4</multiplier>
        </li>
        <li>
          <damageDef>Arrow</damageDef>
          <multiplier>4</multiplier>
        </li>
      </damageMultipliers>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="GlowPod"]</xpath>
    <value>
      <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>
      <building>
        <deconstructible>false</deconstructible>
      </building>
      <statBases>
        <MaxHitPoints>50</MaxHitPoints>
        <Mass>4</Mass>
        <Flammability>1.0</Flammability>
        <MarketValue>50</MarketValue>
      </statBases>
      <graphicData>
        <texPath>Things/Building/Genstep/GlowPod</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData>
          <volume>(0.3, 0.6, 0.3)</volume>
          <offset>(0,0,-0.1)</offset>
        </shadowData>
        <damageData>
          <rect>(0.2,0.2,0.6,0.6)</rect>
        </damageData>
      </graphicData>
    </value>
  </Operation>

</Patch>
