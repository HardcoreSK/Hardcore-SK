	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Ship_Beam" or defName="Ship_CryptosleepCasket" or defName="Ship_ComputerCore" or defName="Ship_Reactor" or defName="Ship_Engine" or defName="Ship_SensorCluster" ]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.ShipBaseDummy</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Ship_Beam"]</xpath>
		<value>
			<blockWind>true</blockWind>
			<statBases Merge="True">
				<WorkToBuild>15000</WorkToBuild>
				<Flammability>1.0</Flammability>
			</statBases>
			<comps>
				<li Class="CompProperties_Power">
					<compClass>CompPowerTransmitter</compClass>
					<transmitsPower>true</transmitsPower>
				</li>
			</comps>
			<stuffCategories>
				<li>SolidMetallic</li>
			</stuffCategories>
			<costStuffCount>150</costStuffCount>
			<costList>
				<BiosyntheticMaterial>15</BiosyntheticMaterial>
				<MagneticMaterial>15</MagneticMaterial>
				<ComponentUltra>15</ComponentUltra>
				<AdvMechanism>5</AdvMechanism>
			</costList>
			<constructionSkillPrerequisite>15</constructionSkillPrerequisite>
		</value>
	</Operation>

