            <workAmount>2200</workAmount>
            <descriptionHyperlinks>
                <ThingDef>BionicJaw</ThingDef>
            </descriptionHyperlinks>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>Medicine</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
                <li>
                    <filter>
                        <thingDefs>
                            <li>BionicJaw</li>
                        </thingDefs>
                    </filter>
                    <count>1</count>
