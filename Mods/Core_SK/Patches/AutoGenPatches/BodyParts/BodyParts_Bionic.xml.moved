<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="BionicEar" or 
                            defName="BionicJaw" or
                            defName="BionicSpine" or
                            defName="BionicEye" or
                            defName="BionicArm" or
                            defName="BionicTongue" or
                            defName="BionicLeg" or
                            defName="PowerClaw"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.BodyPartBase_BionicDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="BionicEar"]</xpath>
        <value>
            <label>bionic ear implant</label>
            <description>An advanced device that expands upon the basic functions of the ear drum.</description>
            <graphicData>
                <texPath>Things/Item/BodyPart/Core/BionicEar</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.80</drawSize>
            </graphicData>
            <statBases>
                <Mass>0.2</Mass>
            </statBases>
            <costList>
                <Biomatter>25</Biomatter>
                <SyntheticFibers>7</SyntheticFibers>
                <Paraffins>13</Paraffins>
                <Microchips>1</Microchips>
            </costList>
            <recipeMaker>
                <productCount>1</productCount>
                <skillRequirements>
                    <Crafting>13</Crafting>
                </skillRequirements>
                <researchPrerequisite>Bionics</researchPrerequisite>
            </recipeMaker>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/HediffDef[defName="BionicEar"]</xpath>
        <value>
            <description>An installed advanced device that expands upon the basic functions of the ear drum.</description>
            <addedPartProps>
                <partEfficiency>1.1</partEfficiency>
            </addedPartProps>
            <stages>
                <li>
                    <capMods>
                        <li>
                            <capacity>Hearing</capacity>
                            <offset>0.1</offset>
                        </li>
                    </capMods>
                </li>
            </stages>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="InstallBionicEar"]</xpath>
        <value>
            <label>Install Bionic Ear Implant</label>
            <description>Installs a Bionic Ear Implant.</description>
            <workerClass>Recipe_InstallArtificialBodyPart</workerClass>
            <jobString>Installing a Bionic Ear Implant.</jobString>
            <workAmount>2200</workAmount>
            <descriptionHyperlinks>
                <ThingDef>BionicEar</ThingDef>
            </descriptionHyperlinks>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>Medicine</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
                <li>
                    <filter>
                        <thingDefs>
                            <li>BionicEar</li>
                        </thingDefs>
                    </filter>
                    <count>1</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>Medicine</li>
                </categories>
                <thingDefs>
                    <li>BionicEar</li>
                </thingDefs>
            </fixedIngredientFilter>
            <workSkill>Medicine</workSkill>
            <skillRequirements>
                <Medicine>12</Medicine>
            </skillRequirements>
            <researchPrerequisite>Prosthesis_install_D3</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="BionicJaw"]</xpath>
        <value>
            <label>bionic jaw implant</label>
            <description>Aside from a strong set of teeth, this also comes with a voice modulator.</description>
            <graphicData>
                <texPath>Things/Item/BodyPart/Core/BionicJaw</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.80</drawSize>
            </graphicData>
            <statBases>
                <Mass>0.5</Mass>
            </statBases>
            <costList>
                <ComponentAdvanced>6</ComponentAdvanced>
                <Biomatter>25</Biomatter>
                <SyntheticFibers>6</SyntheticFibers>
                <ArtificialBone>1</ArtificialBone>
                <Microchips>1</Microchips>
            </costList>
            <recipeMaker>
                <productCount>1</productCount>
                <skillRequirements>
                    <Crafting>13</Crafting>
                </skillRequirements>
                <researchPrerequisite>Bionics</researchPrerequisite>
            </recipeMaker>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/HediffDef[defName="BionicJaw"]</xpath>
        <value>
            <label>bionic jaw implant</label>
            <description>An installed strong set of teeth, this also comes with a voice modulator.</description>
            <labelNoun>a bionic jaw implant</labelNoun>
            <addedPartProps>
                <partEfficiency>1.1</partEfficiency>
            </addedPartProps>
            <stages>
                <li>
                    <capMods>
                        <li>
                            <capacity>Talking</capacity>
