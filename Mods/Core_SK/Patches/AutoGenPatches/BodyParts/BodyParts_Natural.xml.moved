<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[@Name="BodyPartNaturalBase"]</xpath>
        <value>
            <tickerType>Rare</tickerType>
            <comps>
                <li Class="CompProperties_Rottable">
                    <daysToRotStart>1</daysToRotStart>
                    <rotDestroys>true</rotDestroys>
                </li>
            </comps>
        </value>
    </Operation>

    <!--   <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/ThingDef[defName="Heart" or defName="Lung" or defName="Liver" or defName="Kidney"]</xpath> 
    <attribute>ParentName</attribute>
    <value></value>
  </Operation> -->

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Heart"]</xpath>
        <value>
            <tickerType>Rare</tickerType>
            <label>Heart</label>
            <description>Supplies blood and oxygen to all parts of the body. Ready to find a new owner.</description>
            <graphicData>
                <texPath>Things/Item/BodyPart/Core/Heart</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>0.80</drawSize>
            </graphicData>
            <statBases>
                <MarketValue>650</MarketValue>
                <Mass>2</Mass>
            </statBases>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/RecipeDef[defName="InstallNaturalHeart"]</xpath>
        <value>
            <label>Install Heart</label>
            <description>Installs a naturally grown Heart.</description>
            <jobString>Installing Heart.</jobString>
            <workAmount>3800</workAmount>
            <surgerySuccessChanceFactor>0.8</surgerySuccessChanceFactor>
            <deathOnFailedSurgeryChance>0.15</deathOnFailedSurgeryChance>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>Medicine</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
                <li>
                    <filter>
                        <thingDefs>
                            <li>Heart</li>
                        </thingDefs>
                    </filter>
                    <count>1</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>Medicine</li>
                </categories>
                <thingDefs>
                    <li>Heart</li>
                </thingDefs>
            </fixedIngredientFilter>
            <skillRequirements>
                <Medicine>13</Medicine>
            </skillRequirements>
            <researchPrerequisite>Prosthesis_install_C3</researchPrerequisite>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Lung"]</xpath>
        <value>
            <tickerType>Rare</tickerType>
