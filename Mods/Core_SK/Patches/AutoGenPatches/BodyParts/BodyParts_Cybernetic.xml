<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="ArchotechEye"]</xpath>
    <value>
      <label>Cybernetic Bionic Eye</label>
      <description>The advanced version of the bionic eye. The second generation of bionic upgrades, typically reserved for top brass military forces.</description>
      <graphicData>
        <texPath>Things/Item/BodyPart/CyberneticEye</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.80</drawSize>
      </graphicData>
      <statBases>
        <MarketValue>3600</MarketValue>
        <Mass>0.3</Mass>
        <MaxHitPoints>60</MaxHitPoints>
        <NightVisionEfficiency_Implant>0.5</NightVisionEfficiency_Implant>
      </statBases>
      <costList>
        <ComponentUltra>2</ComponentUltra>
        <Biomatter>15</Biomatter>
        <BioMicrochips>1</BioMicrochips>
        <Paraffins>10</Paraffins>
        <ReinforcedGlass>5</ReinforcedGlass>
      </costList>
      <techHediffsTags>
        <li>Cybernetic</li>
      </techHediffsTags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/HediffDef[defName="ArchotechEye"]</xpath>
    <value>
      <label>cybernetic bionic eye</label>
      <description>An installed the advanced version of the bionic eye. It perceives every type of electromagnetic radiation, including radio waves, infrared, light, x-rays, and gamma rays. Its visual acuity is precise enough to read handwriting from twenty meters away. It can emit various wavelengths of radiation like a flashlight, and has an internal subpersona AI which helps highlight useful visual information. Its internal workings are a mystery to human minds.</description>
      <labelNoun>a cybernetic bionic eye</labelNoun>
      <woundAnchorRange>0</woundAnchorRange>
      <displayWound>true</displayWound>
      <addedPartProps>
        <solid>true</solid>
        <partEfficiency>1.25</partEfficiency>
        <betterThanNatural>true</betterThanNatural>
      </addedPartProps>
      <stages>
        <li>
          <statOffsets>
            <NightVisionEfficiency_Implant>0.5</NightVisionEfficiency_Implant>
          </statOffsets>
          <capMods>
            <li>
              <capacity>Sight</capacity>
              <offset>0.21</offset>
            </li>
          </capMods>
        </li>
      </stages>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="InstallArchotechEye"]</xpath>
    <value>
      <label>Install Cybernetic Bionic Eye</label>
      <description>Installs a Cybernetic Bionic Eye.</description>
      <workerClass>Recipe_InstallArtificialBodyPart</workerClass>
      <jobString>Installing Cybernetic Bionic Eye.</jobString>
      <workAmount>2800</workAmount>
      <descriptionHyperlinks>
        <ThingDef>ArchotechEye</ThingDef>
      </descriptionHyperlinks>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <ingredients>
        <li>
          <filter>
            <categories>
              <li>Medicine</li>
            </categories>
          </filter>
          <count>1</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>ArchotechEye</li>
            </thingDefs>
          </filter>
          <count>1</count>
        </li>
      </ingredients>
      <fixedIngredientFilter>
        <categories>
          <li>Medicine</li>
        </categories>
        <thingDefs>
          <li>ArchotechEye</li>
        </thingDefs>
      </fixedIngredientFilter>
      <skillRequirements>
        <Medicine>17</Medicine>
      </skillRequirements>
      <researchPrerequisite>Prosthesis_install_E2</researchPrerequisite>
    </value>
  </Operation>

