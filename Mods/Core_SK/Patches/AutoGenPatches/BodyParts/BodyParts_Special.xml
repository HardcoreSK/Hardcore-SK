<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="DeathAcidifier"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Item/BodyPart/Joywire</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.80</drawSize>
      </graphicData>
      <techHediffsTags>
        <li>Special</li>
      </techHediffsTags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/HediffDef[defName="DeathAcidifier"]</xpath>
    <value>
      <description>An installed death acidifier.</description>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="InstallDeathAcidifier"]</xpath>
    <value>
      <descriptionHyperlinks>
        <ThingDef>DeathAcidifier</ThingDef>
      </descriptionHyperlinks>
      <recipeUsers>
        <li>Human</li>
      </recipeUsers>
    </value>
  </Operation>

</Patch>
