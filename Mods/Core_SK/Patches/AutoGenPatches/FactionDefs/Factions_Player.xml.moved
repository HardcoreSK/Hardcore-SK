<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/FactionDef[defName="PlayerColony"]</xpath>
    <value>
      <apparelStuffFilter>
        <categories>
          <li>Leathers</li>
        </categories>
        <thingDefs>
          <li>Steel</li>
          <li>Synthread</li>
          <li>FerrosiliconAlloy</li>
          <li>CupronickelAlloy</li>
          <li>SteelBar</li>
        </thingDefs>
      </apparelStuffFilter>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/FactionDef[defName="PlayerTribe"]</xpath>
    <value>
      <apparelStuffFilter>
        <categories>
          <li>Leathers</li>
        </categories>
        <thingDefs>
          <li>WoodPlank</li>
          <li>Cloth</li>
          <li>WoolMuffalo</li>
          <li>WoolDromedary</li>
          <li>WoolAlpaca</li>
          <li>HempCloth</li>
          <li>WoolSheep</li>
          <li>CopperBar</li>
          <li>Bronze</li>
        </thingDefs>
      </apparelStuffFilter>
    </value>
  </Operation>

</Patch>
