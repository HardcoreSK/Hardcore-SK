<?xml version='1.0' encoding='UTF-8'?>
<Patch>


	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/PawnKindDef[defName="Muffalo"]</xpath>
		<value>
			<combatPower>110</combatPower>
			<canArriveManhunter>false</canArriveManhunter>
			<ecoSystemWeight>1</ecoSystemWeight>
			<labelMale>alpha muffalo</labelMale>
			<lifeStages>
				<li>
					<label>muffalo calf</label>
					<labelPlural>muffalo calves</labelPlural>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Muffalo</texPath>
						<drawSize>1.5</drawSize>
						<shadowData>
							<volume>(0.4, 0.3, 0.3)</volume>
							<offset>(0,0,-0.2)</offset>
						</shadowData>
					</bodyGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Dessicated_Muffalo</texPath>
						<drawSize>1.5</drawSize>
					</dessicatedBodyGraphicData>
				</li>
				<li>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/AMuffalo</texPath>
						<drawSize>2.25</drawSize>
						<shadowData>
							<volume>(0.6, 0.45, 0.45)</volume>
							<offset>(0,0,-0.25)</offset>
						</shadowData>
					</bodyGraphicData>
					<femaleGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Muffalo</texPath>
						<drawSize>2.25</drawSize>
						<shadowData>
							<volume>(0.6, 0.45, 0.45)</volume>
							<offset>(0,0,-0.25)</offset>
						</shadowData>
					</femaleGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Dessicated_Muffalo</texPath>
						<drawSize>2.25</drawSize>
					</dessicatedBodyGraphicData>
				</li>
				<li>
					<bodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/AMuffalo</texPath>
						<drawSize>3</drawSize>
						<shadowData>
							<volume>(0.8, 0.6, 0.6)</volume>
							<offset>(0,0,-0.3)</offset>
						</shadowData>
					</bodyGraphicData>
					<femaleGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Muffalo</texPath>
						<drawSize>3</drawSize>
						<shadowData>
							<volume>(0.8, 0.6, 0.6)</volume>
							<offset>(0,0,-0.3)</offset>
						</shadowData>
					</femaleGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Muffalo/Dessicated_Muffalo</texPath>
						<drawSize>3</drawSize>
					</dessicatedBodyGraphicData>
				</li>
			</lifeStages>
		</value>
	</Operation>
