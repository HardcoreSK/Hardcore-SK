	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/PawnKindDef[defName="Bear_Grizzly"]</xpath>
		<value>
			<lifeStages>
				<li>
					<bodyGraphicData>
						<graphicClass>SK.PawnGraphic</graphicClass>
						<texPath>Things/Pawn/Animal/Bear/Bear</texPath>
						<drawSize>1.4</drawSize>
						<color>(112,82,65)</color>
						<shadowData>
							<volume>(0.4, 0.3, 0.3)</volume>
							<offset>(0,0,-0.2)</offset>
						</shadowData>
					</bodyGraphicData>
					<dessicatedBodyGraphicData>
						<texPath>Things/Pawn/Animal/Bear/Dessicated_Bear</texPath>
						<drawSize>1.4</drawSize>
