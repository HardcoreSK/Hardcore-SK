<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="Apparel_Tuque"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.ApparelIndustrialSimpleBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_Tuque"]</xpath>
    <value>
      <label>Fancy Bandana</label>
      <description>This bandana is little more than a fancy piece of cloth that is worn on the head. It covers your hair.</description>
      <graphicData>
        <texPath>Things/Apparel/Apparello/Hats/Display/Woolcap</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <stuffCategories>
        <li>Fabric</li>
        <li>HF</li>
      </stuffCategories>
      <costStuffCount>30</costStuffCount>
      <costList>
        <ComponentMedieval>2</ComponentMedieval>
      </costList>
      <statBases>
        <WorkToMake>5500</WorkToMake>
        <MaxHitPoints>40</MaxHitPoints>
        <Flammability>1.7</Flammability>
        <Mass>0.2</Mass>
        <Bulk>3</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>0.7</EquipDelay>
        <Insulation_Heat>5</Insulation_Heat>
        <Insulation_Cold>5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>0.24</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>0</ArmorRating_Sharp>
        <ArmorRating_Blunt>0</ArmorRating_Blunt>
        <ArmorRating_Heat>0</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <MoveSpeed>-0.01</MoveSpeed>
        <SocialImpact>0.07</SocialImpact>
        <GlobalLearningFactor>0.02</GlobalLearningFactor>
        <NegotiationAbility>0.05</NegotiationAbility>
        <TradePriceImprovement>0.06</TradePriceImprovement>
        <TrainAnimalChance>0.05</TrainAnimalChance>
        <TameAnimalChance>0.04</TameAnimalChance>
        <GermResistance>0.04</GermResistance>
        <GermContainment>0.02</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <bodyPartGroups>
          <li>UpperHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Apparello/Hats/Woolcap</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>Outlander</li>
          <li>RenegadesLight</li>
          <li>PredatorsLight</li>
        </tags>
        <defaultOutfitTags>
          <li>Worker</li>
          <li>Soldier</li>
        </defaultOutfitTags>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel><!-- Vanilla has more colour options
      <colorGenerator Class="ColorGenerator_Options">
        <options>
          <li>
            <weight>4</weight>
            <only>(1,1,1,1)</only>
          </li>
        </options>
      </colorGenerator>-->
      <thingCategories>
        <li>MilitaryHeaddressCat</li>
        <li>SetBandit</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>Apparel_C2</researchPrerequisite>
        <displayPriority>105</displayPriority>
      </recipeMaker>
    </value>
  </Operation>

