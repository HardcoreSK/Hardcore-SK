<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/ThingDef[defName="Apparel_Jacket"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.ApparelMedievalBaseDummy</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_Jacket"]</xpath>
    <value>
      <label>Jacket</label>
      <graphicData>
        <texPath>Things/Apparel/Jacket/Leather_Jacket</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <stuffCategories>
        <li>HF</li>
        <li>Fabric</li>
        <li>Leathery</li>
      </stuffCategories>
      <costStuffCount>95</costStuffCount>
      <costList>
        <ComponentMedieval>3</ComponentMedieval>
      </costList>
      <statBases>
        <WorkToMake>7000</WorkToMake>
        <MaxHitPoints>95</MaxHitPoints>
        <Flammability>1.4</Flammability>
        <Mass>0.8</Mass>
        <Bulk>10</Bulk>
        <WornBulk>5</WornBulk>
        <EquipDelay>1.8</EquipDelay>
        <Insulation_Cold>-5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.75</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.75</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>1.3</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>0</ArmorRating_Sharp>
        <ArmorRating_Blunt>0</ArmorRating_Blunt>
        <ArmorRating_Heat>0</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <CarryBulk>10</CarryBulk>
        <MoveSpeed>-0.16</MoveSpeed>
        <WorkSpeedGlobal>-0.05</WorkSpeedGlobal>
        <ShootingAccuracyPawn>-0.04</ShootingAccuracyPawn>
        <AimingDelayFactor>0.06</AimingDelayFactor>
        <MeleeHitChance>-0.05</MeleeHitChance>
        <MeleeWeapon_CooldownMultiplier>0.04</MeleeWeapon_CooldownMultiplier>
        <GermResistance>0.02</GermResistance>
        <GermContainment>0.02</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>2</generateCommonality>
      <apparel>
        <bodyPartGroups>
          <li>Torso</li>
          <li>Neck</li>
          <li>Shoulders</li>
          <li>Arms</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Jacket/Leather_Jacket</wornGraphicPath>
        <layers>
          <li>Shell</li>
        </layers>
        <tags>
          <li>Colonist</li>
          <li>Outlander</li>
          <li>RenegadesLight</li>
          <li>PredatorsLight</li>
          <li>PredatorsScout</li>
          <li>EmpireLight</li>
          <li>EmpireMedium</li>
        </tags>
        <defaultOutfitTags>
          <li>Worker</li>
        </defaultOutfitTags>
      </apparel><!-- Why are we limiting the colour options?
      <colorGenerator Class="ColorGenerator_Options">
        <options>
          <li>
            <weight>6</weight>
            <max>(1,1,1,1)</max>
            <min>(0.70,0.70,0.70,1)</min>
          </li>
        </options>
      </colorGenerator>-->
      <thingCategories>
        <li>UpperOverdressCat</li>
        <li>SetBandit</li>
      </thingCategories>
      <recipeMaker Merge="true">
        <researchPrerequisite>ComplexClothing</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

