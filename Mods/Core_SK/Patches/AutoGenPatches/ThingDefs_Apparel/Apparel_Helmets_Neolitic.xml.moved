<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Apparel_WarMask"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.ApparelNeolithicBaseDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_WarMask"]</xpath>
        <value>
            <label>War Mask</label>
            <description>A partial mask crafted out of a human's skull. There is something very unsettling about it.</description>
            <graphicData>
                <texPath>Things/Apparel/Hats/SkullMask/Skull</texPath>
                <graphicClass>Graphic_Single</graphicClass>
            </graphicData>
            <stuffCategories>
                <li>Leathery</li>
            </stuffCategories>
            <costStuffCount>20</costStuffCount>
            <statBases>
                <WorkToMake>3000</WorkToMake>
                <MaxHitPoints>35</MaxHitPoints>
                <Flammability>1.4</Flammability>
                <Mass>0.2</Mass>
                <Bulk>3</Bulk>
                <WornBulk>0</WornBulk>
                <EquipDelay>0.9</EquipDelay>
                <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
                <StuffEffectMultiplierArmor>0.96</StuffEffectMultiplierArmor>
                <ArmorRating_Sharp>0</ArmorRating_Sharp>
                <ArmorRating_Blunt>0</ArmorRating_Blunt>
                <ArmorRating_Heat>0</ArmorRating_Heat>
            </statBases>
            <equippedStatOffsets Merge="true">
                <MoveSpeed>-0.03</MoveSpeed>
                <WorkSpeedGlobal>-0.02</WorkSpeedGlobal>
                <SocialImpact>-0.4</SocialImpact>
                <MentalBreakThreshold>0.1</MentalBreakThreshold>
                <PsychicSensitivity>-0.11</PsychicSensitivity>
                <ShootingAccuracyPawn>-0.08</ShootingAccuracyPawn>
                <AimingDelayFactor>0.05</AimingDelayFactor>
                <MeleeHitChance>-0.05</MeleeHitChance>
                <TrainAnimalChance>0.1</TrainAnimalChance>
                <TameAnimalChance>0.07</TameAnimalChance>
                <Suppressability>-0.05</Suppressability>
                <GermResistance>0.10</GermResistance>
                <GermContainment>0.15</GermContainment>
            </equippedStatOffsets>
            <generateCommonality>1</generateCommonality>
            <apparel>
                <countsAsClothingForNudity>false</countsAsClothingForNudity>
                <developmentalStageFilter>Child, Adult</developmentalStageFilter>
                <ideoDesireAllowedFactionCategoryTags>
                    <li>Tribal</li>
                </ideoDesireAllowedFactionCategoryTags>
                <bodyPartGroups>
                    <li>FullHead</li>
                </bodyPartGroups>
                <wornGraphicPath>Things/Apparel/Hats/SkullMask/Skull</wornGraphicPath>
                <layers>
                    <li>Overhead</li>
                </layers>
                <tags>
                    <li>Animal</li>
                    <li>Tribal</li>
                    <li>PredatorsLight</li>
                    <li>PredatorsMedium</li>
                    <li>PredatorsScout</li>
                </tags>
                <defaultOutfitTags>
                    <li>Soldier</li>
                </defaultOutfitTags>
                <parentTagDef>ApparelHead</parentTagDef>
            </apparel>
            <colorGenerator Class="ColorGenerator_Options">
                <options>
                    <li>
                        <weight>4</weight>
                        <min>(0.9,0.9,0.9,1)</min>
                        <max>(1,1,1,1)</max>
                    </li>
                </options>
            </colorGenerator>
            <thingCategories>
                <li>AnimalHeaddressCat</li>
                <li>SetBandit</li>
            </thingCategories>
            <recipeMaker>
                <researchPrerequisite>Apparel_A1</researchPrerequisite>
            </recipeMaker>
        </value>
    </Operation>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Apparel_WarVeil"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.ApparelNeolithicBaseDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_WarVeil"]</xpath>
        <value>
            <label>Chitin Head Garment</label>
            <description>A head piece that was lovingly crafted out of shiny chitin. You can almost feel the spirit of this intelligent beast within you.</description>
            <graphicData>
                <texPath>Things/Apparel/Hats/ChitinHat/Scarhat</texPath>
                <graphicClass>Graphic_Single</graphicClass>
            </graphicData>
            <stuffCategories>
                <li>Leathery</li>
            </stuffCategories>
            <costStuffCount>14</costStuffCount>
            <costList>
                <Chitin>10</Chitin>
            </costList>
            <statBases>
                <WorkToMake>2500</WorkToMake>
                <MaxHitPoints>38</MaxHitPoints>
                <Flammability>1.4</Flammability>
                <Mass>1</Mass>
                <Bulk>4</Bulk>
                <WornBulk>0</WornBulk>
                <EquipDelay>1.1</EquipDelay>
                <Insulation_Heat>2.5</Insulation_Heat>
                <Insulation_Cold>2.5</Insulation_Cold>
                <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
                <StuffEffectMultiplierArmor>0.88</StuffEffectMultiplierArmor>
                <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
                <ArmorRating_Blunt>1</ArmorRating_Blunt>
                <ArmorRating_Heat>0.1</ArmorRating_Heat>
            </statBases>
            <equippedStatOffsets>
                <MoveSpeed>-0.05</MoveSpeed>
                <WorkSpeedGlobal>-0.03</WorkSpeedGlobal>
                <SocialImpact>-0.15</SocialImpact>
                <PsychicSensitivity>-0.15</PsychicSensitivity>
                <GlobalLearningFactor>0.02</GlobalLearningFactor>
                <NegotiationAbility>0.04</NegotiationAbility>
                <TradePriceImprovement>0.05</TradePriceImprovement>
                <TrainAnimalChance>0.1</TrainAnimalChance>
                <TameAnimalChance>0.07</TameAnimalChance>
                <GermResistance>0.02</GermResistance>
                <GermContainment>0.01</GermContainment>
                <PainShockThreshold>0.05</PainShockThreshold>
                <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
                <ToxicEnvironmentResistance>0.35</ToxicEnvironmentResistance>
            </equippedStatOffsets>
            <generateCommonality>1</generateCommonality>
            <apparel>
                <countsAsClothingForNudity>false</countsAsClothingForNudity>
                <bodyPartGroups>
                    <li>UpperHead</li>
                    <li>Mouth</li>
                    <li>Neck</li>
                </bodyPartGroups>
                <wornGraphicPath>Things/Apparel/Hats/ChitinHat/Scarhat</wornGraphicPath>
                <layers>
                    <li>Overhead</li>
                </layers>
                <tags>
                    <li>Tribal</li>
                    <li>PredatorsLight</li>
                    <li>PredatorsMedium</li>
                    <li>PredatorsScout</li>
                </tags>
                <defaultOutfitTags>
                    <li>Worker</li>
                    <li>Soldier</li>
                </defaultOutfitTags>
                <parentTagDef>ApparelHead</parentTagDef>
                <forceEyesVisibleForRotations>
                    <li>1</li>
                    <li>2</li>
                    <li>3</li>
                </forceEyesVisibleForRotations>
            </apparel>
            <colorGenerator Class="ColorGenerator_Options">
                <options>
                    <li>
                        <weight>4</weight>
                        <min>(0.9,0.9,0.9,1)</min>
                        <max>(1,1,1,1)</max>
                    </li>
                </options>
            </colorGenerator>
            <thingCategories>
                <li>AnimalHeaddressCat</li>
            </thingCategories>
            <recipeMaker>
                <researchPrerequisite>Apparel_A2</researchPrerequisite>
                <displayPriority>160</displayPriority>
            </recipeMaker>
        </value>
    </Operation>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Apparel_TribalHeaddress"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.ApparelNeolithicSimpleBaseDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_TribalHeaddress"]</xpath>
        <value>
            <label>Feathered Headdress</label>
            <description>This feathered headdress offers little in the way of protection, however anyone who wears it feels the spirit of the warrior stirring from deep within.</description>
            <graphicData>
                <texPath>Things/Apparel/Hats/Feathers/Feathers</texPath>
                <graphicClass>Graphic_Single</graphicClass>
            </graphicData>
            <stuffCategories>
                <li>Leathery</li>
            </stuffCategories>
            <costStuffCount>22</costStuffCount>
            <statBases>
                <WorkToMake>4500</WorkToMake>
                <MaxHitPoints>34</MaxHitPoints>
                <Flammability>2</Flammability>
                <Mass>0.7</Mass>
                <Bulk>3</Bulk>
                <WornBulk>0</WornBulk>
                <EquipDelay>0.8</EquipDelay>
                <Insulation_Cold>2.5</Insulation_Cold>
                <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
                <StuffEffectMultiplierArmor>0.08</StuffEffectMultiplierArmor>
                <ArmorRating_Sharp>0</ArmorRating_Sharp>
                <ArmorRating_Blunt>0</ArmorRating_Blunt>
                <ArmorRating_Heat>0</ArmorRating_Heat>
            </statBases>
            <equippedStatOffsets>
                <MoveSpeed>-0.005</MoveSpeed>
                <SocialImpact>0.2</SocialImpact>
                <ShootingAccuracyPawn>0.06</ShootingAccuracyPawn>
                <AimingDelayFactor>-0.07</AimingDelayFactor>
                <GlobalLearningFactor>0.02</GlobalLearningFactor>
                <NegotiationAbility>0.1</NegotiationAbility>
                <TradePriceImprovement>0.1</TradePriceImprovement>
                <TrainAnimalChance>0.1</TrainAnimalChance>
                <TameAnimalChance>0.07</TameAnimalChance>
                <GermResistance>0.01</GermResistance>
                <GermContainment>0.01</GermContainment>
                <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
            </equippedStatOffsets>
            <generateCommonality>1.5</generateCommonality>
            <apparel>
                <countsAsClothingForNudity>false</countsAsClothingForNudity>
                <careIfWornByCorpse>false</careIfWornByCorpse>
                <bodyPartGroups>
                    <li>UpperHead</li>
                </bodyPartGroups>
                <wornGraphicPath>Things/Apparel/Hats/Feathers/Feathers</wornGraphicPath>
                <ideoDesireAllowedFactionCategoryTags>
                    <li>Tribal</li>
                </ideoDesireAllowedFactionCategoryTags>
                <layers>
                    <li>Overhead</li>
                </layers>
                <tags>
                    <li>Tribal</li>
                </tags>
                <defaultOutfitTags>
                    <li>Worker</li>
                </defaultOutfitTags>
                <parentTagDef>ApparelHead</parentTagDef>
            </apparel>
            <colorGenerator Class="ColorGenerator_Options">
                <options>
                    <li>
                        <weight>4</weight>
                        <min>(0.3,0.3,0.3,1)</min>
                        <max>(0.9,0.9,0.9,1)</max>
                    </li>
                </options>
            </colorGenerator>
            <thingCategories>
                <li>AnimalHeaddressCat</li>
            </thingCategories>
            <recipeMaker>
                <researchPrerequisite>Apparel_A1</researchPrerequisite>
            </recipeMaker>
        </value>
    </Operation>

</Patch>
