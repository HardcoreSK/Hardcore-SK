<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_PowerArmor"]</xpath>
    <value>
      <label>Power Armor</label>
      <description>An advanced suit of armor powered by uranium. It is usually used by assault troops from advanced glitterworld planets.</description>
      <graphicData>
        <texPath>Things/Apparel/HellEffect/ha</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <thingClass>SK.Apparel_PowerArmorShield</thingClass>
      <tickerType>Normal</tickerType>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>110</costStuffCount>
      <costList>
        <Carbon>25</Carbon>
        <Compaste>20</Compaste>
        <SyntheticFibers>15</SyntheticFibers>
        <MagneticMaterial>6</MagneticMaterial>
        <Hexcell>13</Hexcell>
      </costList>
      <statBases>
        <WorkToMake>33000</WorkToMake>
        <EnergyShieldRechargeRate>0.10</EnergyShieldRechargeRate>
        <EnergyShieldEnergyMax>2.0</EnergyShieldEnergyMax>
        <MaxHitPoints>130</MaxHitPoints>
        <Flammability>1</Flammability>
        <Mass>7</Mass>
        <Bulk>50</Bulk>
        <WornBulk>18</WornBulk>
        <EquipDelay>14</EquipDelay>
        <Insulation_Heat>10</Insulation_Heat>
        <Insulation_Cold>10</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>1</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>5.13</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>10.27</ArmorRating_Sharp>
        <ArmorRating_Blunt>29.279</ArmorRating_Blunt>
        <ArmorRating_Heat>0.11</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <CarryWeight>40</CarryWeight>
        <CarryBulk>15</CarryBulk>
        <MoveSpeed>-1.1</MoveSpeed>
        <WorkSpeedGlobal>-0.27</WorkSpeedGlobal>
        <MentalBreakThreshold>-0.08</MentalBreakThreshold>
        <PsychicSensitivity>-0.1</PsychicSensitivity>
        <ShootingAccuracyPawn>-0.15</ShootingAccuracyPawn>
        <AimingDelayFactor>0.2</AimingDelayFactor>
        <MeleeHitChance>-0.26</MeleeHitChance>
        <MeleeWeapon_CooldownMultiplier>0.21</MeleeWeapon_CooldownMultiplier>
        <ImmunityGainSpeed>0.2</ImmunityGainSpeed>
        <Suppressability>-0.23</Suppressability>
        <ArmorRating_Toxin>0.35</ArmorRating_Toxin>
        <Radiation>-0.25</Radiation>
        <GermResistance>0.05</GermResistance>
        <GermContainment>0.03</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <bodyPartGroups>
          <li>Torso</li>
          <li>Neck</li>
          <li>Shoulders</li>
          <li>Arms</li>
          <li>Legs</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/HellEffect/ha</wornGraphicPath>
        <layers>
          <li>Middle</li>
          <li>Shell</li>
        </layers>
        <tags>
          <li>Spacer</li>
          <li>Military</li>
          <li>SpacerMilitary</li>
          <li>SyndicateMedium</li>
          <li>AsariPowerArmor</li>
          <li>OrionMedium</li>
        </tags>
        <defaultOutfitTags>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <soundWear>Wear_PowerArmor</soundWear>
        <soundRemove>Remove_PowerArmor</soundRemove>
      </apparel>
      <thingSetMakerTags>
        <li>RewardStandardHighFreq</li>
      </thingSetMakerTags>
      <thingCategories>
        <li>HeavyFullArmorCat</li>
        <li>Setpowerarmor</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>ReconArmor</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="ApparelArmorReconBase"]</xpath>
    <value>
      <thingClass>SK.OpticEvasionArmor</thingClass>
      <tickerType>Normal</tickerType>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>110</costStuffCount>
      <costList>
        <Carbon>20</Carbon>
        <Compaste>25</Compaste>
        <BiosyntheticMaterial>4</BiosyntheticMaterial>
        <ChitinPlating>70</ChitinPlating>
      </costList>
      <statBases>
        <WorkToMake>32000</WorkToMake>
        <MaxHitPoints>195</MaxHitPoints>
        <Flammability>1</Flammability>
        <Mass>6</Mass>
        <Bulk>22</Bulk>
        <WornBulk>15</WornBulk>
        <EquipDelay>14</EquipDelay>
        <Insulation_Heat>8</Insulation_Heat>
        <Insulation_Cold>15</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>1</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>5.23</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>11.2</ArmorRating_Sharp>
        <ArmorRating_Blunt>27.191</ArmorRating_Blunt>
        <ArmorRating_Heat>0.075</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <CarryWeight>40</CarryWeight>
        <CarryBulk>15</CarryBulk>
        <MoveSpeed>-1.3</MoveSpeed>
        <WorkSpeedGlobal>-0.3</WorkSpeedGlobal>
        <MentalBreakThreshold>-0.08</MentalBreakThreshold>
        <PsychicSensitivity>0.1</PsychicSensitivity>
        <ShootingAccuracyPawn>-0.22</ShootingAccuracyPawn>
        <AimingDelayFactor>0.22</AimingDelayFactor>
        <MeleeHitChance>-0.27</MeleeHitChance>
        <MeleeWeapon_CooldownMultiplier>0.22</MeleeWeapon_CooldownMultiplier>
        <ImmunityGainSpeed>0.25</ImmunityGainSpeed>
        <Suppressability>-0.24</Suppressability>
        <ArmorRating_Toxin>0.4</ArmorRating_Toxin>
        <Radiation>-0.35</Radiation>
        <GermResistance>0.05</GermResistance>
        <GermContainment>0.04</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <bodyPartGroups>
          <li>Torso</li>
          <li>Neck</li>
          <li>Shoulders</li>
          <li>Arms</li>
          <li>Legs</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ReconArmor/ReconArmor</wornGraphicPath>
        <layers>
          <li>Middle</li>
          <li>Shell</li>
        </layers>
        <defaultOutfitTags>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <soundWear>Wear_PowerArmor</soundWear>
        <soundRemove>Remove_PowerArmor</soundRemove>
      </apparel>
      <colorGenerator Class="ColorGenerator_Options">
        <options>
          <li>
            <weight>10</weight>
            <only>(0.33,0.33,0.33)</only>
          </li>
          <li>
            <weight>10</weight>
            <only>(0.65,0.65,0.65)</only>
          </li>
          <li>
            <weight>6</weight>
            <min>(0.3,0.3,0.3)</min>
            <max>(0.5,0.5,0.5)</max>
          </li>
          <li>
            <weight>10</weight>
            <only>(0.9,0.9,0.9)</only>
          </li>
        </options>
      </colorGenerator>
      <thingCategories>
        <li>LightFullArmorCat</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>Armor_D1</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorRecon"]</xpath>
    <value>
      <apparel>
        <tags>
          <li>SpacerMilitary</li>
          <li>OrassanTacticalCommander</li>
        </tags>
      </apparel>
      <equippedStatOffsets>
        <CarryWeight>10</CarryWeight>
        <CarryBulk>20</CarryBulk>
        <MoveSpeed>0.3</MoveSpeed>
        <WorkSpeedGlobal>-0.15</WorkSpeedGlobal>
        <ShootingAccuracyPawn>-0.12</ShootingAccuracyPawn>
        <AimingDelayFactor>0.15</AimingDelayFactor>
        <MeleeHitChance>-0.17</MeleeHitChance>
        <MeleeWeapon_CooldownMultiplier>0.22</MeleeWeapon_CooldownMultiplier>
        <Suppressability>-0.14</Suppressability>
        <ArmorRating_Toxin>0.4</ArmorRating_Toxin>
        <Radiation>-0.35</Radiation>
        <GermResistance>0.05</GermResistance>
        <GermContainment>0.04</GermContainment>
      </equippedStatOffsets>
    </value>
  </Operation>

</Patch>
