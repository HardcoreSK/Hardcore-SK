                    <li>PredatorsMedium</li>
                    <li>EmpireMedium</li>
                </tags>
                <defaultOutfitTags>
                    <li>Worker</li>
                </defaultOutfitTags>
            </apparel><!-- Why are we limiting the colour options?
      <colorGenerator Class="ColorGenerator_Options">
        <options>
          <li>
            <weight>6</weight>
            <max>(1,1,1,1)</max>
            <min>(0.70,0.70,0.70,1)</min>
          </li>
        </options>
      </colorGenerator>-->
            <thingCategories>
                <li>UpperOverdressCat</li>
            </thingCategories>
            <recipeMaker>
                <researchPrerequisite>Apparel_B3</researchPrerequisite>
            </recipeMaker>
        </value>
