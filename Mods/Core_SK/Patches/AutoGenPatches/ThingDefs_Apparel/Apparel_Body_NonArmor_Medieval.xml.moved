<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Apparel_Cape"]</xpath>
        <attribute>ParentName</attribute>
        <value>SK.ApparelMedievalBaseDummy</value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="Apparel_Cape"]</xpath>
        <value>
            <costStuffCount>75</costStuffCount>
            <statBases>
                <WorkToMake>15000</WorkToMake>
                <MaxHitPoints>95</MaxHitPoints>
                <Flammability>1</Flammability>
                <Mass>2</Mass>
                <Bulk>9</Bulk>
                <WornBulk>6</WornBulk>
                <EquipDelay>3</EquipDelay>
                <Insulation_Heat>3</Insulation_Heat>
                <Insulation_Cold>4</Insulation_Cold>
                <StuffEffectMultiplierInsulation_Cold>0.50</StuffEffectMultiplierInsulation_Cold>
                <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
                <StuffEffectMultiplierArmor>0.48</StuffEffectMultiplierArmor>
                <ArmorRating_Sharp>0</ArmorRating_Sharp>
                <ArmorRating_Blunt>0</ArmorRating_Blunt>
                <ArmorRating_Heat>0</ArmorRating_Heat>
            </statBases>
            <equippedStatOffsets>
                <MoveSpeed>-0.11</MoveSpeed>
                <WorkSpeedGlobal>-0.06</WorkSpeedGlobal>
                <AimingDelayFactor>-0.07</AimingDelayFactor>
                <GermResistance>0.03</GermResistance>
                <GermContainment>0.03</GermContainment>
            </equippedStatOffsets>
            <generateCommonality>2.4</generateCommonality>
            <apparel Merge="true">
                <tags>
                    <li>NorbalKingly</li>
                    <li>NorbalSage</li>
                    <li>Norbal</li>
                    <li>Outlander</li>
                    <li>BanditsLight</li>
                    <li>RenegadesLight</li>
                    <li>RenegadesMedium</li>
                    <li>PredatorsLight</li>
                    <li>PredatorsScout</li>
                    <li>PredatorsMedium</li>
                    <li>EmpireLight</li>
                    <li>EmpireMedium</li>
                    <li>EmpireScout</li>
                    <li>Cape</li>
                    <li>Royal</li>
                    <li>RoyalTier2</li>
                    <li>RoyalTier5</li>
                </tags>
                <defaultOutfitTags>
                    <li>Worker</li>
                    <li>Soldier</li>
                </defaultOutfitTags>
            </apparel>
            <thingCategories>
                <li>ApparelNoble</li>
                <li>SetNoble</li>
            </thingCategories>
            <recipeMaker Inherit="false">
                <workSpeedStat>TailoringSpeed</workSpeedStat>
                <workSkill>Crafting</workSkill>
                <effectWorking>Tailor</effectWorking>
                <soundWorking>Recipe_Tailor</soundWorking>
                <recipeUsers>
                    <li>HandTailoringBench</li>
                </recipeUsers>
                <skillRequirements>
                    <Crafting>8</Crafting>
                </skillRequirements>
                <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
                <researchPrerequisite>NobleApparel</researchPrerequisite>
                <displayPriority>235</displayPriority>
            </recipeMaker>
        </value>
    </Operation>

