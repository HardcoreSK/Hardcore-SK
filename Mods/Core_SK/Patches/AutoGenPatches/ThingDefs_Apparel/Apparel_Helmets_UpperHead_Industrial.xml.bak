<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_SimpleHelmet"]</xpath>
    <value>
      <graphicData>
        <texPath>Things/Apparel/Vanilla/SimpleHelmet</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costList>
        <ComponentIndustrial>4</ComponentIndustrial>
        <Compaste>20</Compaste>
        <SyntheticFibers>7</SyntheticFibers>
      </costList>
      <statBases>
        <WorkToMake>10000</WorkToMake>
        <MaxHitPoints>53</MaxHitPoints>
        <Flammability>1.2</Flammability>
        <Mass>0.8</Mass>
        <Bulk>3</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>1.8</EquipDelay>
        <Insulation_Cold>2.5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>5.13</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>10.27</ArmorRating_Sharp>
        <ArmorRating_Blunt>21.95925</ArmorRating_Blunt>
        <ArmorRating_Heat>0</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <MoveSpeed>-0.14</MoveSpeed>
        <WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
        <MentalBreakThreshold>-0.03</MentalBreakThreshold>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <bodyPartGroups>
          <li>UpperHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Vanilla/SimpleHelmet</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>Military</li>
          <li>IndustrialMilitaryBasic</li>
          <li>BrotherhoodMedium</li>
          <li>EmpireMedium</li>
          <li>OrassanTacticalEngineer</li>
        </tags>
        <defaultOutfitTags>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel>
      <thingCategories>
        <li>HeavyHelmetsCat</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>Armor_C1</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_AdvancedHelmet"]</xpath>
    <value>
      <label>Advanced Helmet</label>
      <description>A lightweight armored combat helmet that protects your head and ears.</description>
      <graphicData>
        <texPath>Things/Apparel/Vanilla/AdvancedHelmet</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>30</costStuffCount>
      <costList>
        <Compaste>10</Compaste>
        <ComponentIndustrial>4</ComponentIndustrial>
        <ReinforcedGlass>5</ReinforcedGlass>
        <Kevlar>25</Kevlar>
      </costList>
      <statBases>
        <WorkToMake>11000</WorkToMake>
        <MaxHitPoints>55</MaxHitPoints>
        <Flammability>1.1</Flammability>
        <Mass>0.8</Mass>
        <Bulk>3</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>2.1</EquipDelay>
        <Insulation_Cold>2.5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>5.44</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>10.88</ArmorRating_Sharp>
        <ArmorRating_Blunt>24.8216</ArmorRating_Blunt>
        <ArmorRating_Heat>0.04</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
        <MentalBreakThreshold>-0.03</MentalBreakThreshold>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <bodyPartGroups>
          <li>UpperHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Vanilla/AdvancedHelmet</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>IndustrialMilitaryAdvanced</li>
          <li>BrotherhoodMedium</li>
          <li>SectarianMedium</li>
        </tags>
        <defaultOutfitTags>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel>
      <thingCategories>
        <li>HeavyHelmetsCat</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>FlakArmor</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

</Patch>
