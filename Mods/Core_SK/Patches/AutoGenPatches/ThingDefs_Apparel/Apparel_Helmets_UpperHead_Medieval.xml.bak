<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_HatHood"]</xpath>
    <value>
      <label>Draped hood</label>
      <statBases>
        <MaxHitPoints>40</MaxHitPoints>
        <WorkToMake>5000</WorkToMake>
        <Flammability>1.4</Flammability>
        <Mass>0.5</Mass>
        <Bulk>2</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>0.8</EquipDelay>
        <Insulation_Cold>6</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.17</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.13</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>1.41</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>0</ArmorRating_Sharp>
        <ArmorRating_Blunt>0</ArmorRating_Blunt>
        <ArmorRating_Heat>0</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <MoveSpeed>-0.02</MoveSpeed>
        <WorkSpeedGlobal>-0.01</WorkSpeedGlobal>
        <SocialImpact>0.2</SocialImpact>
        <MentalBreakThreshold>-0.01</MentalBreakThreshold>
        <NegotiationAbility>0.07</NegotiationAbility>
        <TradePriceImprovement>0.1</TradePriceImprovement>
        <TrainAnimalChance>0.06</TrainAnimalChance>
        <TameAnimalChance>0.05</TameAnimalChance>
        <GermResistance>0.03</GermResistance>
        <GermContainment>0.02</GermContainment>
      </equippedStatOffsets>
      <costStuffCount>40</costStuffCount>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Hood/Hood</wornGraphicPath>
        <bodyPartGroups>
          <li>UpperHead</li>
        </bodyPartGroups>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>BestowerHood</li>
        </tags>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel>
      <thingCategories>
        <li>HeaddressCat</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>ComplexClothing</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

</Patch>
