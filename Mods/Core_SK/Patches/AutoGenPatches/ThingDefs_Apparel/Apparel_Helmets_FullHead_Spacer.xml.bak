<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_PowerArmorHelmet"]</xpath>
    <value>
      <label>Power Armor Helmet</label>
      <description>The helmet part of power armor set. It is mostly used by heavy infantry.</description>
      <graphicData>
        <texPath>Things/Apparel/HellEffect/Hivehat</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <thingClass>SK.Apparel_PowerHelmet</thingClass>
      <tickerType>Normal</tickerType>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>55</costStuffCount>
      <costList>
        <Carbon>12</Carbon>
        <Compaste>20</Compaste>
        <SyntheticFibers>8</SyntheticFibers>
        <MagneticMaterial>2</MagneticMaterial>
        <Hexcell>5</Hexcell>
      </costList>
      <statBases>
        <WorkToMake>19000</WorkToMake>
        <EnergyShieldRechargeRate>0.05</EnergyShieldRechargeRate>
        <EnergyShieldEnergyMax>0.9</EnergyShieldEnergyMax>
        <MaxHitPoints>58</MaxHitPoints>
        <Flammability>1</Flammability>
        <Mass>1</Mass>
        <Bulk>3</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>2.7</EquipDelay>
        <Insulation_Heat>5</Insulation_Heat>
        <Insulation_Cold>5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>4.67</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>9.35</ArmorRating_Sharp>
        <ArmorRating_Blunt>26.657</ArmorRating_Blunt>
        <ArmorRating_Heat>0.04</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <MoveSpeed>-0.18</MoveSpeed>
        <WorkSpeedGlobal>-0.06</WorkSpeedGlobal>
        <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        <PsychicSensitivity>-0.1</PsychicSensitivity>
        <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
        <AimingDelayFactor>0.05</AimingDelayFactor>
        <ImmunityGainSpeed>0.1</ImmunityGainSpeed>
        <Suppressability>-0.09</Suppressability>
        <ArmorRating_Toxin>0.2</ArmorRating_Toxin>
        <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
        <SmokeSensitivity>-1</SmokeSensitivity>
        <Radiation>-0.25</Radiation>
        <GermResistance>0.70</GermResistance>
        <GermContainment>0.80</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <bodyPartGroups>
          <li>FullHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/HellEffect/Hivehat</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>SpacerMilitary</li>
          <li>AsariPowerArmor</li>
          <li>SyndicateMedium</li>
          <li>OrionMedium</li>
        </tags>
        <defaultOutfitTags>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel>
      <thingSetMakerTags>
        <li>RewardStandardHighFreq</li>
      </thingSetMakerTags>
      <comps>
		</comps>
      <thingCategories>
        <li>HeavyHelmetsCat</li>
        <li>Setpowerarmor</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>PoweredArmor</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetRecon"]</xpath>
    <value>
      <description>A high-tech armored helmet with a built-in status computer and a protective plate.\n\nArmor like this is often used by imperial scout troops or glitterworld police forces.</description>
      <graphicData>
        <texPath>Things/Pawn/Humanlike/Apparel/ReconArmorHelmet/ReconHelmet</texPath>
        <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <thingClass>SK.Apparel_PowerHelmet</thingClass>
      <tickerType>Normal</tickerType>
      <stuffCategories>
        <li>StrongMetallic</li>
      </stuffCategories>
      <costStuffCount>30</costStuffCount>
      <costList>
        <Compaste>20</Compaste>
        <ChitinPlating>30</ChitinPlating>
        <MagneticMaterial>2</MagneticMaterial>
        <Hexcell>3</Hexcell>
      </costList>
      <statBases>
        <WorkToMake>14500</WorkToMake>
        <EnergyShieldRechargeRate>0.03</EnergyShieldRechargeRate>
        <EnergyShieldEnergyMax>0.65</EnergyShieldEnergyMax>
        <MaxHitPoints>50</MaxHitPoints>
        <Flammability>1.1</Flammability>
        <Mass>1</Mass>
        <Bulk>3</Bulk>
        <WornBulk>0</WornBulk>
        <EquipDelay>1.2</EquipDelay>
        <Insulation_Heat>5</Insulation_Heat>
        <Insulation_Cold>5</Insulation_Cold>
        <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
        <StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
        <StuffEffectMultiplierArmor>3.9</StuffEffectMultiplierArmor>
        <ArmorRating_Sharp>6.8</ArmorRating_Sharp>
        <ArmorRating_Blunt>14.5</ArmorRating_Blunt>
        <ArmorRating_Heat>0.12</ArmorRating_Heat>
      </statBases>
      <equippedStatOffsets>
        <MoveSpeed>-0.11</MoveSpeed>
        <WorkSpeedGlobal>-0.03</WorkSpeedGlobal>
        <PsychicSensitivity>-0.1</PsychicSensitivity>
        <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
        <AimingDelayFactor>-0.1</AimingDelayFactor>
        <GlobalLearningFactor>0.05</GlobalLearningFactor>
        <ImmunityGainSpeed>0.15</ImmunityGainSpeed>
        <Suppressability>-0.06</Suppressability>
        <ArmorRating_Toxin>0.2</ArmorRating_Toxin>
        <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
        <SmokeSensitivity>-1</SmokeSensitivity>
        <Radiation>-0.30</Radiation>
        <GermResistance>0.70</GermResistance>
        <GermContainment>0.80</GermContainment>
      </equippedStatOffsets>
      <generateCommonality>1</generateCommonality>
      <apparel>
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <bodyPartGroups>
          <li>FullHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ReconArmorHelmet/ReconHelmet</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags>
          <li>SpacerMilitary</li>
          <li>OrassanTacticalCommander</li>
        </tags>
        <defaultOutfitTags>
          <li>Worker</li>
          <li>Soldier</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
        <parentTagDef>ApparelHead</parentTagDef>
      </apparel>
      <colorGenerator Class="ColorGenerator_Options">
        <options>
          <li>
            <weight>10</weight>
            <only>(0.33,0.33,0.33,1)</only>
          </li>
          <li>
            <weight>10</weight>
            <only>(0.65,0.65,0.65,1)</only>
          </li>
          <li>
            <weight>6</weight>
            <min>(0.3,0.3,0.3,1)</min>
            <max>(0.5,0.5,0.5,1)</max>
          </li>
          <li>
            <weight>10</weight>
            <only>(0.9,0.9,0.9,1)</only>
          </li>
        </options>
      </colorGenerator>
      <thingSetMakerTags>
        <li>RewardStandardHighFreq</li>
      </thingSetMakerTags>
      <comps>
		</comps>
      <thingCategories>
        <li>LightHelmetsCat</li>
      </thingCategories>
      <recipeMaker>
        <researchPrerequisite>Armor_D1</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

</Patch>
