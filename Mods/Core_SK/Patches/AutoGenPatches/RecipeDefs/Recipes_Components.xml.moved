<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_ComponentIndustrial"]</xpath>
    <value>
      <label>Assemble components</label>
      <description>Assembles components from metal. Produces 10.</description>
      <jobString>Assembling components.</jobString>
      <workAmount>2000</workAmount>
      <workSpeedStat>SmithingSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <recipeUsers>
        <li>FabricationBench</li>
        <li>AdvToolBench</li>
      </recipeUsers>
      <ingredients>
        <li>
          <filter>
            <categories>
              <li>SLDBar</li>
              <li>USLDBar</li>
            </categories>
          </filter>
          <count>30</count>
        </li>
      </ingredients>
      <fixedIngredientFilter>
        <categories>
          <li>SLDBar</li>
          <li>USLDBar</li>
        </categories>
      </fixedIngredientFilter>
      <defaultIngredientFilter>
        <thingDefs>
          <li>Bronze</li>
          <li>Steel</li>
        </thingDefs>
        <disallowedThingDefs>
          <li>FerrosiliconAlloy</li>
          <li>CupronickelAlloy</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
      <products>
        <ComponentIndustrial>10</ComponentIndustrial>
      </products>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <workSkillLearnFactor>0.8</workSkillLearnFactor>
      <researchPrerequisite>Craft_0</researchPrerequisite>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_ComponentSpacer"]</xpath>
    <value>
      <label>Assemble spacer components</label>
      <description>Assemble spacer components from metal. Produces 10.</description>
      <jobString>Assembling spacer components.</jobString>
      <workAmount>3500</workAmount>
      <workSpeedStat>SmithingSpeed</workSpeedStat>
      <effectWorking>Smith</effectWorking>
      <recipeUsers>
        <li>AdvToolBench</li>
      </recipeUsers>
      <ingredients>
        <li>
          <filter>
            <categories>
              <li>USLDBar</li>
            </categories>
          </filter>
          <count>25</count>
        </li>
        <li>
          <filter>
            <categories>
              <li>PRSBar</li>
            </categories>
          </filter>
          <count>5</count>
        </li>
      </ingredients>
      <fixedIngredientFilter>
        <categories>
          <li>USLDBar</li>
          <li>PRSBar</li>
        </categories>
      </fixedIngredientFilter>
      <products>
        <ComponentSpacer>10</ComponentSpacer>
      </products>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <workSkillLearnFactor>0.8</workSkillLearnFactor>
      <researchPrerequisite>Components_D1</researchPrerequisite>
    </value>
  </Operation>

</Patch>
