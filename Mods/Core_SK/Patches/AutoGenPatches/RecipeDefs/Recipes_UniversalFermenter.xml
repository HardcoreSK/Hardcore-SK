<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromWood"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.GlitterpediaModExtBaseDummy</value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromWood"]</xpath>
	  <attribute>Class</attribute>
	  <value>UniversalFermenterSK.RecipeDef_UF</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromWood"]</xpath>
    <value>
      <description>Make a batch of chemfuel by extracting and condensing wood gas from logs. Takes 1.5 days to make</description>
      <recipeUsers>
        <li>BiofuelRefinery</li>
      </recipeUsers>
      <ruinedIfNoPowerOrNoFuelOrFlickedOffPerHour>5</ruinedIfNoPowerOrNoFuelOrFlickedOffPerHour>
      <usesTemperature>false</usesTemperature>
      <processDays>1.5</processDays>
    </value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromOrganics"]</xpath>
	  <attribute>ParentName</attribute>
	  <value>SK.GlitterpediaModExtBaseDummy</value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
	  <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromOrganics"]</xpath>
	  <attribute>Class</attribute>
	  <value>UniversalFermenterSK.RecipeDef_UF</value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_ChemfuelFromOrganics"]</xpath>
    <value Merge="true">
      <description>Make a batch of chemfuel by extracting biofuel from organic feedstocks. Takes 1.5 days to make</description>
      <fixedIngredientFilter>
        <categories>
          <li>Foods</li>
          <li>PlantMatter</li>
        </categories>
        <disallowedThingDefs>
          <li>Hay</li>
          <li>Dye</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">HemogenPack</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">BabyFood</li>
        </disallowedThingDefs>
        <disallowedCategories>
          <li>FoodMeals</li>
          <li MayRequire="notfood.SeedsPlease">SeedsCategory</li>
        </disallowedCategories>
      </fixedIngredientFilter>
      <recipeUsers>
        <li>BiofuelRefinery</li>
      </recipeUsers>
      <ruinedIfNoPowerOrNoFuelOrFlickedOffPerHour>5</ruinedIfNoPowerOrNoFuelOrFlickedOffPerHour>
      <usesTemperature>false</usesTemperature>
      <processDays>1.5</processDays>
    </value>
  </Operation>

</Patch>
