<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/RecipeDef[defName="Make_Wort"]</xpath>
    <value>
      <label>Brew wort</label>
      <description>Brew a batch of wort from hops. Produces 10.</description>
      <jobString>Brewing batch of wort.</jobString>
      <workAmount>600</workAmount>
      <recipeUsers>
        <li>Brewery</li>
        <li>ElectricBrewery</li>
      </recipeUsers>
      <ingredients>
        <li>
          <filter>
            <thingDefs>
              <li>RawHops</li>
            </thingDefs>
          </filter>
          <count>15</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>Sugar</li>
            </thingDefs>
          </filter>
          <count>5</count>
        </li>
        <li>
          <filter>
            <thingDefs>
              <li>Yeast</li>
            </thingDefs>
          </filter>
          <count>10</count>
        </li>
      </ingredients>
      <fixedIngredientFilter>
        <thingDefs>
          <li>RawHops</li>
          <li>Sugar</li>
          <li>Yeast</li>
        </thingDefs>
      </fixedIngredientFilter>
      <products>
        <Wort>10</Wort>
      </products>
      <skillRequirements>
        <Cooking>6</Cooking>
      </skillRequirements>
      <researchPrerequisite>Brewing</researchPrerequisite>
    </value>
  </Operation>

</Patch>
