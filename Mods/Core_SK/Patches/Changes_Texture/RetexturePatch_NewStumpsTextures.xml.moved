<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="ChoppedStump"]/graphicData/texPath</xpath>
                <value>
                    <texPath>Things/Trees/Stumps/Chopped/Normal</texPath>
                </value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="SmashedStump"]/graphicData/texPath</xpath>
                <value>
                    <texPath>Things/Trees/Stumps/Smashed/Normal</texPath>
                </value>
            </li>
        </operations>
    </Operation>
</Patch>
