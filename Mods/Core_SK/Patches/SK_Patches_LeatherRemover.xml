<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Remove unused leather from the game -->
	
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="GuineaPig"]</xpath>
		<value Merge="true">
			<race Merge="true">
				<leatherDef>Leather_Light</leatherDef>
			</race>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Alpaca"]</xpath>
		<value Merge="true">
			<race Merge="true">
				<leatherDef>Leather_Plain</leatherDef>
			</race>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[@Name="BaseBear" or defName="Dromedary"]</xpath>
		<value Merge="true">
			<race Merge="true">
				<leatherDef>Leather_Heavy</leatherDef>
			</race>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Leather_GuineaPig"]</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Leather_Bear"]</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Leather_Camel"]</xpath>
	</Operation>

</Patch>
