<?xml version="1.0" encoding="UTF-8"?>
<Patch>


	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeTox"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.BaseGrenadeEquipmentDummy</value>
	</Operation>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeTox"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Weapon_GrenadeTox"]</xpath>
		<value>
			<possessionCount>1</possessionCount>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<stackLimit>25</stackLimit>
			<resourceReadoutPriority>First</resourceReadoutPriority>
			<graphicData>
				<texPath>Things/Ammo/HandGrenades/Tox</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
				<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
			</graphicData>
			<statBases Merge="True">
				<Mass>0.539</Mass>
				<Bulk>1.05</Bulk>
				<MarketValue>10.15</MarketValue>
				<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
				<SightsEfficiency>0.65</SightsEfficiency>
			</statBases>
			<weaponTags Merge="True">
				<li>CE_AI_AOE</li>
			</weaponTags>
			<verbs>
				<li Class="CombatExtended.VerbPropertiesCE">
					<label>throw tox grenade</label>
					<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<range>10</range>
					<minRange>3</minRange>
					<warmupTime>0.8</warmupTime>
					<noiseRadius>4</noiseRadius>
					<ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
					<soundCast>ThrowGrenade</soundCast>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<defaultProjectile>Proj_GrenadeTox</defaultProjectile>
					<onlyManualCast>true</onlyManualCast>
					<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
					<ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
				</li>
			</verbs>
			<detonateProjectile>Proj_GrenadeTox</detonateProjectile>
			<comps>
				<li Class="CombatExtended.CompProperties_ExplosiveCE">
					<explosiveRadius>2.9</explosiveRadius>
					<explosiveDamageType>ToxGas</explosiveDamageType>
					<postExplosionGasType>ToxGas</postExplosionGasType>
				</li>
			</comps>
			<smeltProducts>
				<Steel>4</Steel>
				<Plastic>1</Plastic>
				<Chemfuel>2</Chemfuel>
				<ComponentIndustrial>1</ComponentIndustrial>
			</smeltProducts>
		</value>
	</Operation>

	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeTox"]</xpath>
		<attribute>ParentName</attribute>
		<value>SK.SK_BaseGrenadeProjectileDummy</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Proj_GrenadeTox"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
			<graphicData>
				<texPath>Things/Projectile/Grenades/Tox</texPath>
				<graphicClass>Graphic_Single</graphicClass>
			</graphicData>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<damageDef>ToxGas</damageDef>
				<explosionRadius>2.9</explosionRadius>
				<explosionDelay>100</explosionDelay>
				<postExplosionGasType>ToxGas</postExplosionGasType>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<casingFilthDefname>Filth_GrenadeAmmoCasings</casingFilthDefname>
				<speed>12</speed>
				<screenShakeFactor>0</screenShakeFactor>
			</projectile>
			<comps />
		</value>
	</Operation>
</Patch>