<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RecipeDef ParentName="GlitterpediaModExtBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>MakeCharcoal_Pit_Half</defName>
		<label>burn wood into charcoal (half load)</label>
		<description>Burn wood into charcoal. Takes 1 day to burn and half of the pit capacity.</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Wooden</li>
					</categories>
				</filter>
				<count>50</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Dirt</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>Wooden</li>
			</categories>
			<thingDefs>
				<li>Dirt</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>Dirt</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<Charcoal>40</Charcoal>
			<Dirt>3</Dirt>
		</products>
		<recipeUsers>
			<li>CharcoalPit</li>
		</recipeUsers>
		<!-- RecipeDef_UF fields -->
		<temperatureSafe>
			<min>-25</min>
			<max>200</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>0</min>
			<max>100</max>
		</temperatureIdeal>
		<ruinedPerDegreePerHour>0</ruinedPerDegreePerHour>
		<processDays>1</processDays>
		<speedBelowSafe>0.05</speedBelowSafe>
		<speedAboveSafe>0.8</speedAboveSafe>
		<graphicSuffix>_closed</graphicSuffix>
		<slotsRequired>5</slotsRequired>
	</RecipeDef>

