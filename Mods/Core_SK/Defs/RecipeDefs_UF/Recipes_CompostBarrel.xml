<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<RecipeDef ParentName="GlitterpediaModExtBase" Name="Make_FertilizerBase" Abstract="True">
		<recipeUsers>
			<li>CompostBarrel</li>
		</recipeUsers>

		<!-- RecipeDef_UF fields -->
		<temperatureSafe>
			<min>-1</min>
			<max>49</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>10</min>
			<max>30</max>
		</temperatureIdeal>
		<processDays>2.8</processDays>
		<speedBelowSafe>0.5</speedBelowSafe>
		<speedAboveSafe>1</speedAboveSafe>
	</RecipeDef>

	<RecipeDef ParentName="Make_FertilizerBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Fertilizer</defName>
		<label>make fertilizer</label>
		<description>Make fertilizer. Takes 2.8 days to make</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Compost</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<products>
			<Fertilizer>1</Fertilizer>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="Make_FertilizerBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Fertilizer_x5</defName>
		<label>make fertilizer x5</label>
		<description>Make fertilizer x5. Takes 2.8 days to make</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Compost</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<products>
			<Fertilizer>5</Fertilizer>
		</products>

		<!-- RecipeDef_UF fields -->
		<slotsRequired>5</slotsRequired>
	</RecipeDef>

</Defs>