<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<RecipeDef ParentName="GlitterpediaModExtBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>CrushChunkSand</defName>
		<label>pulverize chunks into sand</label>
		<description>Obtain sand by pulverizing a chunk of stone</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>StoneChunks</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>StoneChunks</li>
			</categories>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<categories>
				<li>StoneChunks</li>
			</categories>
		</defaultIngredientFilter>
		<products>
			<SandResource>80</SandResource>
		</products>
		<recipeUsers>
			<li>RockCrusher</li>
		</recipeUsers>

		<!-- RecipeDef_UF fields -->
		<usesTemperature>false</usesTemperature>
		<processDays>0.8</processDays>
		<autoExtract>true</autoExtract>
	</RecipeDef>

