<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--___________________ElectricDryingRack_____________________-->
    <RecipeDef ParentName="GlitterpediaModExtBase" Name="UFDryingIndustrialBase" Abstract="True">
		<recipeUsers>
			<li>ElectricDryingRack</li>
		</recipeUsers>
        <graphicSuffix>_on</graphicSuffix>
		<!-- RecipeDef_UF fields -->
		<usesTemperature>false</usesTemperature>
	</RecipeDef>
    
	<RecipeDef ParentName="UFDryingIndustrialBase" Name="Make_JerkyIndustrialBase" Abstract="True">
		<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>SaltedMeat</li>
				<li>Tofu</li>
				<li>soylentgreen</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>MetalCannedMeat_raw</li>
				<li>MetalCannedMeat_prime</li>
				<li>Meat_Megaspider</li>
				<li>Meat_Human</li>
				<li MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</li>
			</disallowedThingDefs>
		</defaultIngredientFilter>
		<processDays>0.5</processDays>
	</RecipeDef>

	<RecipeDef ParentName="Make_JerkyIndustrialBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_JerkyIndustrial_x1</defName>
		<label>make jerky</label>
		<description>Make jerky meat. Takes half a day to make.</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
			<MealJerky>10</MealJerky>
		</products>
		<slotsRequired>1</slotsRequired>
	</RecipeDef>

	<RecipeDef ParentName="Make_JerkyIndustrialBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_JerkyIndustrial_x5</defName>
		<label>make jerky x5</label>
		<description>Make jerky meat x5. Takes half a day to make.</description>
		<ingredients>
