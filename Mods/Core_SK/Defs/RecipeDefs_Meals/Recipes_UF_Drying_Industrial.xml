					</categories>
				</filter>
				<count>50</count>
			</li>
		</ingredients>
		<products>
			<MealJerky>50</MealJerky>
		</products>
		<slotsRequired>5</slotsRequired>
	</RecipeDef>

	<RecipeDef ParentName="Make_JerkyIndustrialBase" Class="UniversalFermenterSK.RecipeDef_UF">
