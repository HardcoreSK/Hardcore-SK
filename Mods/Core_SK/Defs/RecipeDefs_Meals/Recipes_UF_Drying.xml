<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--___________________JerkyRack_____________________-->
	<RecipeDef ParentName="GlitterpediaModExtBase" Name="Make_JerkyBase" Abstract="True">
		<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>SaltedMeat</li>
				<li>Tofu</li>
				<li>soylentgreen</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>MetalCannedMeat_raw</li>
				<li>MetalCannedMeat_prime</li>
				<li>Meat_Megaspider</li>
				<li>Meat_Human</li>
				<li MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</li>
			</disallowedThingDefs>
		</defaultIngredientFilter>
		<recipeUsers>
			<li>JerkyRack</li>
		</recipeUsers>

		<!-- RecipeDef_UF fields -->
		<temperatureSafe>
			<min>10</min>
			<max>55</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>25</min>
			<max>40</max>
		</temperatureIdeal>
		<processDays>2</processDays>
		<speedBelowSafe>0.6</speedBelowSafe>
		<speedAboveSafe>1</speedAboveSafe>
		<sunFactor>
			<min>0.75</min>
			<max>1.2</max>
		</sunFactor>
		<rainFactor>
			<min>1</min>
			<max>0</max>
		</rainFactor>
		<snowFactor>
			<min>1</min>
			<max>0</max>
		</snowFactor>
		<windFactor>
			<min>1</min>
			<max>1.2</max>
		</windFactor>
	</RecipeDef>

	<RecipeDef ParentName="Make_JerkyBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Jerky</defName>
		<label>make jerky</label>
		<description>Make jerky meat. Takes 2 days to make</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
			<MealJerky>10</MealJerky>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="Make_JerkyBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Jerky_x5</defName>
		<label>make jerky x5</label>
		<description>Make jerky meat x5. Takes 2 days to make</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>50</count>
			</li>
		</ingredients>
		<products>
			<MealJerky>50</MealJerky>
		</products>

		<!-- RecipeDef_UF fields -->
		<slotsRequired>5</slotsRequired>
	</RecipeDef>

