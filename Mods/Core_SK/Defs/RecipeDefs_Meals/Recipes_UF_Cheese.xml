<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--___________________CheeseBasin_____________________-->
	<RecipeDef ParentName="GlitterpediaModExtBase" Name="Make_CheeseBase" Abstract="True">
		<fixedIngredientFilter>
			<thingDefs>
				<li>Milk</li>
				<li>SoyMilk</li>
			</thingDefs>
		</fixedIngredientFilter>
		<recipeUsers>
			<li>CheeseBasin</li>
		</recipeUsers>

		<!-- RecipeDef_UF fields -->
		<temperatureSafe>
			<min>0</min>
			<max>30</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>10</min>
			<max>25</max>
		</temperatureIdeal>
		<processDays>4</processDays>
		<speedBelowSafe>0.05</speedBelowSafe>
		<speedAboveSafe>0.5</speedAboveSafe>
		<sunFactor>
			<min>1</min>
			<max>1</max>
		</sunFactor>
		<rainFactor>
			<min>1</min>
			<max>0</max>
		</rainFactor>
		<snowFactor>
			<min>1</min>
			<max>0</max>
		</snowFactor>
		<windFactor>
			<min>1</min>
			<max>1</max>
		</windFactor>
		<graphicSuffix>_cheese</graphicSuffix>
	</RecipeDef>

	<RecipeDef ParentName="Make_CheeseBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Cheese</defName>
		<label>make cheese</label>
		<description>Make cheese. Takes 4 days to make</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Milk</li>
						<li>SoyMilk</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<products>
			<Cheese>5</Cheese>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="Make_CheeseBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Cheese_x5</defName>
		<label>make cheese x5</label>
