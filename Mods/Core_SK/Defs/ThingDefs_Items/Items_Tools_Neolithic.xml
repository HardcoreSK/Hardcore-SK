<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BaseTool">
        <defName>Tool_PrimitivePickaxe</defName>
        <label>primitive pickaxe</label>
        <description>You don't have to come up with something fancy and metallic to crush a stone — another stone can do it! How similar stones are to people... or rather not.\n\nAlso can be used as a hoe.</description>
        <graphicData>
            <texPath>Things/Tools/PrimitivePickaxe</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <techLevel>Neolithic</techLevel>
        <statBases>
            <Mass>4</Mass>
            <Bulk>6</Bulk>
            <MeleeCounterParryBonus>0.1</MeleeCounterParryBonus>
        </statBases>
        <equippedAngleOffset>25</equippedAngleOffset>
        <weaponTags>
            <li>Pickaxe</li>
        </weaponTags>
        <tools>
            <li Class="CombatExtended.ToolCE">
                <label>handle</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>2</power>
                <cooldownTime>2</cooldownTime>
                <armorPenetrationBlunt>3</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Handle</linkedBodyPartsGroup>
            </li>
            <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                    <li>Stab</li>
                </capacities>
                <power>9</power>
                <cooldownTime>3</cooldownTime>
                <chanceFactor>1.33</chanceFactor>
                <armorPenetrationBlunt>5</armorPenetrationBlunt>
                <armorPenetrationSharp>4</armorPenetrationSharp>
                <linkedBodyPartsGroup>Head</linkedBodyPartsGroup>
            </li>
        </tools>
        <thingCategories>
            <li>SurvivalToolsPrimitive</li>
        </thingCategories>
        <smeltable>False</smeltable>
        <recipeMaker IsNull="True" />
    </ThingDef>

