	<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>SilagePile</defName>
		<label>Silage Pile</label>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/SilagePile</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(0, 0, 0)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<fillPercent>0.01</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>2200</WorkToBuild>
			<MaxHitPoints>300</MaxHitPoints>
			<Flammability>0.0</Flammability>
			<Cleanliness>-12</Cleanliness>
		</statBases>
		<description>Huge pile where plant matter is fermented into silage.</description>
		<size>(4,4)</size>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
		</placeWorkers>
		<tickerType>Rare</tickerType>
		<rotatable>true</rotatable>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<designationCategory>Production</designationCategory>
        <terrainAffordanceNeeded>Diggable</terrainAffordanceNeeded>
		<!-- ThingDef_UF fields -->
		<showProductIcon>false</showProductIcon>
		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>30</slotsCount>
	</ThingDef>

