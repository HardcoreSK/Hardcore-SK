			<Mass>10</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-10</Cleanliness>
		</statBases>
		<stuffCategories>
			<li>StrongMetallic</li>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<ComponentMedieval>2</ComponentMedieval>
