		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>10</slotsCount>
	</ThingDef>

	<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>RockCrusher</defName>
		<label>Industrial Rock Crusher</label>
		<description>Industrial scale machine for automatically crushing rocks into sand or rubble.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/RockCrusher/RockCrusher_off</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType> 
			<drawSize>(5.5,5.5)</drawSize>
			<shadowData>
				<volume>(3.8, 5 , 3.8)</volume>
				<!-- Width, Length?,  Height -->
				<offset>(0,0,-0.10)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<FramePath>Things/Building/Production/RockCrusher/RockCrusher_anim</FramePath>
		<AnimationType>standart</AnimationType>
		<FrameCount>4</FrameCount>
		<multispeed>14</multispeed>
		<stuffCategories>
			<li>RuggedMetallic</li>
		</stuffCategories>
		<costStuffCount>350</costStuffCount>
		<costList>
			<ReinforcedConcrete>120</ReinforcedConcrete>
			<ComponentIndustrial>25</ComponentIndustrial>
			<Mechanism>15</Mechanism>
			<Electronics>2</Electronics>
		</costList>
		<statBases>
			<WorkToBuild>10000</WorkToBuild>
			<MaxHitPoints>800</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<rotatable>false</rotatable>
		<size>(5,4)</size>
		<fillPercent>0.7</fillPercent>
		<designationCategory>Production</designationCategory>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>false</shortCircuitInRain>
				<basePowerConsumption>2500</basePowerConsumption>
				<soundPowerOn>Power_OnSmall</soundPowerOn>
				<soundPowerOff>Power_OffSmall</soundPowerOff>
				<idlePowerDraw>250</idlePowerDraw>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<researchPrerequisites>
			<li>ResearchMobileMineralSonarEnhancedScan</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>14</constructionSkillPrerequisite>

		<!-- ThingDef_UF fields -->
		<showProductIcon>true</showProductIcon>
		<barOffset>(0.0, -0.8)</barOffset>
		<barScale>(1.2, 1.2)</barScale>
		<slotsCount>15</slotsCount>
	</ThingDef>

