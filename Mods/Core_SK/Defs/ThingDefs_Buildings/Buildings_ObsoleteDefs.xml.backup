	<ThingDef Class="SK.ThingDef_NPP" ParentName="PowerFueled">
    		<defName>NPP</defName>
    		<label>nuclear power plant</label>
    		<thingClass>SK.Building_NPP</thingClass>
    		<drawerType>MapMeshAndRealTime</drawerType>
    		<graphicData>
    			<texPath>Things/Building/Power/NPP/nuclearPP_off_fuel</texPath>
    			<graphicClass>Graphic_Single</graphicClass>
    			<drawSize>(6,6)</drawSize>
    			<shadowData>
    				<volume>(5.7, 2, 5.7)</volume>
    			</shadowData>
    		</graphicData>
    		<rotatable>false</rotatable>
    		<statBases>
    			<MaxHitPoints>2400</MaxHitPoints>
    			<WorkToBuild>21000</WorkToBuild>
    			<Flammability>0</Flammability>
    			<Beauty>-180</Beauty>
    		</statBases>
    		<description>A Nuclear Power Plant with 24,000 W max. power output. Requires a hopper with Enriched Uranium as a fuel source. WARNING: In case of a nuclear meltdown, build walls around the debris to contain the radiation!</description>
    		<size>(6,6)</size>
    		<building>
    			<soundAmbient>MatterFab</soundAmbient>
    		</building>
    		<costList>
    			<ReinforcedConcrete>600</ReinforcedConcrete>
    			<Rubber>150</Rubber>
    			<ComponentSpacer>30</ComponentSpacer>
    			<Microchips>8</Microchips>
    		</costList>
    		<comps>
    			<li Class="CompProperties_Flickable"/>
    			<li Class="CompProperties_Breakdownable"/>
    			<li Class="CompProperties_Power">
    				<compClass>SK.CompPowerPlantFueled</compClass>
    				<basePowerConsumption>-30000</basePowerConsumption>
    				<transmitsPower>true</transmitsPower>
    			</li>
    			<li Class="CompProperties_Explosive">
    				<compClass>SK.CompExplosiveNPP</compClass>
    				<explosiveRadius>1</explosiveRadius>
    				<explosiveDamageType>Bomb</explosiveDamageType>
    			</li>
    			<li Class="CompProperties_Explosive">
    				<explosiveRadius>12.9</explosiveRadius>
    				<explosiveDamageType>Bomb</explosiveDamageType>
    			</li>
    			<li Class="CompProperties_Glower">
    				<glowRadius>7</glowRadius>
    				<glowColor>(217,112,33,0)</glowColor>
    			</li>
    			<li Class="SK.CompProperties_HeatPusherAdvanced">
    				<compClass>CompHeatPusher</compClass>
    				<heatPerSecond>70</heatPerSecond>
    				<heatPushMaxTemperature>75</heatPushMaxTemperature>
    			</li>
    			<li Class="SK.CompFueled_Properties">
    				<operatingTemp>5000</operatingTemp>
    				<drawfirefuel>false</drawfirefuel>
    				<smokeDrawOffset>(1.3,-0.1,0.7)</smokeDrawOffset>
    				<smokesize>1.5</smokesize>
    				<smokespeeddelay>100</smokespeeddelay>
    				<fuelCapacity>20</fuelCapacity>
    				<fuelFilter>
    					<thingDefs>
    						<li>HEU</li>
    					</thingDefs>
    				</fuelFilter>
    			</li>
    		</comps>
    		<placeWorkers>
    			<li>PlaceWorker_NotUnderRoof</li>
    		</placeWorkers>
    		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    		<designationCategory>Power</designationCategory>
    		<researchPrerequisites>
    			<li>SK_NuclearII</li>
    		</researchPrerequisites>
    		<constructionSkillPrerequisite>16</constructionSkillPrerequisite>
    
    		<OverheatThreshold>1600</OverheatThreshold>
    		<DamageAppliedSelfMin>40</DamageAppliedSelfMin>
    		<DamageAppliedSelfMax>70</DamageAppliedSelfMax>
    		<DamageApplySelfCounter>600</DamageApplySelfCounter>
    	</ThingDef>
    
    	<ThingDef Class="SK.ThingDef_ItemRAD" ParentName="StandardBuilding">
    		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    		<constructEffect>ConstructMetal</constructEffect>
    		<defName>NPPD</defName>
    		<label>nuclear power plant debris</label>
    		<thingClass>SK.BuildingRAD</thingClass>
    		<graphicData>
    			<texPath>Things/Building/Power/NPP/nuclearPP_debris</texPath>
    			<graphicClass>Graphic_Single</graphicClass>
    			<drawSize>(6,6)</drawSize>
    			<shadowData>
    				<volume>(5.7, 2, 5.7)</volume>
    			</shadowData>
    		</graphicData>
    		<passability>Impassable</passability>
    		<fillPercent>1</fillPercent>
    		<useHitPoints>false</useHitPoints>
    		<destroyable>false</destroyable>
    		<statBases>
    			<Flammability>0</Flammability>
    			<Beauty>-720</Beauty>
    		</statBases>	
    		<tickerType>Normal</tickerType>
    		<canOverlapZones>false</canOverlapZones>
    		<description>Radioactive debris of a Nuclear Power Plant. Build walls around it to contain the radiation!</description>
    		<size>(6,6)</size>
    		<specialDisplayRadius>40</specialDisplayRadius>
    		<comps>
    			<li Class="CompProperties_Glower">
    				<glowRadius>20</glowRadius>
    				<glowColor>(5,30,5,5)</glowColor>
    			</li>		 
    		</comps>
    		
    		<DamageAppliedSeverityMin>0.01</DamageAppliedSeverityMin>
    		<DamageAppliedSeverityMax>0.04</DamageAppliedSeverityMax>
    		<ThingDamageAppliedMin>-5</ThingDamageAppliedMin>
    		<ThingDamageAppliedMax>2</ThingDamageAppliedMax>
    		<terrainradfrequency>5</terrainradfrequency>
    		<radfrequency>500</radfrequency>
    		<radiationRadius>20</radiationRadius>
    	</ThingDef>
    	
    		<ThingDef ParentName="BuildingBase">
        		<defName>TidalGenerator</defName>
            <thingClass>BiomeOcean.Building_TidalGenerator</thingClass>
        		<label>Hydro power plant</label>
        		<description>Tidal generator.</description>
            <graphicData>
              <texPath>Things/Building/Power/TidalGen/TidalGeneratory</texPath>
              <graphicClass>Graphic_Multi</graphicClass>
              <drawSize>(3,6)</drawSize>
              <damageData>
                <rect>(2,0.15,1,1.4)</rect>
              </damageData>
            </graphicData>
            <altitudeLayer>Floor</altitudeLayer>
        		<passability>Impassable</passability>
        		<fillPercent>0.5</fillPercent>
        		<statBases>
        			<MaxHitPoints>150</MaxHitPoints>
        			<WorkToBuild>2400</WorkToBuild>
        			<Flammability>0.4</Flammability>
        			<Beauty>-12</Beauty>
        		</statBases>
        		<tickerType>Normal</tickerType>
        		<size>(3,6)</size>
        		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
        		<rotatable>true</rotatable>
        		<designationCategory>Power</designationCategory>
        		<stuffCategories>
        		<li>StrongMetallic</li>
        		</stuffCategories>
            	<costStuffCount>320</costStuffCount>
        		<costList>
        		<ReinforcedConcrete>80</ReinforcedConcrete>
        		<Rubber>60</Rubber>
        		<ComponentIndustrial>10</ComponentIndustrial>
        		<Mechanism>10</Mechanism>
        		</costList>
            <placeWorkers>
              <li>BiomeOcean.PlaceWorker_TidalGenerator</li>
            </placeWorkers>
        	<comps>
        			<li Class="CompProperties_Power">
        				<compClass>CompPowerTrader</compClass>
        				<basePowerConsumption>-400</basePowerConsumption>
        				<transmitsPower>true</transmitsPower>
              </li>
              <li Class="CompProperties_Breakdownable"/>
        	</comps>
        	<researchPrerequisites><li>SolarPanels</li></researchPrerequisites>
        	<terrainAffordanceNeeded>Undefined</terrainAffordanceNeeded>
        	</ThingDef>
        
        	<ThingDef ParentName="PowerFueled">
        		<defName>BioGenerator</defName>
        		<label>bio-generator</label>
        		<thingClass>SK.Building_BioGenerator</thingClass>
        		<drawerType>MapMeshAndRealTime</drawerType>
        		<graphicData>
        			<texPath>Things/Building/Power/BioGenerator/BioGenerator</texPath>
        			<graphicClass>Graphic_Single</graphicClass>
        			<drawSize>(2,2)</drawSize>
        			<shadowData>
        				<volume>(1.8, 0.8, 1.8)</volume>
        				<offset>(0,0,0)</offset>
        			</shadowData>
        		</graphicData>
        		<passability>Impassable</passability>
        		<fillPercent>0.85</fillPercent>
        		<minifiedDef>MinifiedThing</minifiedDef>
        		<thingCategories>
        			<li>BuildingsPower</li>
        		</thingCategories>
        		<statBases>
        			<MaxHitPoints>330</MaxHitPoints>
        			<WorkToBuild>3600</WorkToBuild>
        			<Flammability>1.0</Flammability>
        			<Mass>500</Mass>
        		</statBases>
        		<tickerType>Normal</tickerType>
        		<description>A bio-generator that produces electricity. Requires Biodiesel for a fuel source.\nMax. power output: 1,200 W.</description>
        		<size>(2,2)</size>
        		<stuffCategories>
        			<li>RuggedMetallic</li>
        		</stuffCategories>
        		<costStuffCount>80</costStuffCount>
        		<costList>
        			<Glass>40</Glass>
        			<ComponentIndustrial>8</ComponentIndustrial>
        			<Mechanism>3</Mechanism>
        		</costList>
        		<building>
        			<uninstallWork>1450</uninstallWork>
        			<destroySound>BuildingDestroyed_Metal_Medium</destroySound>
        		</building>
        		<comps>
        			<li Class="CompProperties_Flickable"/>
        			<li Class="CompProperties_Breakdownable"/>
        			<li Class="CompProperties_Power">
        				<compClass>SK.CompPowerPlantFueled</compClass>
        				<basePowerConsumption>-1200</basePowerConsumption>
        				<transmitsPower>true</transmitsPower>
        				<soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
        			</li>
        			<li Class="SK.CompProperties_HeatPusherAdvanced">
        				<compClass>SK.CompHeatPusherAdvanced</compClass>
        				<heatPerSecond>15</heatPerSecond>
        				<heatPushMaxTemperature>75</heatPushMaxTemperature>
        			</li>
        			<li Class="CompProperties_Glower">
        				<glowRadius>3</glowRadius>
        				<glowColor>(217,112,33,0)</glowColor>
        			</li>
        			<li Class="SK.CompFueled_Properties">
        				<operatingTemp>1200</operatingTemp>
        				<drawfirefuel>false</drawfirefuel>
        				<smokeDrawOffset>(0,0,0.1)</smokeDrawOffset>
        				<smokesize>1.7</smokesize>
        				<smokespeeddelay>100</smokespeeddelay>
        				<fuelCapacity>40</fuelCapacity>
        				<burnFuelMultiplier>0.7</burnFuelMultiplier>
        				<smokeDensity>2</smokeDensity>
        				<fuelFilter>
        					<thingDefs>
        						<li>FSX</li>
        						<li>BioDiesel</li>
        					</thingDefs>
        				</fuelFilter>
        			</li>
        		</comps>
        		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        		<designationCategory>Power</designationCategory>
        		<researchPrerequisites>
        			<li>Electricity</li>
        		</researchPrerequisites>
        		<constructionSkillPrerequisite>13</constructionSkillPrerequisite>
        		<modExtensions>
        			<li Class="SK.Events.AccidentalExplosionExtension">
        			</li>
        		</modExtensions>
        	</ThingDef>
    	
</Defs>
