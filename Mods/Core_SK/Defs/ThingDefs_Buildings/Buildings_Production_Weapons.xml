<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="SK_WorkTable">
        <defName>WeaponCraftingWorkTable</defName>
        <label>weapon crafting workbench</label>
        <description>A workbench that produces ranged weapons like pistols and rifles. Can smelt weapons down into metal. Requires power.</description>
        <graphicData>
            <texPath>Things/Building/Production/WeaponCraftingTable/WeaponCraftingTable</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3,3)</drawSize>
            <shadowData>
                <volume>(2.7, 1.0, 0.85)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <stuffCategories>
            <li>RuggedMetallic</li>
            <li>Woody</li>
        </stuffCategories>
        <costStuffCount>140</costStuffCount>
        <costList>
            <ComponentIndustrial>15</ComponentIndustrial>
            <ElectronicComponents>6</ElectronicComponents>
            <Mechanism>6</Mechanism>
        </costList>
        <minifiedDef>MinifiedThing</minifiedDef>
        <statBases>
            <WorkToBuild>4000</WorkToBuild>
            <MaxHitPoints>210</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>-8</Cleanliness>
            <Mass>500</Mass>
        </statBases>
        <size>(3,1)</size>
        <designationCategory>Production</designationCategory>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Small_ToolCabinet</li>
                    <li>PodChair</li>
                </linkableFacilities>
            </li>
            <li Class="SK.CompProperties_IdlePower">
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>500</basePowerConsumption>
                <soundPowerOn>Power_OnSmall</soundPowerOn>
                <soundPowerOff>Power_OffSmall</soundPowerOff>
                <idlePowerDraw>50</idlePowerDraw>
            </li>
        </comps>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <building>
            <uninstallWork>1450</uninstallWork>
        </building>
        <researchPrerequisites>
            <li>Machining</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    </ThingDef>

