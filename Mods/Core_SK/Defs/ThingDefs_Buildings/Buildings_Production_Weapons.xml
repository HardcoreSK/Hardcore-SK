    <ThingDef ParentName="SK_WorkTable">
        <defName>TableHeavyAmmunition</defName>
        <label>heavy ammunition bench</label>
        <thingClass>Building_WorkTable</thingClass>
        <description>A workstation for handloading ammo.</description>
        <graphicData>
            <texPath>Things/Building/Production/TableHeavyAmmunition/TableHeavyAmmunition</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3,3)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <statBases>
            <WorkToBuild>6500</WorkToBuild>
            <MaxHitPoints>300</MaxHitPoints>
            <Flammability>0.5</Flammability>
            <Cleanliness>-10</Cleanliness>
            <Mass>500</Mass>
        </statBases>
        <stuffCategories>
            <li>RuggedMetallic</li>
        </stuffCategories>
        <costStuffCount>210</costStuffCount>
        <costList>
            <ComponentIndustrial>10</ComponentIndustrial>
            <ElectronicComponents>5</ElectronicComponents>
            <Mechanism>10</Mechanism>
        </costList>
        <inspectorTabs Inherit="False">
            <li>ITab_Bills</li>
        </inspectorTabs>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <size>(3,1)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>70</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <comps>
            <li Class="SK.CompProperties_IdlePower">
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>500</basePowerConsumption>
                <idlePowerDraw>50</idlePowerDraw>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
        </comps>
        <building>
            <paintable>true</paintable>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
            <forceShowRoomStats>true</forceShowRoomStats>
        </building>
        <researchPrerequisites>
            <li>Grenade_C1</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
        </placeWorkers>
        <recipes>
            <li>MakeSulfur</li>
            <li>MakePowder</li>
            <li>MakeNapalm</li>
        </recipes>
        <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    </ThingDef>

