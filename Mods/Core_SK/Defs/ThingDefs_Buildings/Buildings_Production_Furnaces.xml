<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--
    DefOverwrite list:
    ElectricSmelter
    -->

	<ThingDef ParentName="SK_WorkTableFueled">
		<defName>TableFurnace</defName>
		<label>furnace</label>
		<description>A furnace used for smelting basic metal ores into metal alloys. Can make metal cans and produce charcoal from logs. Can be fueled by Kindling, Coal, Charcoal, Peat and wooden stuff.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/Furnace/Furnace</texPath>
			<shaderType>CutoutComplex</shaderType>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(2.3, 2.6, 2.3)</volume>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Production/Furnace/Furnace_north</uiIconPath>
		<stuffCategories>
			<li>Stony</li>
			<li>Bricks</li>
		</stuffCategories>
		<costStuffCount>240</costStuffCount>
		<statBases>
			<WorkToBuild>3000</WorkToBuild>
			<MaxHitPoints>280</MaxHitPoints>
			<Flammability>0</Flammability>
			<Cleanliness>-8</Cleanliness>
            <OutdoorWorkRateFactor>1.0</OutdoorWorkRateFactor>
			<Mass>1000</Mass>
		</statBases>
		<pathCost>90</pathCost>
		<size>(3,3)</size>
		<designationCategory>Production</designationCategory>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<fillPercent>0.7</fillPercent>
		<tickerType>Normal</tickerType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<recipes>
			<li>MakeCharcoal_Hand</li>
			<li>MakeTinBars_Hand</li>
			<li>MakeCopperBars_Hand</li>
			<li>MakeBronze_Hand</li>
			<li>MakeSteelBars_Hand</li>
			<li>MakeLeadBars_Hand</li>
			<li>MakeGoldBars_Hand</li>
			<li>MakeSilverBars_Hand</li>
			<li>MakeGlassBatch</li>
			<li>MakeGlass</li>
		</recipes>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="SK.CompProperties_HeatPusherAdvanced">
				<compClass>SK.CompHeatPusherAdvanced</compClass>
				<heatPerSecond>25</heatPerSecond>
				<heatPushMaxTemperature>27</heatPushMaxTemperature>
			</li>
			<li Class="SK.CompFueled_Properties">
				<operatingTemp>500</operatingTemp>
				<fireDrawOffset>(0.52,0.1,-0.55)</fireDrawOffset>
				<smokeDrawOffset>(0.5,-0.1,1.5)</smokeDrawOffset>
				<fuelDrawOffset>(0,0.1,-0.8)</fuelDrawOffset>
				<fuelCapacity>40</fuelCapacity>
				<burnFuelMultiplier>0.6</burnFuelMultiplier>
				<effectOnWeather>false</effectOnWeather>
				<smokeDensity>1</smokeDensity>
				<fuelFilter>
					<thingDefs>
						<li>Coal</li>
						<li>Charcoal</li>
						<li>Peat</li>
						<li>Kindling</li>
					</thingDefs>
					<categories>
						<li>Wooden</li>
					</categories>
				</fuelFilter>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
        <building>
            <workTableRoomRole IsNull="True" />
            <workTableNotInRoomRoleFactor IsNull="True" />
        </building>
		<researchPrerequisites>
			<li>Craft_B1</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>

	<ThingDef ParentName="SK_WorkTableFueled">
		<defName>Kiln</defName>
		<label>kiln</label>
		<description>An improvised kiln used to produce clay bricks, burning apparel and used as crematorium. Can be fueled by Kindling, Coal, Charcoal, Peat and wooden stuff. After researching chemistry it allow to make rubber from raw caoutchouc.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/Kiln/Kiln</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(2.3, 2.6, 2.3)</volume>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Production/Kiln/Kiln_north</uiIconPath>
		<stuffCategories>
			<li>Stony</li>
			<li>Bricks</li>
		</stuffCategories>
		<costStuffCount>180</costStuffCount>
		<statBases>
			<WorkToBuild>3000</WorkToBuild>
			<MaxHitPoints>270</MaxHitPoints>
			<Flammability>0</Flammability>
			<Cleanliness>-8</Cleanliness>
			<Mass>500</Mass>
            <OutdoorWorkRateFactor>1.0</OutdoorWorkRateFactor>
		</statBases>
		<pathCost>90</pathCost>
		<size>(3,3)</size>
		<fillPercent>0.9</fillPercent>
		<designationCategory>Production</designationCategory>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<tickerType>Normal</tickerType>
		<recipes>
			<li>SmeltWeapon</li>
			<li>MakeCharcoal_Hand</li>
			<li>CremateCorpse</li>
			<li>BurnApparel</li>
			<li>BurnDrugs</li>
			<li>BurnWeapon</li>
			<li>BurnThings</li>
			<li>VulcanizeRubber</li>
		</recipes>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
            <workTableNotInRoomRoleFactor>1.0</workTableNotInRoomRoleFactor>
			<uninstallWork>1850</uninstallWork>
		</building>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="SK.CompProperties_HeatPusherAdvanced">
				<compClass>SK.CompHeatPusherAdvanced</compClass>
				<heatPerSecond>20</heatPerSecond>
				<heatPushMaxTemperature>25</heatPushMaxTemperature>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="SK.CompFueled_Properties">
				<operatingTemp>500</operatingTemp>
				<drawfirefuel>false</drawfirefuel>
				<fireDrawOffset>(0,0.1,-0.65)</fireDrawOffset>
				<smokeDrawOffset>(0.5,-0.1,1.5)</smokeDrawOffset>
				<fuelDrawOffset>(0,0.1,-0.8)</fuelDrawOffset>
				<fuelCapacity>30</fuelCapacity>
				<burnFuelMultiplier>0.6</burnFuelMultiplier>
				<effectOnWeather>false</effectOnWeather>
				<smokeDensity>2</smokeDensity>
				<fuelFilter>
					<thingDefs>
						<li>Coal</li>
						<li>Charcoal</li>
						<li>Peat</li>
						<li>Kindling</li>
					</thingDefs>
					<categories>
						<li>Wooden</li>
					</categories>
				</fuelFilter>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>Craft_B1</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
	</ThingDef>

	<ThingDef Class="SK.ThingDef_AnimatedWorktable" ParentName="SK_WorkTable">
		<defName>EAF</defName>
		<label>electric arc furnace</label>
		<thingClass>SK.Building_AnimatedWorktable</thingClass>
		<description>An electric arc furnace for advanced metal alloy smelting. Efficient, but requires a lot of power.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/EAF/EAF_off</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(2.7, 1.0, 2.7)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>

		<FramePath>Things/Building/Production/EAF/EAF_anim</FramePath>
		<AnimationType>standart</AnimationType>
		<FrameCount>6</FrameCount>
		<multispeed>5</multispeed>

		<stuffCategories>
			<li>RuggedMetallic</li>
		</stuffCategories>
		<costStuffCount>180</costStuffCount>
		<costList>
			<ReinforcedConcrete>50</ReinforcedConcrete>
			<ComponentIndustrial>15</ComponentIndustrial>
			<Mechanism>10</Mechanism>
			<ElectronicComponents>6</ElectronicComponents>
		</costList>
		<statBases>
			<WorkToBuild>4500</WorkToBuild>
			<MaxHitPoints>280</MaxHitPoints>
			<Flammability>0</Flammability>
			<Beauty>-60</Beauty>
			<Cleanliness>-7</Cleanliness>
            <OutdoorWorkRateFactor>1.0</OutdoorWorkRateFactor>
		</statBases>
		<size>(3,3)</size>
		<designationCategory>Production</designationCategory>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<recipes>
			<li>SmeltWeapon</li>
			<li>ProcessNickelOre</li>
			<li>ProcessCobalt</li>
			<li>ProcessForChromium</li>
			<li>ProcessTitanium</li>
			<li>ProcessTungsten</li>
			<li>MakeCupronickelAlloy</li>
			<li>MakeFerronickelAlloy</li>
			<li>MakeStelliteAlloy</li>
			<li>MakeAlnicoAlloy</li>
			<li>MakeFerrotitaniumAlloy</li>
			<li>MakeNitinolAlloy</li>
			<li>MakePobediteAlloy</li>
			<li>MakeDepletedUraniumAlloy</li>
			<li>ExtractMetalFromSlag</li>
			<li>SmeltOrDestroyThing</li>
		</recipes>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>false</shortCircuitInRain>
				<basePowerConsumption>2500</basePowerConsumption>
				<soundPowerOn>Power_OnSmall</soundPowerOn>
				<soundPowerOff>Power_OffSmall</soundPowerOff>
				<idlePowerDraw>250</idlePowerDraw>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>4</glowRadius>
				<glowColor>(217,112,33,0)</glowColor>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>

					<li>Small_ToolCabinet</li>
					<li>PodChair</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>25</heatPerSecond>
				<heatPushMaxTemperature>55</heatPushMaxTemperature>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
            <workTableNotInRoomRoleFactor>1.0</workTableNotInRoomRoleFactor>
			<heatPerTickWhileWorking>2</heatPerTickWhileWorking>
		</building>
		<researchPrerequisites>
			<li>Metals_C3</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
	</ThingDef>

</Defs>
