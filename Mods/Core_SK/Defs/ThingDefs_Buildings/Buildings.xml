	<ThingDef Name="ResearchBase" ParentName="StandardBuilding" Abstract="True">
		<canOverlapZones>false</canOverlapZones>
		<surfaceType>Item</surfaceType>
		<hasInteractionCell>true</hasInteractionCell>
		<statBases>
			<Bulk>200</Bulk>
			<Mass>200</Mass>
		</statBases>
		<comps>
			<li Class="CompProperties_ReportWorkSpeed">
				<workSpeedStat>ResearchSpeedFactor</workSpeedStat>
			</li>
		</comps>
		<thingCategories>
			<li>BuildingsFacilities</li>
		</thingCategories>
		<placeWorkers>
			<li>PlaceWorker_ReportWorkSpeedPenalties</li>
		</placeWorkers>
	</ThingDef>

	<ThingDef Name="JoyBase" ParentName="StandardBuilding" Abstract="True">
		<statBases>
			<Bulk>20</Bulk>
			<Mass>10</Mass>
		</statBases>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsJoy</li>
		</thingCategories>
		<building>
			<uninstallWork>800</uninstallWork>
		</building>
	</ThingDef>
    
