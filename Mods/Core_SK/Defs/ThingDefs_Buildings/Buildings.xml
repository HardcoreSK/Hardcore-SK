	<ThingDef Name="BenchBaseNoShadows" ParentName="BuildingBase" Abstract="True">
		<castEdgeShadows>false</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<building>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
		</building>
	</ThingDef>

	<ThingDef Name="SK_BenchBase" ParentName="BenchBaseNoShadows" Abstract="True">
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
	</ThingDef>

	<ThingDef Name="StandardBuilding" ParentName="BuildingBase" Abstract="True">
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>80</pathCost>
		<fillPercent>0.6</fillPercent>
		<useHitPoints>True</useHitPoints>
		<rotatable>true</rotatable>
	</ThingDef>

	<!-- Base Worktable -->

	<ThingDef Name="SK_WorkTable" ParentName="BenchBase" Abstract="True">
		<thingClass>SK.SK_Building_WorkTable</thingClass>
		<tickerType>Normal</tickerType>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<passability>PassThroughOnly</passability>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<useStuffTerrainAffordance>true</useStuffTerrainAffordance>
		<building>
		  <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
		</building>
	</ThingDef>

	<ThingDef Name="SK_WorkTableFueled" ParentName="SK_WorkTable" Abstract="True">
		<thingClass>SK.Building_WorkTable_HeatPushAdvanced</thingClass>
		<inspectorTabs>
			<li>SK.ITab_Fuel</li>
		</inspectorTabs>
	</ThingDef>

