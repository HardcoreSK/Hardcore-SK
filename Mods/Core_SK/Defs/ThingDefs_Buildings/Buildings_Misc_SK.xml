    <!-- Trading -->

	<ThingDef ParentName="BuildingBase">
		<defName>TradingSpot</defName>
		<label>trading spot</label>
		<description>Designates a spot where traders will stop when visiting your colony.</description>
		<thingClass>SK.TradingSpot</thingClass>
		<graphicData>
			<texPath>Things/Building/Misc/TradingPost/tradetent</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<drawRotated>false</drawRotated>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(2.7, 2.3, 2.7)</volume>
			</shadowData>
		</graphicData>
		<size>(3,3)</size>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>5500</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<stuffCategories>
			<li>Leathery</li>
		</stuffCategories>
		<costStuffCount>120</costStuffCount>
		<costList>
			<ComponentIndustrial>6</ComponentIndustrial>
		</costList>
		<designationCategory>Misc</designationCategory>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<passability>Standable</passability>
		<rotatable>false</rotatable>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="SK.CompProperties_RestrictedPlacement">
				<compClass>SK.CompRestrictedPlacement</compClass>
				<MaxCount>1</MaxCount>
			</li>
		</comps>
		<placeWorkers>
			<li>SK.PlaceWorker_RestrictedCount</li>
		</placeWorkers>
		<building>
			<sowTag>SupportPlantsOnly</sowTag>
			<canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
			<ai_chillDestination>false</ai_chillDestination>
			<wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
			<artificialForMeditationPurposes>false</artificialForMeditationPurposes>
		</building>
	</ThingDef>

	<ThingDef ParentName="StandardBuilding">
		<defName>Buildings_SubspaceBurstTransponder</defName>
		<label>subspace burst transponder</label>
		<description>Contacts Ships at a distance and guides them to your colony.</description>
		<thingClass>SK.Building_SubspaceBurstTransponder</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/ComUnitBase</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(2.8, 1.0, 2.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<rect>(0.02,0.25,2.96,2.85)</rect>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/ComUnit</uiIconPath>
		<passability>Impassable</passability>
		<fillPercent>0.8</fillPercent>
		<statBases>
			<WorkToBuild>12200</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>1.0</Flammability>
		</statBases>
		<building>
			<isMealSource>true</isMealSource>
			<wantsHopperAdjacent>true</wantsHopperAdjacent>
			<nutritionCostPerDispense>0.3</nutritionCostPerDispense>
			<soundDispense>DispensePaste</soundDispense>
		</building>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>2400</basePowerConsumption>
			</li>
		</comps>
		<size>(3,3)</size>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>110</costStuffCount>
		<costList>
			<Plastic>20</Plastic>
			<Glass>15</Glass>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Electronics>8</Electronics>
		</costList>
		<canOverlapZones>false</canOverlapZones>
		<socialPropernessMatters>true</socialPropernessMatters>
		<!-- <interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<hasInteractionCell>true</hasInteractionCell> -->
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Misc</designationCategory>
		<tickerType>Normal</tickerType>
		<researchPrerequisites>
			<li>Telecommunications_D1</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>14</constructionSkillPrerequisite>
	</ThingDef>

