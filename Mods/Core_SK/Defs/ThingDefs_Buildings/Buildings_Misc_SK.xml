			<Flammability>1.0</Flammability>
			<Bulk>45</Bulk>
			<Mass>25</Mass>
		</statBases>
		<size>(2,1)</size>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<BiosyntheticMaterial>6</BiosyntheticMaterial>
			<MagneticMaterial>4</MagneticMaterial>
			<AdvMechanism>3</AdvMechanism>
			<Microchips>1</Microchips>
		</costList>
		<designationCategory>Misc</designationCategory>
		<comps>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>280</basePowerConsumption>
				<idlePowerDraw>0</idlePowerDraw>
