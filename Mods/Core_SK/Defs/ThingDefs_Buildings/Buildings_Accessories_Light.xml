    <ThingDef ParentName="SK_LampBase">
        <defName>ClutterFloorLampA</defName>
        <label>floor lamp</label>
        <thingClass>SK.Building_Lamp</thingClass>
        <description>People need light to move and work at full speed. Requires 80 W.</description>
        <graphicData>
            <texPath>Things/Building/Furniture/Lights/FloorLamp</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.0,1.0)</drawSize>
            <drawRotated>true</drawRotated>
            <allowFlip>true</allowFlip>
        </graphicData>
        <uiIconPath>Things/Building/Furniture/Lights/FloorLamp_ui</uiIconPath>
        <fillPercent>0.2</fillPercent>
        <drawerType>RealtimeOnly</drawerType>
        <minifiedDef>MinifiedThing</minifiedDef>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
