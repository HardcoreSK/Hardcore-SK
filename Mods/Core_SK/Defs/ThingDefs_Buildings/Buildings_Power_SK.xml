	<ThingDef ParentName="StandardBuilding">
		<defName>FissionBattery</defName>
		<label>fission battery</label>
		<thingClass>SK.Building_Battery</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Power/FissionBattery</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,3)</drawSize>
			<shadowData>
				<volume>(0.8, 0.4, 1.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<building>
			<uninstallWork>450</uninstallWork>
		</building>
		<thingCategories>
			<li>BuildingsPower</li>
		</thingCategories>
		<fillPercent>0.7</fillPercent>
		<tickerType>Normal</tickerType>
		<statBases>
			<MaxHitPoints>240</MaxHitPoints>
			<WorkToBuild>6500</WorkToBuild>
			<Flammability>2.0</Flammability>
			<Beauty>-6</Beauty>
			<Mass>200</Mass>
		</statBases>
		<description>Stores electricity and recycles charge using fission processes. Slightly more efficient than standard batteries. Warning - charged batteries tend to explode when heated or wet. Holds up to 4,000 W.</description>
		<size>(1,2)</size>
		<stuffCategories>
			<li>HeavyMetallic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<BiosyntheticMaterial>5</BiosyntheticMaterial>
			<ComponentSpacer>3</ComponentSpacer>
			<MagneticMaterial>3</MagneticMaterial>
			<Microchips>1</Microchips>
		</costList>
		<comps>
			<li Class="CompProperties_Battery">
				<storedEnergyMax>4000</storedEnergyMax>
				<efficiency>0.7</efficiency>
				<shortCircuitInRain>true</shortCircuitInRain>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(0,162,255,0)</glowColor>
			</li>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3.9</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
			</li>
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_Stunnable">
				<useLargeEMPEffecter>true</useLargeEMPEffecter>
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Power</designationCategory>
		<researchPrerequisites>
			<li>Electrical_engineering_E1</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>15</constructionSkillPrerequisite>
	</ThingDef>

	<!-- Generators -->

	<ThingDef ParentName="StandardBuilding">
		<defName>AdvancedSolarGenerator</defName>
