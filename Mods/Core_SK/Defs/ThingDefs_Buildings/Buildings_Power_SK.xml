			<li>ITab_WindTurbineAutoCut</li>
		</inspectorTabs>
	</ThingDef>

	<ThingDef ParentName="PowerFueled">
		<defName>CoalPowerPlant</defName>
		<label>coal power plant</label>
		<thingClass>SK.Building_CoalPowerPlant</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Power/CoalPowerPlant/Coalpowerplant</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,2)</drawSize>
			<shadowData>
				<volume>(2.8, 0.8, 1.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.9</fillPercent>
