					<thingDefs>
						<li>Peat</li>
					</thingDefs>
				</fuelFilter>
			</li>
			<li Class="CompProperties_Stunnable">
				<useLargeEMPEffecter>true</useLargeEMPEffecter>
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
