	<ThingDef ParentName="StandardBuilding">
		<defName>ThermoelectricGenerator</defName>
		<label>thermoelectric generator</label>
		<thingClass>SK.Building_ThermoelectricGenerator</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Power/ThermoelectricGenerator/Thermoelectric_Generator</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1,1)</drawSize>
			<shadowData>
				<volume>(0.8, 0.4, 0.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<altitudeLayer>PawnUnused</altitudeLayer>
		<passability>Impassable</passability>
		<fillPercent>0.99</fillPercent>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>6000</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>-5</Beauty>
		</statBases>
		<tickerType>Rare</tickerType>
		<description>Produces electricity from differences in temperatures between two rooms. Should be placed in a wall. Example: At 1,600 C (2,912 F) difference, power output is 16,200 W at 600% efficiency. \n\nCan withstand up to 350 celsius and down to -150 celsius.\n\nCan be overestressed in extreme temperatures giving it a chance to be damaged or a slim chance to break down.</description>
		<size>(1,1)</size>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<costList>
			<Plastic>70</Plastic>
			<Rubber>60</Rubber>
			<ComponentSpacer>6</ComponentSpacer>
			<Microchips>4</Microchips>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerPlant</compClass>
				<basePowerConsumption>-1</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
				<soundAmbientProducingPower>GeothermalPlant_Ambience</soundAmbientProducingPower>
			</li>
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_Flickable" />
			<li Class="SK.CompProperties_RestrictedPlacement">
				<compClass>SK.CompRestrictedPlacement</compClass>
				<thingDefs>
					<li>Wall</li>
					<li>ClutterSilverWall</li>
					<li>ClutterUWallLight</li>
