	<!-- Conduits / Batteries -->

	<ThingDef ParentName="BuildingBase">
		<defName>HeavyPowerConduit</defName>
		<label>heavy power conduit</label>
		<description>A set of heavy electrical cables for moving power around. They are very strong and non-flammable.</description>
		<graphicData>
			<texPath>Things/Building/Linked/HeavyPowerConduit_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Transmitter</linkType>
			<linkFlags>
				<li>PowerConduit</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/HeavyPowerConduit_MenuIcon</uiIconPath>
		<building>
			<isPowerConduit>true</isPowerConduit>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>0</Beauty>
		</statBases>
		<noRightClickDraftAttack>true</noRightClickDraftAttack>
		<drawStyleCategory>Default1D</drawStyleCategory>
		<costList>
			<Wire>2</Wire>
			<Rubber>1</Rubber>
			<ReinforcedConcrete>1</ReinforcedConcrete>
			<Pipe>1</Pipe>
		</costList>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_Conduit</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<blockWind>false</blockWind>
		<neverMultiSelect>true</neverMultiSelect>
		<designationCategory>Power</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<researchPrerequisites>
			<li>Electrical_engineering_C2</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<modExtensions>
			<li Class="SK.Events.EarthquakeExtension">
				<immunityToDamage>true</immunityToDamage>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
