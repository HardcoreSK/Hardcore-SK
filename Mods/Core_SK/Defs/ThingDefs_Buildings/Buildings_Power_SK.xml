		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Power/Advanced_solarpanel/advSolarPanel_base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(3.8, 0.6, 3.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
