    <!--Pots-->

	<ThingDef ParentName="PlantGrowerBase">
		<defName>TuskPot</defName>
		<label>tusk pot</label>
		<graphicData>
			<texPath>Things/Building/Furniture/Pots/abstractflowerbed</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shadowData>
				<volume>(0.5, 0.2, 0.5)</volume>
			</shadowData>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
			<drawSize>(1.0,1.0)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<size>(1,1)</size>
		<fillPercent>0.20</fillPercent>
		<minifiedDef>MinifiedThing</minifiedDef>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>360</WorkToBuild>
			<Beauty>3</Beauty>
			<Bulk>15</Bulk>
			<Mass>5</Mass>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">3</StyleDominance>
		</statBases>
		<costList>
			<Fertilizer>5</Fertilizer>
		</costList>
		<stuffCategories>
			<li>Stony</li>
			<li>Ceramic</li>
		</stuffCategories>
		<costStuffCount>10</costStuffCount>	
		<description>Designed by the honorable Shinzhor of Shinzaram, this lovely horn offers a charming alternative to plant your flowers in.</description>
		<fertility>1.0</fertility>
		<building>
			<defaultPlantToGrow>Plant_Dandelion</defaultPlantToGrow>
			<uninstallWork>200</uninstallWork>
			<sowTag>Decorative</sowTag>
			<paintable>true</paintable>
		</building>
		<rotatable>false</rotatable>
		<constructionSkillPrerequisite>1</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>Accessory_A1</li>
		</researchPrerequisites>
	</ThingDef>

