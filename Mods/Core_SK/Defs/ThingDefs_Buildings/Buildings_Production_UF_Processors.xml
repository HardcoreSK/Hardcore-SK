    <ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>CharcoalPit</defName>
		<label>Charcoal Pit</label>
		<description>Since ancient times, the simplest way to produce charcoal was to simply bury wood in the ground, cover it with dirt, and set it on fire. Many centuries later, nothing has changed.</description>
		<uiIconPath>Things/Building/Production/CharcoalPit/CharcoalPit_closed</uiIconPath>
		<graphicData>
			<texPath>Things/Building/Production/CharcoalPit/CharcoalPit</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(0,0,0)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<costList>
			<Dirt>20</Dirt>
		</costList>
		<fillPercent>0.5</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>7500</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
			<Flammability>0.0</Flammability>
			<Beauty>-10</Beauty>
			<Cleanliness>-10</Cleanliness>
		</statBases>
		<size>(3,3)</size>
		<comps>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>21</heatPerSecond>
                <heatPushMaxTemperature>28</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(252,187,113,0)</glowColor>
            </li>
        </comps>
		<tickerType>Rare</tickerType>
		<rotatable>false</rotatable>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
		<designationCategory>Production</designationCategory>
        <terrainAffordanceNeeded>Diggable</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Craft_B1</li>
		</researchPrerequisites>
		<!-- ThingDef_UF fields -->
		<showProductIcon>false</showProductIcon>
		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>10</slotsCount>
	</ThingDef>

    <ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>CompostBarrel</defName>
		<label>compost barrel</label>
		<description>A compost barrel will convert 10 compost into 10 fertilizer.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/CompostBarrel</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(0.6, 0.7, 0.6)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<rect>(0.05,0.1,0.9,0.9)</rect>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<statBases>
			<WorkToBuild>1700</WorkToBuild>
			<Mass>10</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-10</Cleanliness>
		</statBases>
		<stuffCategories>
			<li>StrongMetallic</li>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<costList>
			<ComponentMedieval>2</ComponentMedieval>
		</costList>
		<rotatable>true</rotatable>
		<designationCategory>Production</designationCategory>
		<tickerType>Rare</tickerType>
		<building>
			<uninstallWork>150</uninstallWork>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<researchPrerequisites>
			<li>SewageSludgeComposting</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>3</constructionSkillPrerequisite>
		<!-- ThingDef_UF fields -->
		<showProductIcon>true</showProductIcon>
		<barOffset>(0.0, 0.25)</barOffset>
		<barScale>(1.0, 1.0)</barScale>
		<slotsCount>10</slotsCount>
	</ThingDef>
    
    <ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
        <defName>SulfurExtractor</defName>
        <label>sulfur extractor</label>
        <description>Need sulfur? Tired of wasting precious iron ore? No longer necessary. However, manual labor is still required to begin the resource extraction and processing. Built on a geyser.</description>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Building/Production/SulfulExtractor/SulfulExtractor</texPath>
			<graphicClass>SK.Graphic_SingleNoColor</graphicClass>
			<drawSize>(4,7)</drawSize>
			<drawRotated>false</drawRotated>
			<shadowData>
				<volume>(1.5, 2.0, 1.5)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
        </graphicData>
        <size>(2,2)</size>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
        <fillPercent>0.75</fillPercent>
        <statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>8000</WorkToBuild>
			<Flammability>1.0</Flammability>
            <WorkToBuild>800</WorkToBuild>
			<Beauty>-40</Beauty>
            <Cleanliness>-80</Cleanliness>
        </statBases>
        <stuffCategories>
            <li>RuggedMetallic</li>
        </stuffCategories>
		<costStuffCount>120</costStuffCount>
		<costList>
			<ComponentIndustrial>10</ComponentIndustrial>
			<Mechanism>5</Mechanism>
			<ReinforcedConcrete>10</ReinforcedConcrete>
		</costList>
        <comps>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
        <tickerType>Rare</tickerType>
        <rotatable>false</rotatable>
        <designationCategory>Production</designationCategory>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<placeWorkers>
			<li>PlaceWorker_OnSteamGeyser</li>
		</placeWorkers>
        
        <!-- ThingDef_UF fields -->
        <showProductIcon>false</showProductIcon>
        <barOffset>(0.0, -1.0)</barOffset>
        <barScale>(1.0, 1.0)</barScale>
        <slotsCount>1</slotsCount>
        <researchPrerequisites>
            <li>Mining_C1</li>
        </researchPrerequisites>
    </ThingDef>

	<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>RockCrusher</defName>
