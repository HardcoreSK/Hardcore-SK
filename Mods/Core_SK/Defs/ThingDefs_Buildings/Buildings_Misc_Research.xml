<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--
    DefOverwrite list:
    SimpleResearchBench
    HiTechResearchBench
    MultiAnalyzer
    -->

	<ThingDef ParentName="ResearchBase">
		<defName>PrimitiveResearchBench</defName>
		<label>primitive research table</label>
		<description>Study surrounding materials here to research new things.</description>
		<thingClass>Building_ResearchBench</thingClass>
		<graphicData>
			<texPath>Things/Building/Research/ancienttable</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,1)</drawSize>
			<shadowData>
				<volume>(2.8, 1.0, 0.85)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>1900</WorkToBuild>
			<Flammability>1.0</Flammability>
			<ResearchSpeedFactor>0.5</ResearchSpeedFactor>
		</statBases>
		<placeWorkers>
			<li>PlaceWorker_DrawLinesToBookcasesInRoom</li>
		</placeWorkers>
		<size>(3,1)</size>
		<stuffCategories>
			<li>Stony</li>
			<li>Bricks</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<minifiedDef>MinifiedThing</minifiedDef>
		<building>
			<uninstallWork>300</uninstallWork>
			<paintable>true</paintable>
		</building>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
				</linkableFacilities>
			</li>
		</comps>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>Misc</designationCategory>
		<constructionSkillPrerequisite>2</constructionSkillPrerequisite>
	</ThingDef>

	<!-- Facilities -->

	<ThingDef ParentName="MiscBuildingBase">
		<defName>CounterTopModular</defName>
		<label>laboratory counter</label>
		<description>A convenient countertop surface.</description>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>80</pathCost>
		<castEdgeShadows>true</castEdgeShadows>
		<fillPercent>0.4</fillPercent>
		<designationCategory/>
		<!-- removed -->
		<canOverlapZones>false</canOverlapZones>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>	
		<uiIconPath>Things/Building/Research/CounterIco</uiIconPath>	
		<graphicData>
			<texPath>Things/Building/Research/Counter_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom1</li>
			</linkFlags>
		</graphicData>	
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>450</WorkToMake>
			<Flammability>1.0</Flammability>
			<Beauty>2</Beauty>
			<Bulk>4</Bulk>
			<Mass>2</Mass>
		</statBases>
		<size>(1,1)</size>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>5</costStuffCount>
		<rotatable>false</rotatable>
		<drawStyleCategory>Default2D</drawStyleCategory>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
	</ThingDef>

	<ThingDef ParentName="FacilitiesBase">
		<defName>LabStation</defName>
		<label>laboratory station</label>
		<description>An auxillary research station for expanding laboratory operations. Requires power.</description>
		<thingClass>SK.Building_Lamp</thingClass>
		<tickerType>Rare</tickerType>
		<graphicData>
			<texPath>Things/Building/Research/station</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3,2.5)</drawSize>
			<shadowData>
				<volume>(2.8, 1.0, 0.8)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<costList>
			<Plastic>5</Plastic>
			<Glass>10</Glass>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Microchips>3</Microchips>
		</costList>
		<statBases>
			<WorkToMake>12000</WorkToMake>
			<MaxHitPoints>150</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<ResearchSpeedFactor>0.9</ResearchSpeedFactor>
			<Bulk>125</Bulk>
			<Mass>80</Mass> 
		</statBases>
		<size>(3,1)</size>
		<comps>
			<li Class="SK.CompProperties_IdlePower">
				<basePowerConsumption>850</basePowerConsumption>
				<idlePowerFactor>0.1</idlePowerFactor>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<ResearchSpeedFactor>0.20</ResearchSpeedFactor>
				</statOffsets>
				<maxSimultaneous>1</maxSimultaneous>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<designationCategory>Misc</designationCategory>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>Research_table_D2</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>16</constructionSkillPrerequisite>
	</ThingDef>

