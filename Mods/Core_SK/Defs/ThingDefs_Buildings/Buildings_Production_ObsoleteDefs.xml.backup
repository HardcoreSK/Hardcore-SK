<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!--
    <ThingDef ParentName="StandardBuilding">
        <defName>OilExtractor</defName>
        <label>oil extractor</label>
        <description>The oil extractor digs deep into the ground and extracts crude oil. Must be placed on an oil fissure created by a drilling rig. Requires power.</description>
        <thingClass>SK.Building_OilExtractor</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Building/Production/OilExtractor/Oil_pit</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <shadowData>
                <volume>(2.7, 1.0, 2.7)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <passability>Impassable</passability>
        <fillPercent>1</fillPercent>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-2)</interactionCellOffset>
        <statBases>
            <WorkToBuild>12500</WorkToBuild>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Beauty>-60</Beauty>
            <Cleanliness>-20</Cleanliness>
        </statBases>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>2500</basePowerConsumption>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>50</heatPerSecond>
                <heatPushMaxTemperature>1500</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_Flickable"/>
        </comps>
        <size>(3,3)</size>
        <stuffCategories>
            <li>StrongMetallic</li>
        </stuffCategories>
        <costStuffCount>140</costStuffCount>
        <costList>
            <ReinforcedConcrete>50</ReinforcedConcrete>
            <ComponentIndustrial>15</ComponentIndustrial>
            <Mechanism>8</Mechanism>
            <ElectronicComponents>8</ElectronicComponents>
        </costList>
        <placeWorkers>
            <li>SK.PlacementRestrictor_OnFissure</li>
        </placeWorkers>
        <killedLeavings>
            <ChunkSlagSteel>6</ChunkSlagSteel>
        </killedLeavings>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <designationCategory>Production</designationCategory>
        <researchPrerequisites>
            <li>DeepDrilling</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    </ThingDef>
    <ThingDef ParentName="BuildingNaturalBase">
        <category>Ethereal</category>
        <label>oil fissure</label>
        <defName>Fissure</defName>
        <thingClass>SK.Fissure</thingClass>
        <graphicData>
            <texPath>Terrain/Fissure</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>Transparent</shaderType>
        </graphicData>
        <altitudeLayer>Floor</altitudeLayer>
        <destroyable>true</destroyable>
        <useHitPoints>false</useHitPoints>
        <selectable>true</selectable>
        <description>A fissure that cuts deep into the earth. An oil extractor can extract crude oil from this.</description>
        <size>(1,1)</size>
        <neverOverlapFloors>true</neverOverlapFloors>
        <blockPlants>true</blockPlants>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_LifespanFissure">
                <lifespanTicks>3500000</lifespanTicks>
            </li>
        </comps>
    </ThingDef>
    <ThingDef ParentName="StandardBuilding">
        <defName>FissureGenerator</defName>
        <label>drilling rig</label>
        <description>A powerful machine designed to create a deep fissure. Must be placed on a Deposit of Crude Oil. Requires power.</description>
        <thingClass>SK.Building_FissureGenerator</thingClass>
        <graphicData>
            <texPath>Things/Building/Production/FissureGenerator/FissureGenerator</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <shadowData>
                <volume>(2.7, 1.0, 2.7)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <passability>PassThroughOnly</passability>
        <pathCost>90</pathCost>
        <fillPercent>1</fillPercent>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>12000</WorkToBuild>
            <Flammability>1.0</Flammability>
            <Beauty>-40</Beauty>
            <Cleanliness>-20</Cleanliness>
        </statBases>
        <tickerType>Normal</tickerType>
        <size>(3,3)</size>
        <stuffCategories>
            <li>StrongMetallic</li>
        </stuffCategories>
        <costStuffCount>150</costStuffCount>
        <costList>
            <ComponentIndustrial>12</ComponentIndustrial>
            <Mechanism>6</Mechanism>
            <ElectronicComponents>4</ElectronicComponents>
        </costList>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1800</basePowerConsumption>
            </li>
            <li Class="SK.CompProperties_RestrictedPlacement">
                <compClass>SK.CompRestrictedPlacement</compClass>
                <restrictedThing>
                    <li>Oilfield</li>
                </restrictedThing>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>100</heatPerSecond>
                <heatPushMaxTemperature>1500</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_Flickable"/>
        </comps>
        <killedLeavings>
            <ChunkSlagSteel>3</ChunkSlagSteel>
        </killedLeavings>
        <placeWorkers>
            <li>SK.PlaceWorker_OnlyOnThing</li>
        </placeWorkers>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <designationCategory>Production</designationCategory>
        <researchPrerequisites>
            <li>SK_MiningI</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    </ThingDef>
    <ThingDef ParentName="StandardBuilding">
        <defName>OilRefinery</defName>
        <label>Oil Refinery</label>
        <thingClass>SK.Building_OilRefinery</thingClass>
        <description>The glitterworld basic Oil Refinery is the first step in downstreaming crude oil into useable materials. Requires power.</description>
        <graphicData>
            <texPath>Things/Building/Production/OilRefinery</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(4,5)</drawSize>
            <shadowData>
                <volume>(3.5, 1.0, 4.7)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <stuffCategories>
            <li>StrongMetallic</li>
        </stuffCategories>
        <costStuffCount>210</costStuffCount>
        <costList>
            <ReinforcedConcrete>40</ReinforcedConcrete>
            <ComponentIndustrial>20</ComponentIndustrial>
            <ElectronicComponents>10</ElectronicComponents>
            <Mechanism>10</Mechanism>
        </costList>
        <fillPercent>1</fillPercent>
        <statBases>
            <Beauty>-60</Beauty>
            <WorkToBuild>7000</WorkToBuild>
            <MaxHitPoints>500</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Cleanliness>-10</Cleanliness>
        </statBases>
        <size>(4,5)</size>
        <designationCategory>Production</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>95</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,3)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <canOverlapZones>false</canOverlapZones>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>700</basePowerConsumption>
                <soundPowerOn>Power_OnSmall</soundPowerOn>
                <soundPowerOff>Power_OffSmall</soundPowerOff>
                <soundAmbientProducingPower>GeothermalPlant_Ambience</soundAmbientProducingPower>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>7</glowRadius>
                <glowColor>(217,217,208,0)</glowColor>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>25</heatPerSecond>
                <heatPushMaxTemperature>75</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>Small_ToolCabinet</li>
                </linkableFacilities>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_ReportWorkSpeed">
                <workSpeedStat>WorkTableWorkSpeedFactor</workSpeedStat>
            </li>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_ReportWorkSpeedPenalties</li>
        </placeWorkers>
        <building>
            <heatPerTickWhileWorking>0.7</heatPerTickWhileWorking>
            <wantsHopperAdjacent>true</wantsHopperAdjacent>
        </building>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <researchPrerequisites>
            <li>SK_Petrochemistry</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    </ThingDef>
    <ThingDef ParentName="HopperBase">
        <defName>OilFeeder</defName>
        <label>Oil Refinery Hopper</label>
        <description>Holds crude oil for the Oil Refinery. Must be placed adjacent to an Oil Refinery.</description>
        <graphicData>
            <texPath>Things/Building/Misc/hopper</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <statBases>
            <WorkToBuild>450</WorkToBuild>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Mass>30</Mass>
        </statBases>
        <stuffCategories>
            <li>StrongMetallic</li>
        </stuffCategories>
        <costStuffCount>20</costStuffCount>
        <costList>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <building>
            <fixedStorageSettings>
                <priority>Important</priority>
                <filter>
                    <thingDefs>
                        <li>CrudeOil</li>
                    </thingDefs>
                </filter>
            </fixedStorageSettings>
            <defaultStorageSettings>
                <priority>Important</priority>
                <filter>
                    <thingDefs>
                        <li>CrudeOil</li>
                    </thingDefs>
                </filter>
            </defaultStorageSettings>
        </building>
        <designationCategory>Production</designationCategory>
        <researchPrerequisites>
            <li>SK_Petrochemistry</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    </ThingDef>
    <ThingDef ParentName="BenchBase">
        <defName>BioRefinery</defName>
        <label>bio-refinery</label>
        <description>A machine for making biodiesel and silage.</description>
        <graphicData>
            <texPath>Things/Building/BioRefinery</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
            <shadowData>
                <volume>(1.8, 1.0, 1.8)</volume>
                <offset>(0,0,0)</offset>
            </shadowData>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <stuffCategories>
            <li>RuggedMetallic</li>
        </stuffCategories>
        <costStuffCount>65</costStuffCount>
        <costList>
            <Glass>25</Glass>
            <Rubber>40</Rubber>
            <ComponentIndustrial>6</ComponentIndustrial>
            <Mechanism>3</Mechanism>
        </costList>
        <tickerType>Normal</tickerType>
        <statBases>
            <WorkToBuild>5500</WorkToBuild>
            <MaxHitPoints>230</MaxHitPoints>
            <Flammability>1.0</Flammability>
        </statBases>
        <size>(2,2)</size>
        <designationCategory>Production</designationCategory>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <recipes>
            <li>MakeBioDiesel</li>
        </recipes>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>500</basePowerConsumption>
                <soundPowerOn>Power_OnSmall</soundPowerOn>
                <soundPowerOff>Power_OffSmall</soundPowerOff>
                <idlePowerDraw>50</idlePowerDraw>
            </li>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_Flickable"/>
        </comps>
        <researchPrerequisites>
            <li>Chemistry_C2</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
    </ThingDef>
    -->
</Defs>
