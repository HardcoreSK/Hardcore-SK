    <ArchitectSense.DesignationSubCategoryDef MayRequire="Dubwise.Rimefeller">
        <defName>SubCategory_Napalm</defName>
        <label>napalm</label>
        <description>Napalm, son. Nothing else in the world smells like that.\nI love the smell of napalm in the morning. You know, one time we had a hill bombed, for 12 hours. When it was all over, I walked up. We didn’t find one of 'em, not one stinkin' dink body. The smell, you know that gasoline smell, the whole hill. Smelled like… victory.\nSomeday this war’s gonna end…</description>
        <defNames>
            <li>NapalmBomb</li>
            <li>Filth_NapalmTrail</li>
            <li>SparkGrid</li>
        </defNames>
        <designationCategory>Security</designationCategory>
        <debug>false</debug>
		<order>30</order>
		<types>
			<li>Fortifications</li>
		</types>
    </ArchitectSense.DesignationSubCategoryDef>

