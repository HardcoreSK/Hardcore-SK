<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <ThingDef ParentName="BaseStreamlinedArrowProjectile">
        <defName>Projectile_ArchoArrow</defName>
        <label>strange explosive arrow</label>
        <graphicData>
            <texPath>Things/Projectile/Arrows/Arrow_Flame</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <damageAmountBase>50</damageAmountBase>
            <armorPenetrationSharp>25</armorPenetrationSharp>
            <armorPenetrationBlunt>25</armorPenetrationBlunt>
            <dropsCasings>false</dropsCasings>
            <preExplosionSpawnChance>0</preExplosionSpawnChance>
            <secondaryDamage>
                <li>
                    <def>Bomb_Secondary</def>
                    <amount>30</amount>
                </li>
            </secondaryDamage>
        </projectile>
    </ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SK_BaseBullet">
		<defName>Bullet_ArchoBlaster</defName>
		<label>unknown blaster bolt</label>
		<graphicData>
			<texPath>Things/Building/Security/PrecisionShell</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Optic</damageDef>
			<damageAmountBase>30</damageAmountBase>
            <dropsCasings>false</dropsCasings>
			<speed>300</speed>
			<secondaryDamage>
				<li>
					<def>EMP</def>
					<amount>15</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SK_BaseBullet">
		<defName>Bullet_ArchoSMG</defName>
		<label>strange bullet</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>25</damageAmountBase>
            <dropsCasings>false</dropsCasings>
			<speed>200</speed>
            <armorPenetrationSharp>30</armorPenetrationSharp>
            <armorPenetrationBlunt>30</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SK_BaseBullet">
		<defName>Projectile_ArchoSword</defName>
		<label>sword projected cut</label>
		<graphicData>
			<texPath>Things/Projectile/Archosword</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>KineticPulse</damageDef>
			<damageAmountBase>70</damageAmountBase>
            <dropsCasings>false</dropsCasings>
			<speed>15</speed>
            <armorPenetrationSharp>60</armorPenetrationSharp>
            <armorPenetrationBlunt>25</armorPenetrationBlunt>
		</projectile>
	</ThingDef>
</Defs>