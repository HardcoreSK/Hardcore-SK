	<!--___________________Saltpeter_pit_____________________-->
	<RecipeDef ParentName="GlitterpediaModExtBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_Nitre_Body</defName>
		<label>Extracts nitre from body</label>
		<description>Extract nitre from corpse. Takes 10 days to make</description>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Corpses</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Ash</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>Corpses</li>
			</categories>
			<thingDefs>
				<li>Ash</li>
			</thingDefs>
			<disallowedCategories>
				<li>CorpsesMechanoid</li>
			</disallowedCategories>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<categories>
				<li>CorpsesHumanlike</li>
				<li>CorpsesAnimal</li>
			</categories>
			<thingDefs>
				<li>Ash</li>
			</thingDefs>
			<specialFiltersToDisallow>
				<li>AllowCorpsesColonist</li>
			</specialFiltersToDisallow>
		</defaultIngredientFilter>
		<products>
			<Nitre>30</Nitre>
		</products>
		<recipeUsers>
			<li>Saltpeter_pit</li>
		</recipeUsers>

		<!-- RecipeDef_UF fields -->
		<temperatureSafe>
			<min>5</min>
			<max>35</max>
		</temperatureSafe>
		<temperatureIdeal>
			<min>10</min>
			<max>30</max>
		</temperatureIdeal>
		<ruinedPerDegreePerHour>0</ruinedPerDegreePerHour>
		<scaleToMeatAmount>true</scaleToMeatAmount>
		<scaleToMeatAmountBase>127</scaleToMeatAmountBase>
		<processDays>10</processDays>
		<speedBelowSafe>0.05</speedBelowSafe>
		<speedAboveSafe>0.8</speedAboveSafe>
		<graphicSuffix>_closed</graphicSuffix>
	</RecipeDef>

