<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <RecipeDef>
        <defName>ScrapProsthesis</defName>
        <label>disassemble prosthesis</label>
        <description>Scrap and disassemble unwanted prosthesis for materials.</description>
        <jobString>Disassembling prosthesis.</jobString>
        <workAmount>400</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>EPOEAssembling</soundWorking>
        <recipeUsers>
            <li>TablePrimitiveProsthetic</li>
            <li>TableBasicProsthetic</li>
            <li>TableBionics</li>
            <li>TableSynthetics</li>
            <li>TableRecycling</li>
            <li>UpgradingStation</li>
        </recipeUsers>
        <specialProducts>
            <li>Smelted</li>
        </specialProducts>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>BasicProstheses</li>
                        <li>SimpleProstheses</li>
                        <li>OrganicOptimizer</li>
                        <li>SyntheticOrgans</li>
                        <li>BodyPartsBionic</li>
                        <li>BodyPartsUltra</li>
                        <li>CyberneticProstheses</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>BasicProstheses</li>
                <li>SimpleProstheses</li>
                <li>OrganicOptimizer</li>
                <li>SyntheticOrgans</li>
                <li>BodyPartsBionic</li>
                <li>BodyPartsUltra</li>
                <li>CyberneticProstheses</li>
            </categories>
        </fixedIngredientFilter>
        <defaultIngredientFilter>
            <categories>
                <li>BasicProstheses</li>
                <li>SimpleProstheses</li>
            </categories>
        </defaultIngredientFilter>
        <researchPrerequisite>Prosthesis_making_B1</researchPrerequisite>
    </RecipeDef>
    
    <RecipeDef>
        <defName>DissasembleFirearms</defName>
        <label>disassemble firearms</label>
        <description>Scrap and disassemble unwanted firearms for materials.</description>
        <jobString>Scraping metal from weapon.</jobString>
        <workAmount>750</workAmount>
        <workSpeedStat>SmeltingSpeed</workSpeedStat>
        <effectWorking>Smelt</effectWorking>
        <soundWorking>Recipe_Smelt</soundWorking>
        <specialProducts>
            <li>Smelted</li>
        </specialProducts>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>WeaponsRanged</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>WeaponsRanged</li>
            </categories>
            <specialFiltersToDisallow>
                <li>AllowNonSmeltableWeapons</li>
            </specialFiltersToDisallow>
            <disallowedCategories>
                <li>BowRanged</li>
                <li>CrossbarRanged</li>
                <li>ThrownRanged</li>
            </disallowedCategories>
        </fixedIngredientFilter>
        <forceHiddenSpecialFilters>
            <li>AllowSmeltable</li>
            <li>AllowBurnableWeapons</li>
            <li>AllowNonBurnableWeapons</li>
        </forceHiddenSpecialFilters>
        <skillRequirements>
            <Crafting>6</Crafting>
        </skillRequirements>
        <workSkill>Crafting</workSkill>
        <workSkillLearnFactor>0.8</workSkillLearnFactor>
        <researchPrerequisite>Machining</researchPrerequisite>
        <defaultIngredientFilter>
            <specialFiltersToDisallow MayRequire="xeonovadan.rimworldfavourites">
                <li>RimworldFavourites_AllowFavourited</li>
            </specialFiltersToDisallow>
            <categories>
                <li>WeaponsRanged</li>
            </categories>
        </defaultIngredientFilter>
    </RecipeDef>

</Defs>