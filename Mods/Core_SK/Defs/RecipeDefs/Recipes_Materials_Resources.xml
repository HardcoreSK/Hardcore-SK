    <RecipeDef>
        <defName>MakeReinforcedConcrete_Hand</defName>
        <label>create reinforced concrete</label>
        <description>Create reinforced concrete from concrete and metal. Quite slow. Produces 8.</description>
        <jobString>Creating reinforced concrete.</jobString>
        <workAmount>1600</workAmount>
        <workSpeedStat>StonecuttingSpeed</workSpeedStat>
        <effectWorking>CutStone</effectWorking>
        <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
        <recipeUsers>
            <li>ConcreteMixer</li>
        </recipeUsers>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Metallic</li>
                    </categories>
                </filter>
                <count>10</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>ConcreteResource</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>SLDBar</li>
                <li>USLDBar</li>
            </categories>
            <thingDefs>
                <li>ConcreteResource</li>
            </thingDefs>
        </fixedIngredientFilter>
        <defaultIngredientFilter>
            <thingDefs>
                <li>Bronze</li>
                <li>Steel</li>
                <li>ConcreteResource</li>
            </thingDefs>
            <disallowedThingDefs>
                <li>FerrosiliconAlloy</li>
                <li>CupronickelAlloy</li>
            </disallowedThingDefs>
            <disallowedCategories>
                <li>USLDBar</li>
            </disallowedCategories>
        </defaultIngredientFilter>
        <products>
            <ReinforcedConcrete>8</ReinforcedConcrete>
        </products>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
        <workSkill>Crafting</workSkill>
        <workSkillLearnFactor>0.8</workSkillLearnFactor>
        <researchPrerequisite>Concrete_C1</researchPrerequisite>
    </RecipeDef>

