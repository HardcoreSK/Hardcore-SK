<Defs>

    <!-- Bow -->
    <ThingDef ParentName="RangedWeaponArchotechBase">
        <defName>Bow_Archotech</defName>
        <label>Archotech Frame A-1 «Bow»</label>
        <description>Bow of archotech origin. No one know why or how, but it is here. Endless explosive «arrows-like» projectiles, small autoaim, endless possibilities. Allows the wearer to shoot at night as if it were day.</description>
        <graphicData>
            <texPath>Things/Weapons/Archotech/ArchoBow</texPath>
            <graphicClass>SK.Graphic_SingleNoColor</graphicClass>
        </graphicData>
        <soundInteract>Bow_Recurve</soundInteract>
        <statBases>
            <MarketValue>30000</MarketValue>
            <WorkToMake>30000</WorkToMake>
            <SightsEfficiency>1.5</SightsEfficiency>
            <ShotSpread>0.2</ShotSpread>
            <SwayFactor>1</SwayFactor>
            <Bulk>5</Bulk>
            <Mass>1.0</Mass>
            <RangedWeapon_Cooldown>0.70</RangedWeapon_Cooldown>
            <Flammability>0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
            <NightVisionEfficiency_Weapon>1</NightVisionEfficiency_Weapon>
        </statBases>
        <stuffCategories>
            <li>RareMetallic</li>
        </stuffCategories>
        <costStuffCount>100</costStuffCount>
        <costList>
            <ArchiteCapsule MayRequire="Ludeon.RimWorld.Biotech">5</ArchiteCapsule>
            <ComponentUltra>8</ComponentUltra>
        </costList>
        <weaponTags>
            <li>CE_Bow</li>
        </weaponTags>
        <weaponClasses>
            <li>ShortShots</li>
        </weaponClasses>
        <useHitPoints>false</useHitPoints>
        <generateCommonality>0</generateCommonality>
        <deteriorateFromEnvironmentalEffects>false</deteriorateFromEnvironmentalEffects>
        <relicChance>0</relicChance>
        <tradeability>None</tradeability>
        <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
                <recoilPattern>Regular</recoilPattern>
                <recoilAmount>1</recoilAmount>
                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Projectile_ArchoArrow</defaultProjectile>
                <warmupTime>0.5</warmupTime>
                <burstShotCount>3</burstShotCount>
                <range>60</range>
                <soundCast>Bow_Recurve</soundCast>
            </li>
        </verbs>
        <comps>
            <li Class="CombatExtended.CompProperties_FireModes">
                <noSnapshot>True</noSnapshot>
            </li>
        </comps>
        <recipeMaker>
            <researchPrerequisite>Bow_Archotech</researchPrerequisite>
        </recipeMaker>
        <thingCategories>
            <li>ArchotechRanged</li>
        </thingCategories>
        <rotateInShelves>false</rotateInShelves>
        <thingSetMakerTags>
            <li>RewardStandardLowFreq</li>
        </thingSetMakerTags>
        <equippedStatOffsets>
            <Suppressability>-0.5</Suppressability>
        </equippedStatOffsets>
    </ThingDef>

