			</li>
		</comps>
		<stuffCategories>
			<li>RareMetallic</li>
		</stuffCategories>
		<costStuffCount>120</costStuffCount>
		<costList>
			<ArchiteCapsule MayRequire="Ludeon.RimWorld.Biotech">5</ArchiteCapsule>
			<Weapon_Parts>20</Weapon_Parts>
			<ComponentUltra>8</ComponentUltra>
		</costList>
		<recipeMaker>
			<researchPrerequisite>Blaster_weapons_Archotech</researchPrerequisite>
		</recipeMaker>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
		</thingSetMakerTags>
        <equippedStatOffsets>
            <Suppressability>-0.5</Suppressability>
        </equippedStatOffsets>
        <tools Inherit="False">
            <li Class="CombatExtended.ToolCE">
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>9</power>
                <cooldownTime>1.6</cooldownTime>
                <armorPenetrationBlunt>1.5</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
            </li>
            <li Class="CombatExtended.ToolCE">
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>11</power>
                <cooldownTime>1.7</cooldownTime>
                <armorPenetrationBlunt>1.75</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
            </li>
            <li Class="CombatExtended.ToolCE">
                <label>muzzle</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>10</power>
                <cooldownTime>1.4</cooldownTime>
                <armorPenetrationBlunt>1.35</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
            </li>
        </tools>
	</ThingDef>

