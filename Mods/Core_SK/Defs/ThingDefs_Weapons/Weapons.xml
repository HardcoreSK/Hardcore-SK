<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <!-- BASES -->

	<!-- Pilum-specific base (both ammo and weapon) -->
	<ThingDef ParentName="AmmoBase" Name="BaseWeaponAndAmmoNeolithic" Abstract="True">
		<equipmentType>Primary</equipmentType>
		<pathCost>10</pathCost>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
			<SellPriceFactor>0.70</SellPriceFactor>
		</statBases>
		<techLevel>Neolithic</techLevel>
		<!-- <menuHidden>false</menuHidden> -->
		<destroyOnDrop>False</destroyOnDrop>
		<weaponTags>
			<li>Neolithic</li>
		</weaponTags>
		<weaponClasses>
			<li>Neolithic</li>
		</weaponClasses>
		<thingCategories>
			<li>WeaponsRanged</li>
		</thingCategories>
		<comps>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
		</comps>
		<recipeMaker>
			<workSpeedStat>SmithingSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<recipeUsers>
				<li>ElectricSmithy</li>
				<li>FueledSmithy</li>
			</recipeUsers>
			<effectWorking>Smelt</effectWorking>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
		</recipeMaker>
	</ThingDef>

    <!--Bows-->

	<ThingDef Name="RangedWeaponBase" Abstract="True">
		<category>Item</category>
		<thingClass>ThingWithComps</thingClass>
		<equipmentType>Primary</equipmentType>
		<pathCost>10</pathCost>
		<useHitPoints>True</useHitPoints>
		<selectable>True</selectable>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<drawGUIOverlay>true</drawGUIOverlay>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>3</DeteriorationRate>
			<SellPriceFactor>0.70</SellPriceFactor>
		</statBases>
		<possessionCount>1</possessionCount>
		<generateCommonality>0.02</generateCommonality>
		<equippedStatOffsets>
			<Suppressability>-0.05</Suppressability>
		</equippedStatOffsets>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>True</alwaysHaulable>
		<tickerType>Never</tickerType>
		<techLevel>Neolithic</techLevel>
		<relicChance>0.5</relicChance>
		<weaponTags>
			<li>Ranged</li>
		</weaponTags>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<!--<id>limb</id>-->
				<label>limb</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>1.6</cooldownTime>
				<chanceFactor>0.5</chanceFactor>
				<armorPenetrationBlunt>0.80</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Base</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<!--<id>nock</id>-->
				<label>nock</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>1.6</cooldownTime>
				<chanceFactor>0.5</chanceFactor>
				<armorPenetrationBlunt>0.60</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
			</li>
		</tools>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompEquippable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponGun</nameMaker>
				<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
			<li Class="CompProperties_Styleable" />
		</comps>
	</ThingDef>
    
	<ThingDef Name="RangedWeaponNeolithicBase" ParentName="RangedWeaponBase" Abstract="True">
