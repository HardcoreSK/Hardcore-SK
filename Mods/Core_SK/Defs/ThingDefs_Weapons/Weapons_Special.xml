<?xml version="1.0" encoding="UTF-8"?>
<Defs>

    <ThingDef ParentName="BaseMeleeStun">
        <defName>MeleeWeapon_Shocker</defName>
        <label>Taser</label>
        <description>A shocker that can stun the victim.</description>
        <graphicData>
            <texPath>Things/Weapons/Special/StunGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <stuffCategories>
            <li>StrongMetallic</li>
        </stuffCategories>
        <costStuffCount>30</costStuffCount>
        <costList>
            <ComponentAdvanced>3</ComponentAdvanced>
            <Weapon_Parts>12</Weapon_Parts>
            <Electronics>5</Electronics>
            <Plastic>35</Plastic>
        </costList>
        <weaponTags>
            <li>HitechMelee</li>
            <li>CE_OneHandedWeapon</li>
        </weaponTags>
        <soundInteract>InteractMelee</soundInteract>
        <statBases>
            <WorkToMake>11500</WorkToMake>
            <Flammability>1</Flammability>
            <Bulk>1.20</Bulk>
            <Mass>1.10</Mass>
            <MeleeCounterParryBonus>1.2</MeleeCounterParryBonus>
        </statBases>
        <equippedStatOffsets>
            <MeleeDodgeChance>0.4</MeleeDodgeChance>
            <MeleeParryChance>0.15</MeleeParryChance>
        </equippedStatOffsets>
        <equippedAngleOffset>-65</equippedAngleOffset>
        <tools>
            <li Class="CombatExtended.ToolCE">
                <label>handle</label>
                <capacities>
                    <li>ElectricShock</li>
                </capacities>
                <power>2</power>
                <cooldownTime>2.3</cooldownTime>
                <chanceFactor>100</chanceFactor>
                <armorPenetrationSharp>4</armorPenetrationSharp>
                <armorPenetrationBlunt>4</armorPenetrationBlunt>
                <linkedBodyPartsGroup>Handle</linkedBodyPartsGroup>
            </li>
        </tools>
        <thingCategories>
            <li>SpecialMelee</li>
        </thingCategories>
        <recipeMaker>
            <researchPrerequisite>Melee_C2</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

