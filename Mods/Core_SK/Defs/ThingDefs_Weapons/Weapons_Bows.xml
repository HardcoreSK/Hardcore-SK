	<!-- SCYTHIAN BOW -->
	<ThingDef ParentName="RangedWeaponMedievalBase">
		<defName>NorbalBow_Grape</defName>
		<label>Norbal Bow</label>
		<description>A powerful Norbal bow. Fires heavy arrows at long distances.</description>
		<graphicData>
			<texPath>Things/Weapons/Bows/NorbalBow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Bow_Recurve</soundInteract>
		<stuffCategories>
			<li>WoodLogs</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<statBases>
			<WorkToMake>7500</WorkToMake>
			<SightsEfficiency>1.1</SightsEfficiency>
			<ShotSpread>2.15</ShotSpread>
			<SwayFactor>1.15</SwayFactor>
			<Bulk>5.50</Bulk>
			<Mass>3.25</Mass>
			<RangedWeapon_Cooldown>0.85</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>NorbalRanged</li>
			<li>CE_Bow</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
		</weaponClasses>
		<tradeability>Sellable</tradeability>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilPattern>Regular</recoilPattern>
				<recoilAmount>0.88</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Projectile_Arrow_Stone</defaultProjectile>
				<warmupTime>0.8</warmupTime>
				<range>40</range>
				<soundCast>Bow_Recurve</soundCast>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<ammoSet>AmmoSet_Arrow</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<noSnapshot>True</noSnapshot>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>RecurveBow</researchPrerequisite>
		</recipeMaker>
		<thingCategories>
			<li>BowRanged</li>
		</thingCategories>
		<rotateInShelves>false</rotateInShelves>
	</ThingDef>
    
    <!-- COMPOUND BOW -->
	<ThingDef ParentName="RangedWeaponIndustrialBase">
		<defName>Bow_Compound</defName>
		<label>Compound Bow</label>
		<description>A compound bow uses a levering system, usually of cables and pulleys, to bend the limbs. The pulley system grants the user a mechanical advantage, and so the limbs of a compound bow are much stiffer than those of a recurve bow or longbow.</description>
		<graphicData>
			<texPath>Things/Weapons/Bows/BowCompound</texPath>
			<graphicClass>SK.Graphic_SingleNoColor</graphicClass>
		</graphicData>
		<soundInteract>Bow_Recurve</soundInteract>
		<statBases>
			<WorkToMake>9000</WorkToMake>
			<SightsEfficiency>1.1</SightsEfficiency>
			<ShotSpread>0.9</ShotSpread>
			<SwayFactor>1</SwayFactor>
			<Bulk>5</Bulk>
			<Mass>3.0</Mass>
			<RangedWeapon_Cooldown>0.80</RangedWeapon_Cooldown>
		</statBases>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>20</costStuffCount>
		<costList>
			<Carbon>5</Carbon>
			<Mechanism>2</Mechanism>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
		<weaponTags>
			<li>CE_Bow</li>
		</weaponTags>
		<weaponClasses>
			<li>ShortShots</li>
		</weaponClasses>
		<tradeability>Sellable</tradeability>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilPattern>Regular</recoilPattern>
				<recoilAmount>1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Projectile_StreamlinedArrow_Steel</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<range>42</range>
				<soundCast>Bow_Recurve</soundCast>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<ammoSet>AmmoSet_StreamlinedArrow</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<noSnapshot>True</noSnapshot>
			</li>
		</comps>
		<recipeMaker>
			<researchPrerequisite>Bow_C1</researchPrerequisite>
		</recipeMaker>
		<thingCategories>
			<li>BowRanged</li>
		</thingCategories>
		<rotateInShelves>false</rotateInShelves>
	</ThingDef>

</Defs>