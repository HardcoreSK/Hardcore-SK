	<ThingDef ParentName="ArmorMedievalBase">
		<defName>Armor_Hauberk</defName>
		<label>Scaled Hauberk</label>
		<description>A long coat which goes down to the knees. It is covered in scaled steel plates, larger plates and chains have been added throughout for added protection.</description>
		<graphicData>
			<texPath>Things/Apparel/Armor/Hauberk/Hauberk</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>		
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<costList>
			<ComponentMedieval>6</ComponentMedieval>
		</costList>
		<statBases>
			<WorkToMake>9000</WorkToMake>
			<MaxHitPoints>95</MaxHitPoints>
			<Flammability>1</Flammability>
			<Mass>6</Mass>
			<Bulk>15</Bulk>
			<WornBulk>7</WornBulk>
			<EquipDelay>12</EquipDelay>			
			<StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>1</StuffEffectMultiplierInsulation_Heat>
			<StuffEffectMultiplierArmor>1.49</StuffEffectMultiplierArmor>
			<ArmorRating_Sharp>2.98</ArmorRating_Sharp>
			<ArmorRating_Blunt>6.81</ArmorRating_Blunt>
			<ArmorRating_Heat>0</ArmorRating_Heat>
		</statBases>
		<equippedStatOffsets>
			<CarryBulk>8</CarryBulk>
			<MoveSpeed>-0.3</MoveSpeed>
			<WorkSpeedGlobal>-0.15</WorkSpeedGlobal>
			<MentalBreakThreshold>-0.03</MentalBreakThreshold>
			<ShootingAccuracyPawn>-0.05</ShootingAccuracyPawn>
			<AimingDelayFactor>0.1</AimingDelayFactor>
			<MeleeHitChance>-0.12</MeleeHitChance>
			<MeleeWeapon_CooldownMultiplier>0.15</MeleeWeapon_CooldownMultiplier>
			<Suppressability>-0.11</Suppressability>
			<GermResistance>0.03</GermResistance>
			<GermContainment>0.02</GermContainment>
		</equippedStatOffsets>
		<generateCommonality>2.2</generateCommonality>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/Armor/Hauberk/MedTimes_Hauberk</wornGraphicPath>
			<layers>
				<li>Shell</li>
			</layers>
			<tags>
				<li>Medieval</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.33,0.33,0.33,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.65,0.65,0.65,1)</only>
				</li>
				<li>
					<weight>10</weight>
					<only>(0.9,0.9,0.9,1)</only>
				</li>
			</options>
		</colorGenerator>
		<thingCategories>
			<li>HeavyFullArmorCat</li>
			<li>SetMedieval</li>
		</thingCategories>
		<recipeMaker>
			<researchPrerequisite>PlateArmor</researchPrerequisite>
		</recipeMaker>
