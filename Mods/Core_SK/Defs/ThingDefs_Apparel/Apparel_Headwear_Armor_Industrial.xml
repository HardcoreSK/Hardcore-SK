	<ThingDef ParentName="ArmorIndustrialSimpleBase">
		<defName>Helmet_ColonialMarine</defName>
		<label>Ballistic Helmet</label>
		<description>A marine helmet designed to protect against ballistics. This is a standard issue item for Colonial Marines.</description>
		<graphicData>
			<texPath>Things/Apparel/Helmets/MarineHelmet/MarineHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<costStuffCount>40</costStuffCount>
		<costList>
			<Compaste>10</Compaste>
			<ComponentIndustrial>4</ComponentIndustrial>
			<Kevlar>25</Kevlar>
		</costList>
		<statBases>
			<WorkToMake>11000</WorkToMake>
			<MaxHitPoints>55</MaxHitPoints>
			<Flammability>1.1</Flammability>
			<Mass>0.9</Mass>
			<Bulk>3</Bulk>
			<WornBulk>0</WornBulk>
			<EquipDelay>2.8</EquipDelay>
			<Insulation_Cold>2.5</Insulation_Cold>
			<StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.15</StuffEffectMultiplierInsulation_Heat>
			<StuffEffectMultiplierArmor>6.67</StuffEffectMultiplierArmor>
			<ArmorRating_Sharp>13.34</ArmorRating_Sharp>
			<ArmorRating_Blunt>34.2342</ArmorRating_Blunt>
			<ArmorRating_Heat>0</ArmorRating_Heat>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.12</MoveSpeed>
			<WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
			<MentalBreakThreshold>-0.03</MentalBreakThreshold>
		</equippedStatOffsets>
		<generateCommonality>1</generateCommonality>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/Helmets/MarineHelmet/MarineHelmet</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryBasic</li>
				<li>IndustrialMilitaryAdvanced</li>
				<li>SectarianMedium</li>
				<li>OrassanTacticalSniper</li>
				<li>OrassanTacticalDemolisher</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<parentTagDef>ApparelHead</parentTagDef>
		</apparel>		  
		<thingCategories>
			<li>HeavyHelmetsCat</li>
			<li>Setmarinearmor</li>
		</thingCategories>
		<recipeMaker>
			<researchPrerequisite>Fabrication</researchPrerequisite>
		</recipeMaker>
	</ThingDef>

