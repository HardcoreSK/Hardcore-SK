			<texPath>Things/Apparel/Mining/MiningHelmet</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<stuffCategories>
			<li>StrongMetallic</li>
		</stuffCategories>
		<recipeMaker IsNull="True"/>
		<costStuffCount>30</costStuffCount><!--
		<costList>
			<Glass>2</Glass>
			<ComponentIndustrial>2</ComponentIndustrial>
			<ElectronicComponents>1</ElectronicComponents>
		</costList>-->
		<statBases>
			<WorkToMake>9000</WorkToMake>
			<MaxHitPoints>55</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Mass>1</Mass>
			<Bulk>3</Bulk>
			<WornBulk>0</WornBulk>
			<EquipDelay>1.7</EquipDelay>			
			<Insulation_Heat>2.5</Insulation_Heat>
			<Insulation_Cold>5</Insulation_Cold>
			<StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.25</StuffEffectMultiplierInsulation_Heat>
			<StuffEffectMultiplierArmor>2.2</StuffEffectMultiplierArmor>
			<ArmorRating_Sharp>0</ArmorRating_Sharp>
			<ArmorRating_Blunt>0</ArmorRating_Blunt>
			<ArmorRating_Heat>0.08</ArmorRating_Heat>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.04</MoveSpeed>
			<WorkSpeedGlobal>-0.03</WorkSpeedGlobal>
			<MiningSpeed>0.20</MiningSpeed>
			<GermResistance>0.02</GermResistance>
			<GermContainment>0.02</GermContainment>
		</equippedStatOffsets>
		<generateCommonality>0.01</generateCommonality>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/Mining/MiningHelmet</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<defaultOutfitTags>
