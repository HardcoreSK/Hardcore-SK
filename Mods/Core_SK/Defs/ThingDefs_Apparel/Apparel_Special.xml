			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<parentTagDef>ApparelHead</parentTagDef>
		</apparel>
		<thingCategories>
			<li>SpecialHelmetsCat</li>
			<li>SetMiner</li>
		</thingCategories>
	</ThingDef>

	<ThingDef ParentName="ApparelIndustrialBase">
		<defName>Apparel_HSH</defName>
		<label>Chemical Protection Helmet</label>
		<description>A part of a Chemical Protection Suit (also known as a hazmat suit). It helps to protect people from hazardous materials or substances including chemicals, biological agents, or radioactive materials.</description>
