<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--
    DefOverwrite list:
    MealNutrientPaste
    -->

	<ThingDef ParentName="ResourceBase">
		<defName>soylentgreen</defName>
		<label>soylent green</label>
		<description>Soylent Green is made from people, corpses that is. The taste varies from person to person.</description>
		<graphicData>
			<texPath>Things/Food/Raw/SoylentGreen</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>5</MarketValue>
			<DeteriorationRate>2</DeteriorationRate>
			<WorkToMake>800</WorkToMake>
			<Bulk>0.15</Bulk>
			<Mass>0.12</Mass>
			<Nutrition>0.1</Nutrition>	
		</statBases>
		<ingestible>
			<foodType>Meat</foodType>
			<preferability>MealAwful</preferability>
			<ingestEffect>EatMeat</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<maxNumToIngestAtOnce>7</maxNumToIngestAtOnce>
			<tasteThought>AteSoylentGreen</tasteThought>
		</ingestible>
		<stackLimit>75</stackLimit>
		<tickerType>Rare</tickerType>
		<socialPropernessMatters>true</socialPropernessMatters>
		<resourceReadoutPriority>Last</resourceReadoutPriority>
		<comps>
			<li Class="CompProperties_Ingredients">
				<splitTransferableFoodKind>true</splitTransferableFoodKind>
			</li>
			<li Class="CompProperties_FoodPoisonable" />
			<li Class="CompProperties_Rottable">
				<daysToRotStart>4</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li MayRequire="Ludeon.RimWorld.Anomaly" Class="CompProperties_MetalhorrorInfectible" />
		</comps>
		<thingCategories>
			<li>MeatRaw</li>
		</thingCategories>
		<modExtensions>
			<li Class="SK.SyntheticMealExtension">
			</li>
		</modExtensions>
	</ThingDef>

</Defs>
