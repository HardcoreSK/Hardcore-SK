<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RecipeDef ParentName="MakeSimpleImplantBase">
        <defName>CreateEyePatch</defName>
        <label>make Eye Patch</label>
        <description>Covers the eye socket. Intimidating.</description>
        <jobString>making eye patch</jobString>
        <ingredients>
            <li>
                <filter>
					<categories>
						<li>Leathers</li>
						<li>Textiles</li>
					</categories>
                </filter>
                <count>15</count>
            </li>
        </ingredients>
        <products>
            <EyePatch>1</EyePatch>
        </products>
        <skillRequirements>
            <Crafting>1</Crafting>
        </skillRequirements>
    </RecipeDef>

    <RecipeDef ParentName="MakeSimpleImplantBase">
        <defName>CreateClothTail</defName>
        <label>make cloth tail</label>
        <description>A very poor tail replacement. Looks bad, feels bad, is bad.</description>
        <jobString>making cloth tail</jobString>
        <ingredients>
            <li>
                <filter>
					<categories>
						<li>Leathers</li>
					</categories>
                </filter>
                <count>25</count>
            </li>
            <li>
                <filter>
					<categories>
						<li>Textiles</li>
					</categories>
                </filter>
                <count>25</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Wire</li>
                    </thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <products>
            <OClothTail>1</OClothTail>
        </products>
        <skillRequirements>
            <Crafting>2</Crafting>
        </skillRequirements>
    </RecipeDef>

    <RecipeDef ParentName="MakeSimpleImplantBase">
        <defName>CreateArtificialNose</defName>
        <label>make Artificial Nose</label>
        <description>Replaces missing hands. Way more comfortable and less frightening than the hook hand.</description>
        <jobString>making artificial nose</jobString>
        <researchPrerequisite>Prosthesis_making_B1</researchPrerequisite>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentMedieval</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>SilverBar</li>
                        <li>TinBar</li>
                        <li>GoldBar</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
            <li>
                <filter>
					<categories>
						<li>Wooden</li>
					</categories>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
					<categories>
						<li>Leathers</li>
					</categories>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        <products>
            <ArtificialNose>1</ArtificialNose>
        </products>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
    </RecipeDef>

