<Defs>

    <RecipeDef Name="MakeSimpleImplantBase" Abstract="True">
        <workSpeedStat>SmithingSpeed</workSpeedStat>
        <!--<workSkillLearnPerTick>0.8</workSkillLearnPerTick>-->
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>EPOEAssembling</soundWorking>
        <unfinishedThingDef>UnfinishedHealthItemProsthetic</unfinishedThingDef>
        <skillRequirements>
            <Crafting>6</Crafting>
        </skillRequirements>
        <recipeUsers>
            <li>TableBasicProsthetic</li>
        </recipeUsers>
    </RecipeDef>
    
    <RecipeDef ParentName="MakeSimpleImplantBase">
        <defName>CreateArtificialNose</defName>
        <label>make Artificial Nose</label>
        <description>Replaces missing hands. Way more comfortable and less frightening than the hook hand.</description>
        <jobString>making artificial nose</jobString>
        <researchPrerequisite>Prosthesis_making_B1</researchPrerequisite>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>ComponentMedieval</li>
                    </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>SilverBar</li>
                        <li>TinBar</li>
                        <li>GoldBar</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
            <li>
                <filter>
					<categories>
						<li>Wooden</li>
					</categories>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
					<categories>
						<li>Leathers</li>
					</categories>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        <products>
            <ArtificialNose>1</ArtificialNose>
        </products>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
    </RecipeDef>

