	<ThingDef ParentName="CropsBase">
		<defName>ComponentMedieval</defName>
		<label>primitive component</label>
		<description>Miscellaneous various simple components from medieval era.</description>
		<graphicData>
			<texPath>Things/Item/Components/ComponentMedieval</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Neolithic</techLevel>
