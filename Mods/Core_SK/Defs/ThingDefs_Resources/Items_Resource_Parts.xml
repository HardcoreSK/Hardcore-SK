	<ThingDef ParentName="CropsBase">
		<defName>MetalCan</defName>
		<label>metal can</label>
		<description>Empty metal cans are needed for canned meals.</description>
		<graphicData>
			<texPath>Things/Item/Meal/Metalcan</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Metal_Drop</soundDrop>
		<techLevel>Industrial</techLevel>
