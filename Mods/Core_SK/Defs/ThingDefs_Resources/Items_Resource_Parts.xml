			<Mass>1.5</Mass>
			<Bulk>1.5</Bulk>
		</statBases>
		<useHitPoints>true</useHitPoints>
		<thingCategories>
			<li>Parts</li>
		</thingCategories>
		<stackLimit>300</stackLimit>
	</ThingDef>


