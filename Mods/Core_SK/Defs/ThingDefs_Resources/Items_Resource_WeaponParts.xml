	<ThingDef ParentName="CropsBase">
		<defName>Weapon_Parts</defName>
		<label>weapon parts</label>
		<description>Parts of disassembled weapons.</description>
		<graphicData>
			<texPath>Things/Item/Parts/weapon_components</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Metal_Drop</soundDrop>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MarketValue>65</MarketValue>
			<DeteriorationRate>0</DeteriorationRate>
			<Flammability>1</Flammability>
			<SellPriceFactor>0.70</SellPriceFactor>
			<Mass>1</Mass>
			<Bulk>2</Bulk>
		</statBases>
		<useHitPoints>true</useHitPoints>
		<thingCategories>
			<li>WeaponParts</li>
		</thingCategories>
		<stuffProps>
			<categories>
				<li>Matty</li>
			</categories>
		</stuffProps>
		<stackLimit>75</stackLimit>
	</ThingDef>

