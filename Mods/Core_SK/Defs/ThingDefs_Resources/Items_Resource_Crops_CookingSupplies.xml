	<ThingDef ParentName="SK_RoughPlantBase">
		<defName>Rawwheat</defName>
		<label>Wheat</label>
		<description>Wheat is a cereal grain. It can be milled into Flour for use in baking bread.</description>
		<graphicData>
			<texPath>Things/Food/Ingredients/Wheat</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>2.0</MarketValue>
		</statBases>
		<stackLimit>300</stackLimit>
		<tickerType>Rare</tickerType>
		<thingCategories>
			<li>CookingSupplies</li>
		</thingCategories>
		<stuffProps>
			<categories>
				<li>Stuff</li>
			</categories>
		</stuffProps>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>60</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

