	<ThingDef ParentName="SK_RoughPlantBase">
		<defName>RawTobacco</defName>
		<label>Tobacco Leaves</label>
		<description>Raw Tobacco Leaves from a Tobacco Plant. Not recommended for eating. Tobacco can be rolled and smoked as a stimulating drug. They are addicting and are associated with a number of health problems for long term use.</description>
		<graphicData>
			<texPath>Things/Food/Drugs/Tobacco</texPath>
