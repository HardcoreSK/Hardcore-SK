	<ThingDef ParentName="ResourceBase">
		<defName>WoolDromedary</defName>
		<label>Dromedary hair</label>
		<description>Dromedary Hair clothing is usually worn by desert travelers to protect them from the heat. It provides excellent insulation due to its thermostatic properties.</description>
		<graphicData>
			<texPath>Things/Item/Resource/Wool</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(220,179,132)</color>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<MarketValue>3.5</MarketValue>
			<Flammability>1.75</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
			<StuffPower_Armor_Blunt>0.95</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Sharp>0.6</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Heat>0.078</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>17</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>11</StuffPower_Insulation_Heat>
			<Mass>0.02</Mass>
			<Bulk>0.02</Bulk>
		</statBases>
		<stackLimit>300</stackLimit>
		<techLevel>Neolithic</techLevel>
		<stuffProps>
			<categories>
				<li>Fabric</li>
			</categories>
			<color>(220,179,132)</color>
			<statFactors>
				<MaxHitPoints>1.35</MaxHitPoints>
				<Beauty>1.2</Beauty>
				<MoveSpeed>0.85</MoveSpeed>
				<MarketValue>0.7</MarketValue>
				<WorkToMake>1.1</WorkToMake>
				<WorkToBuild>1.1</WorkToBuild>
				<BedRestEffectiveness>1.25</BedRestEffectiveness>
				<ImmunityGainSpeedFactor>1.1</ImmunityGainSpeedFactor>
				<Mass>0.65</Mass>
			</statFactors>
		</stuffProps>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BTextiles</li>
		</thingCategories>
		<burnableByRecipe>True</burnableByRecipe>
	</ThingDef>

