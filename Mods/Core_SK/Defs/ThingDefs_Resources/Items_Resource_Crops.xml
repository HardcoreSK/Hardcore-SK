<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
    DefOverwrite list:
    Kibble
    Hay
    RawHops
    PsychoidLeaves
    SmokeleafLeaves
    -->

	<ThingDef Name="CropsBase" Abstract="True">
		<thingClass>ThingWithComps</thingClass>
		<label>unspecified resource</label>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<resourceReadoutPriority>Middle</resourceReadoutPriority>
		<useHitPoints>true</useHitPoints>
		<selectable>true</selectable>
		<altitudeLayer>Item</altitudeLayer>
		<stackLimit>75</stackLimit>
		<comps>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<statBases>
			<Mass>0.1</Mass>
			<Bulk>0.1</Bulk>
			<Beauty>-2</Beauty>
		</statBases>
		<alwaysHaulable>true</alwaysHaulable>
		<drawGUIOverlay>true</drawGUIOverlay>
		<rotatable>false</rotatable>
		<pathCost>15</pathCost>
	</ThingDef>

	<ThingDef Abstract="True" Name="SK_OrganicProductBase" ParentName="ResourceBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<ingestible>
			<preferability>DesperateOnly</preferability>
			<chairSearchRadius>60</chairSearchRadius>
		</ingestible>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<Nutrition>0.05</Nutrition>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>10</DeteriorationRate>
			<Mass>0.15</Mass>
			<Bulk>0.15</Bulk>
		</statBases>
		<tickerType>Rare</tickerType>
		<healthAffectsPrice>false</healthAffectsPrice>
	</ThingDef>

	<ThingDef Abstract="True" Name="SK_PlantFoodRawBase" ParentName="SK_OrganicProductBase">
		<ingestible>
			<preferability>RawBad</preferability>
			<tasteThought>AteRawFood</tasteThought>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>RawVegetable_Eat</ingestSound>
		</ingestible>
		<socialPropernessMatters>true</socialPropernessMatters>
		<stuffProps>
			<categories>
				<li>Foods</li>
			</categories>
		</stuffProps>
		<statBases>
			<FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
		</statBases>
		<allowedArchonexusCount>200</allowedArchonexusCount>
	</ThingDef>

	<ThingDef Abstract="True" ParentName="ResourceBase" Name="CookingProductBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>5</DeteriorationRate>
			<Mass>0.15</Mass>
			<Bulk>0.15</Bulk>
		</statBases>
		<ingestible>
			<foodType>Plant</foodType>
			<preferability>NeverForNutrition</preferability>
			<joyKind>Gluttonous</joyKind>
			<chairSearchRadius>60</chairSearchRadius>
		</ingestible>
		<tickerType>Rare</tickerType>
	</ThingDef>

	<ThingDef Abstract="True" ParentName="ResourceBase" Name="RawDrugsBase">
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>5</DeteriorationRate>
			<Mass>0.08</Mass>
			<Bulk>0.08</Bulk>
		</statBases>
		<ingestible>
			<foodType>Plant</foodType>
			<preferability>NeverForNutrition</preferability>
			<joyKind>Gluttonous</joyKind>
			<chairSearchRadius>60</chairSearchRadius>
		</ingestible>
		<tickerType>Rare</tickerType>
	</ThingDef>

	<!-- Plant matter (inedible by people) -->

	<ThingDef ParentName="SK_OrganicProductBase" Name="SK_RoughPlantBase" Abstract="True">
		<statBases>
			<Nutrition>0.05</Nutrition>
		</statBases>
		<ingestible>
			<foodType>Plant</foodType>
			<preferability>DesperateOnlyForHumanlikes</preferability>
		</ingestible>
	</ThingDef>

	<ThingDef ParentName="SK_RoughPlantBase">
		<defName>Silage</defName>
		<label>Silage</label>
		<description>Silage is nutrient-rich fermented hay and raw food product suitable for animal feed. The fermentation process preserves the silage and prevents it from rotting.</description>
		<graphicData>
            <texPath>Things/Food/Animal/Hay</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<color>(107,142,35)</color>
		</graphicData>
		<stackLimit>300</stackLimit>
		<statBases>
			<Mass>0.15</Mass>
			<MarketValue>5</MarketValue>
			<DeteriorationRate>.1</DeteriorationRate>
			<Nutrition>0.35</Nutrition>
		</statBases>
		<ingestible>
			<optimalityOffsetFeedingAnimals>7</optimalityOffsetFeedingAnimals>
		</ingestible>
		<thingCategories>
			<li>Animalfood</li>
		</thingCategories>
	</ThingDef>

	<ThingDef ParentName="RawDrugsBase">
		<defName>NeutroPetals</defName>
		<label>Neutro Flower Petals</label>
		<description>Beautiful Yellow-Orange Petals from the Neutro Flower. Used to make Neutroamine, a medicine base.</description>
		<graphicData>
			<texPath>Things/Item/Medicine/NeutroPetals</texPath>
		</graphicData>
		<statBases>
			<MarketValue>1.0</MarketValue>
			<Bulk>0.1</Bulk>
			<Mass>0.1</Mass>
		</statBases>
		<ingestible>
			<joy>0.1</joy>
		</ingestible>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>10</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="SK_RoughPlantBase">
		<defName>aloe</defName>
		<label>Aloe Leaves</label>
		<description>A bundle of Aloe Leaves from an Aloe Plant. Aloe Leaves are used as a type of natural medicine.</description>
		<thingClass>Medicine</thingClass>
		<graphicData>
			<texPath>Things/Item/Medicine/Aloe</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Standard_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<MarketValue>5</MarketValue>
			<Flammability>1.0</Flammability>
			<MedicalPotency>0.45</MedicalPotency>
			<DeteriorationRate>20</DeteriorationRate>
		</statBases>
		<thingCategories>
			<li>PlantMatter</li>
			<li>Medicine</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>10</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="CropsBase">
		<defName>RawCaoutchouc</defName>
		<label>Caoutchouc</label>
		<description>Caoutchouc is a natural rubber sap collected from a Hevea Tree. It can be vulcanized to create useful rubber materials.</description>
		<graphicData>
			<texPath>Things/Item/Resource/Caoutchouc</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<MarketValue>2</MarketValue>
			<Flammability>4.0</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
		</statBases>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>25</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>

</Defs>