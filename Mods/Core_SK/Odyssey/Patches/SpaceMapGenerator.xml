<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<!-- Replaced With MineableNickel -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GenStepDef[contains(defName, "Asteroid")]/genStep/mineableCounts/MineablePlasteel</xpath>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/GenStepDef[defName="Asteroid"]/genStep[@Class="GenStep_Asteroid"]</xpath>
		<value>
			<mineableCounts Merge="true">
				<MineableTin>20~40</MineableTin>
				<MineableCopper>30~40</MineableCopper>
				<MineableAluminium>20~30</MineableAluminium>
				<MineableTitanium>15~20</MineableTitanium>
				<MineableTungsten>15~20</MineableTungsten>
				<MineableNickel>20~35</MineableNickel>
				<MineableLead>20~35</MineableLead>
			</mineableCounts>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/GenStepDef[defName="Asteroid_NoRuins"]/genStep[@Class="GenStep_Asteroid"]</xpath>
		<value>
			<mineableCounts Merge="true">
				<MineableTin>20~40</MineableTin>
				<MineableCopper>30~40</MineableCopper>
				<MineableAluminium>20~30</MineableAluminium>
				<MineableTitanium>15~20</MineableTitanium>
				<MineableTungsten>15~20</MineableTungsten>
				<MineableNickel>20~35</MineableNickel>
				<MineableLead>20~35</MineableLead>
			</mineableCounts>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/GenStepDef[defName="AsteroidBasic"]/genStep[@Class="GenStep_BasicAsteroid"]</xpath>
		<value>
			<mineableCounts Merge="true">
				<MineableTin>20~40</MineableTin>
				<MineableCopper>30~40</MineableCopper>
				<MineableAluminium>10~15</MineableAluminium>
				<MineableTitanium>5~10</MineableTitanium>
				<MineableTungsten>5~10</MineableTungsten>
				<MineableNickel>15~20</MineableNickel>
				<MineableLead>15~20</MineableLead>
			</mineableCounts>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/QuestScriptDef[defName="OpportunitySite_Asteroid"]/root/nodes/li[@Class="QuestNode_Root_Asteroid"]</xpath>
		<value>
			<mineables Merge="true">
				<li>MineableTin</li>
				<li>MineableCopper</li>
				<li>MineableAluminium</li>
				<li>MineableTitanium</li>
				<li>MineableTungsten</li>
				<li>MineableNickel</li>
				<li>MineableLead</li>
			</mineables>
		</value>
	</Operation>
</Patch>