<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <WeatherDef Name="DarkestNightWeatherBase" Abstract="True">
    <label>darkness</label>
    <description>The sky has collapsed. Stay in the light.</description>
    <isBad>true</isBad>
    <canOccurAsRandomForcedEvent>false</canOccurAsRandomForcedEvent>
    <favorability>VeryBad</favorability>
    <perceivePriority>3</perceivePriority>
    <preventSkygaze>true</preventSkygaze>
    <transitionTicksOverride>600</transitionTicksOverride>
    <skyColorsDay>
      <sky>(0.05,0.04,0.03)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.1,0.05,0.04)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.05,0.04,0.03)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.1,0.05,0.04)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.05,0.04,0.03)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.1,0.05,0.04)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.05,0.04,0.03)</sky>
      <shadow>(1,1,1)</shadow>
      <overlay>(0.1,0.05,0.04)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <WeatherDef ParentName="DarkestNightWeatherBase">
    <defName>Dark_Stage1</defName>
    <description>The sky is dimming. Soon only lamps and torches will hold the darkness back.</description>
  </WeatherDef>

  <WeatherDef ParentName="DarkestNightWeatherBase">
    <defName>Dark_Stage2</defName>
    <description>The sky has collapsed. Stay in the light.</description>
  </WeatherDef>

</Defs>
