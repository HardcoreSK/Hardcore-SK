	<!---->
	<IncidentDef>
		<defName>GlobalCooling</defName>
		<label>Global cooling</label>
		<letterLabel>Global cooling</letterLabel>
		<letterText>A global cooling event is beginning, during which the planet will gradually freeze and the climate will change dramatically. The seas will be covered with ice, opening up routes for caravans. Prepare for the onset of terrible cold.\n\nThe coldest places will be located high above sea level.</letterText>
		<workerClass>EventsCore.Incidents.IncidentWorker_ClimateChange</workerClass>
		<gameCondition>ClimateChange</gameCondition>
		<category>ThreatBig</category>
		<letterDef>ThreatBig</letterDef>
		<targetTags>
			<li>Map_PlayerHome</li>
			<li>Map_TempIncident</li>
			<li>Map_Misc</li>
			<li>Map_RaidBeacon</li>
			<li>Caravan</li>
		</targetTags>
		<baseChance>0.1</baseChance>
		<earliestDay>300</earliestDay>
		<minRefireDays>720</minRefireDays>
		<modExtensions>
			<li Class="EventsCore.Incidents.DefModExtension_IncidentProps">
				<props Class="EventsCore.Incidents.IncidentProperties_ClimateChange">
					<targetTemperatureChange>-80</targetTemperatureChange>
					<elevationTemperatureCurve>
						<points>
							<li>-500, 0.5</li>
							<li>0, 1</li>
							<li>3000, 1.5</li>
						</points>
					</elevationTemperatureCurve>
					<equatorialDistanceTemperatureCurve>
						<points>
							<li>0, 0.5</li>
							<li>1, 3</li>
						</points>
					</equatorialDistanceTemperatureCurve>
					<!-- Что примерно дает 80 за 30 дней -->
					<temperatureChangePerIntervalByDayPassedCurve>
						<points>
							<li>0, -1.0</li>
							<li>5, -1.2</li>
							<li>10, -2.0</li>
							<li>20, -3.0</li>
							<li>30, -5.0</li>
						</points>
					</temperatureChangePerIntervalByDayPassedCurve>
				</props>
			</li>
		</modExtensions>
	</IncidentDef>
