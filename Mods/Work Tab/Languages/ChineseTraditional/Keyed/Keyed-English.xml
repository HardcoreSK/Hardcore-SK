<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <WorkTab>Work Tab</WorkTab>

  <!-- Main tab toggle buttons -->
  <WorkTab.PrioritiesSimple>當前顯示數值型優先級\n\n點擊切換至開關型優先級</WorkTab.PrioritiesSimple>
  <WorkTab.PrioritiesDetailed>當前顯示開關型優先級\n\n點擊切換至數值型優先級</WorkTab.PrioritiesDetailed>
  <WorkTab.PrioritiesTimed>當前顯示計畫型優先級\n\n點擊切換至全天型優先級</WorkTab.PrioritiesTimed>
  <WorkTab.PrioritiesWholeDay>當前顯示全天型優先級\n\n點擊切換至計畫型優先級</WorkTab.PrioritiesWholeDay>
  <WorkTab.ExpandAll>當前顯示詳細優先級\nCtrl+點擊以切换詳細優先級</WorkTab.ExpandAll>
  <WorkTab.CollapseAll>當前顯示縮略優先級\nCtrl+點擊以切换縮略優先級</WorkTab.CollapseAll>

  <!-- column header tooltips -->
  <WorkTab.DetailedColumnTip>滾輪上滾以提升優先級或滾輪下滾以降低優先級</WorkTab.DetailedColumnTip>
  <WorkTab.ToggleColumnTip>滾輪上滾以開啟優先級或滾輪下滾以關閉優先級</WorkTab.ToggleColumnTip>
  <WorkTab.ExpandWorkgiversColumnTip>Ctrl+點擊以展開詳細優先級列表</WorkTab.ExpandWorkgiversColumnTip>
  <WorkTab.CollapseWorkgiversColumnTip>Ctrl+點擊以收起詳細優先級列表</WorkTab.CollapseWorkgiversColumnTip>

  <!-- settings -->
  <WorkTab.24HourMode>24小時模式</WorkTab.24HourMode>
  <WorkTab.24HourModeTip>時間顯示是以12小時制（比如：中午、9p.m.）或24小時制（比如：12:00、21:00）。</WorkTab.24HourModeTip>
  <WorkTab.MaxPriority>優先級等級</WorkTab.MaxPriority>
  <WorkTab.MaxPriorityTip>優先級使用多少個等級（限制在4至9之間）。</WorkTab.MaxPriorityTip>
  <WorkTab.DisableScrollwheel>禁用滾輪代替點擊</WorkTab.DisableScrollwheel>
  <WorkTab.DisableScrollwheelTip>禁用滾輪代替點擊（當滑鼠懸停在技能上時）</WorkTab.DisableScrollwheelTip>
  <WorkTab.DefaultPriority>默認優先級</WorkTab.DefaultPriority>
  <WorkTab.DefaultPriorityTip>默認優先級（默認3，限制在1至9之間）</WorkTab.DefaultPriorityTip>
  <WorkTab.HighlightActiveWorkCells>高亮工作單元格</WorkTab.HighlightActiveWorkCells>
  <WorkTab.HighlightActiveWorkCellsTip>高亮顯示小人當前工作的單元格</WorkTab.HighlightActiveWorkCellsTip>

