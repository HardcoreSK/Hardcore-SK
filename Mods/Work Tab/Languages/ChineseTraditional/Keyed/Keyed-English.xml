  <WorkTab.SchedulerHourTip>{0}-{1}當前{2}\n\n{3}</WorkTab.SchedulerHourTip>
  <WorkTab.Selected>已選擇</WorkTab.Selected>
  <WorkTab.NotSelected>未選擇</WorkTab.NotSelected>
  <WorkTab.ClickToSelect>點擊以選擇\nShift+點擊來取消其他選擇</WorkTab.ClickToSelect>
  <WorkTab.ClickToFocus>點擊以聚焦</WorkTab.ClickToFocus>
