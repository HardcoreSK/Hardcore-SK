<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- EEPA & ABOS -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="PPCRailgun"]/comps/li[@Class="Rimatomics.CompProperties_Upgradable"]/upgrades</xpath>
        <value>
            <li>
                <project>RimatomicsPlusPlus_EEPA</project>
            </li>
            <li>
                <project>RimatomicsPlusPlus_ABOS</project>
            </li>
        </value>
    </Operation>

    <!-- spread-changing comp -->
    <Operation Class="RimatomicsPlusPlus.PatchOperationUnlessDisabledInSettings">
        <settingsKey>RailgunSpread</settingsKey>
        <value Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="PPCRailgun"]/comps</xpath>
            <value>
                <li Class="RimatomicsPlusPlus.CompProperties_SpreadAdjustable" />
            </value>
        </value>
    </Operation>
</Patch>
