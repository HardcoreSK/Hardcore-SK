<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef Abstract="True" Name="FuseBase">
        <designationCategory>Power</designationCategory>
        <category>Building</category>
        <thingClass>Building</thingClass>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsPower</li>
        </thingCategories>
        <drawerType>MapMeshAndRealTime</drawerType>
        <repairEffect>Repair</repairEffect>
        <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
        <filthLeaving>Filth_RubbleBuilding</filthLeaving>
        <staticSunShadowHeight>0.2</staticSunShadowHeight>
        <castEdgeShadows>true</castEdgeShadows>
        <tickerType>Rare</tickerType>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <selectable>True</selectable>
        <rotatable>False</rotatable>
        <fillPercent>0.30</fillPercent>
        <pathCost>70</pathCost>
        <leaveResourcesWhenKilled>True</leaveResourcesWhenKilled>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTransmitter</compClass>
                <transmitsPower>True</transmitsPower>
            </li>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
    </ThingDef>

    <ThingDef ParentName="FuseBase">
        <defName>Building_RTMakeshiftFuse</defName>
        <label>simple fuse</label>
        <description>A simple fuse. Handles up to 3000 Wd discharge, will require repairs if tripped.</description>
        <graphicData>
            <texPath>Things/Building/Misc/SimpleFuse/SimpleFuse</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1, 2)</drawSize>
            <drawOffset>(0, 0, 0.5)</drawOffset>
        </graphicData>
        <researchPrerequisites>
            <li>Electrical_engineering_C2</li>
        </researchPrerequisites>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>600</WorkToBuild>
            <Flammability>1.0</Flammability>
            <Mass>10</Mass>
            <Beauty>-10</Beauty>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>15</costStuffCount>
        <costList>
            <ComponentIndustrial>1</ComponentIndustrial>
            <Mechanism>1</Mechanism>
            <ElectronicComponents>1</ElectronicComponents>
        </costList>
        <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
        <comps>
            <li Class="SK.CompProperties_PowerOnGraphic" />
            <li Class="RT_Fuse.CompProperties_RTFuse">
                <compClass>RT_Fuse.CompRTFuse</compClass>
                <surgeMitigation>3000</surgeMitigation>
                <breakdownOnTrip>true</breakdownOnTrip>
            </li>
        </comps>
    </ThingDef>
    
    <ThingDef ParentName="FuseBase">
        <defName>Building_RTCircuitBreaker</defName>
        <label>circuit breaker</label>
        <description>A set of automatic circuit breakers. Handles up to 9000 Wd discharge, will flick off if tripped.</description>
        <graphicData>
            <texPath>Things/Building/Misc/AdvancedFuse/Fuse</texPath>
            <graphicClass>SK.Graphic_SingleNoColor</graphicClass>
            <drawSize>(1, 1.4)</drawSize>
            <drawOffset>(0, 0, 0.2)</drawOffset>
        </graphicData>
        <researchPrerequisites>
            <li>Electrical_engineering_E1</li>
        </researchPrerequisites>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>2000</WorkToBuild>
            <Flammability>0.8</Flammability>
            <Mass>20</Mass>
            <Beauty>-5</Beauty>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>30</costStuffCount>
        <costList>
            <ComponentIndustrial>5</ComponentIndustrial>
            <MagneticMaterial>2</MagneticMaterial>
            <Microchips>1</Microchips>
        </costList>
        <constructionSkillPrerequisite>11</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_Flickable"/>
            <li Class="RT_Fuse.CompProperties_RTFuse">
                <compClass>RT_Fuse.CompRTFuse</compClass>
                <surgeMitigation>9000</surgeMitigation>
                <breakdownOnTrip>false</breakdownOnTrip>
            </li>
        </comps>
    </ThingDef>
    
    <ThingDef ParentName="FuseBase">
        <defName>Building_RTCircuitBreakerBig</defName>
        <label>big circuit breaker</label>
        <description>A set of automatic circuit breakers. Handles up to 36000 Wd discharge, will flick off if tripped.</description>
        <graphicData>
            <texPath>Things/Building/Misc/AdvancedFuse/FuseBig</texPath>
            <graphicClass>SK.Graphic_SingleNoColor</graphicClass>
            <drawSize>(2, 2.4)</drawSize>
            <drawOffset>(0, 0, 0.2)</drawOffset>
        </graphicData>
        <researchPrerequisites>
            <li>Electrical_engineering_E1</li>
        </researchPrerequisites>
        <size>(2, 2)</size>
        <statBases>
            <MaxHitPoints>350</MaxHitPoints>
            <WorkToBuild>7500</WorkToBuild>
            <Flammability>0.8</Flammability>
            <Mass>80</Mass>
            <Beauty>-5</Beauty>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>120</costStuffCount>
        <costList>
            <ComponentIndustrial>15</ComponentIndustrial>
            <MagneticMaterial>8</MagneticMaterial>
            <Microchips>4</Microchips>
        </costList>
        <constructionSkillPrerequisite>13</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_Flickable"/>
            <li Class="RT_Fuse.CompProperties_RTFuse">
                <compClass>RT_Fuse.CompRTFuse</compClass>
                <surgeMitigation>30000</surgeMitigation>
                <breakdownOnTrip>false</breakdownOnTrip>
            </li>
        </comps>
    </ThingDef>
</Defs>