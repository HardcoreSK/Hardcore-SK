<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[
            defName="SolarWeb-Stratum-LEDLight_Hanging" or
            defName="SolarWeb-Stratum-SunLamp_Hanging" or
            defName="SolarWeb-Stratum-SurgicalSpotlight" or 
            defName="SolarWeb-Stratum-AeroponicsMister_Hanging" or 
            defName="SolarWeb-Stratum-CeilingFan"
        ]</xpath>
    </Operation>
    
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-LightningRod"]/designationCategory</xpath>
        <value>
            <designationCategory IsNull="True" />
        </value>
    </Operation>
    
    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-FireSprinkler"]</xpath>
        <value>
            <graphicData>
                <texPath>Things/Building/Misc/fireplug</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <shadowData>
                    <volume>(0.25, 0.5, 0.25)</volume>
                    <offset>(0,0,-0.1)</offset>
                </shadowData>
                <damageData>
                    <rect>(0.2,0.2,0.6,0.6)</rect>
                </damageData>
            </graphicData>
            <statBases>
                <MaxHitPoints>30</MaxHitPoints>
                <WorkToBuild>1000</WorkToBuild>
                <Flammability>1.0</Flammability>
                <Beauty>-8</Beauty>
                <Bulk>20</Bulk>
                <Mass>10</Mass>
            </statBases>
            <fillPercent>0</fillPercent>
            <costList>
                <ComponentIndustrial>5</ComponentIndustrial>
                <Surfactant>25</Surfactant>
                <ElectronicComponents>1</ElectronicComponents>
                <Mechanism>1</Mechanism>
            </costList>
            <researchPrerequisites>
                <li>IED_C1</li>
            </researchPrerequisites>
            <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        </value>
    </Operation>

    <!-- Bring the remaining Stratum roof attachments into HSK's component and
         stuff economy instead of leaving their low vanilla-oriented costs. -->
    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-PASpeaker_Hanging"]</xpath>
        <value Merge="true">
            <stuffCategories DeepReplace="true">
                <li>Metallic</li>
                <li>Woody</li>
            </stuffCategories>
            <costStuffCount>40</costStuffCount>
            <costList DeepReplace="true">
                <ComponentIndustrial>3</ComponentIndustrial>
                <ElectronicComponents>2</ElectronicComponents>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-PATransmitter"]</xpath>
        <value Merge="true">
            <stuffCategories DeepReplace="true">
                <li>StrongMetallic</li>
                <li>Plastic</li>
            </stuffCategories>
            <costStuffCount>60</costStuffCount>
            <costList DeepReplace="true">
                <Glass>15</Glass>
                <Electronics>5</Electronics>
                <ComponentIndustrial>5</ComponentIndustrial>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RooftopScannerBooster"]</xpath>
        <value Merge="true">
            <stuffCategories DeepReplace="true">
                <li>RuggedMetallic</li>
            </stuffCategories>
            <costStuffCount>100</costStuffCount>
            <costList DeepReplace="true">
                <Plastic>35</Plastic>
                <Mechanism>5</Mechanism>
                <ComponentIndustrial>8</ComponentIndustrial>
                <Electronics>3</Electronics>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RotaryTurbineVent"]</xpath>
        <value Merge="true">
            <stuffCategories DeepReplace="true">
                <li>StrongMetallic</li>
            </stuffCategories>
            <costStuffCount>50</costStuffCount>
            <costList DeepReplace="true">
                <ComponentIndustrial>3</ComponentIndustrial>
                <Mechanism>2</Mechanism>
            </costList>
        </value>
    </Operation>

    <Operation Class="SK.PatchOperationReplaceExtended">
        <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RooftopSolarGenerator"]</xpath>
        <value Merge="true">
            <stuffCategories DeepReplace="true">
                <li>StrongMetallic</li>
            </stuffCategories>
            <costStuffCount>30</costStuffCount>
            <costList DeepReplace="true">
                <Glass>20</Glass>
                <ComponentIndustrial>2</ComponentIndustrial>
                <ElectronicComponents>2</ElectronicComponents>
            </costList>
        </value>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[
            defName="SolarWeb-Stratum-PASpeaker_Hanging" or
            defName="SolarWeb-Stratum-PATransmitter" or
            defName="SolarWeb-Stratum-RooftopScannerBooster" or
            defName="SolarWeb-Stratum-RotaryTurbineVent" or
            defName="SolarWeb-Stratum-RooftopSolarGenerator"
        ]/constructEffect</xpath>
    </Operation>

    <!-- Keep ArchitectSense membership aligned with the buildings' actual
         architect tabs. Scanner and turbine memberships already live in HSK. -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[
            defName="SolarWeb-Stratum-PASpeaker_Hanging" or
            defName="SolarWeb-Stratum-PATransmitter"
        ]/designationCategory</xpath>
        <value>
            <designationCategory>Joy</designationCategory>
        </value>
    </Operation>

</Patch>
