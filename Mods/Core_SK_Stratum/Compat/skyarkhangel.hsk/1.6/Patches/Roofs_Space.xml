<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Hull roofs take over the old HSK thick-stone and bunker-roof progression. -->
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-HullPlating_Buildable"]</xpath>
    <value>
      <costList>
        <Steel>20</Steel>
      </costList>
      <researchPrerequisites>
        <li>Roof_D2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedHullPlating_Buildable"]</xpath>
    <value>
      <costList>
        <ReinforcedConcrete>40</ReinforcedConcrete>
      </costList>
      <researchPrerequisites>
        <li>Roof_D3</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-SolarHullPlate_Buildable"]</xpath>
    <value>
      <costList>
        <ReinforcedConcrete>40</ReinforcedConcrete>
        <Glass>5</Glass>
        <ComponentIndustrial>4</ComponentIndustrial>
        <Mechanism>2</Mechanism>
        <ElectronicComponents>2</ElectronicComponents>
      </costList>
      <researchPrerequisites>
        <li>Roof_D3</li>
        <li>SolarPanels</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedGlassPanel_Buildable"]</xpath>
    <value>
      <costList>
        <Glass>10</Glass>
        <Steel>20</Steel>
      </costList>
      <researchPrerequisites>
        <li>Construction_B3</li>
        <li>Roof_D2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <!-- Retractable roofs use HSK mechanisms/electronics instead of generic fabrication gates. -->
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofLight_Buildable"]</xpath>
    <value>
      <costList>
        <Steel>10</Steel>
        <Mechanism>2</Mechanism>
        <ElectronicComponents>2</ElectronicComponents>
      </costList>
      <researchPrerequisites>
        <li>Electronics_C2</li>
        <li>Roof_D2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoof_Buildable"]</xpath>
    <value>
      <costList>
        <Steel>20</Steel>
        <Plasteel>10</Plasteel>
        <Mechanism>4</Mechanism>
        <ElectronicComponents>4</ElectronicComponents>
      </costList>
      <researchPrerequisites>
        <li>Electronics_C2</li>
        <li>Roof_D3</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofConsole"]</xpath>
    <value>
      <costList>
        <Steel>100</Steel>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>5</ComponentIndustrial>
        <ComponentSpacer>1</ComponentSpacer>
        <Mechanism>10</Mechanism>
        <ElectronicComponents>10</ElectronicComponents>
      </costList>
      <researchPrerequisites>
        <li>Electronics_D1</li>
        <li>Roof_D3</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
