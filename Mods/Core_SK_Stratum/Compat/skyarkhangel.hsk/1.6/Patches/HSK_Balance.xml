<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Early roofs: stop the free/three-item roofs from bypassing HSK's construction economy. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofThatch_Buildable"]</xpath>
    <value>
      <costList>
        <Hay>5</Hay>
      </costList>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofShingle_Buildable"]/costStuffCount</xpath>
    <value><costStuffCount>10</costStuffCount></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofThatchHay_Buildable"]</xpath>
    <value><researchPrerequisites><li>Construction_B1</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofShingle_Buildable"]</xpath>
    <value><researchPrerequisites><li>Construction_B2</li></researchPrerequisites></value>
  </Operation>

  <!-- Preserve the old HSK transparent- and solar-roof material scale. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofGlass_Buildable"]/costList</xpath>
    <value><costList><Glass>5</Glass></costList></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofGlass_Buildable"]</xpath>
    <value><researchPrerequisites><li>Construction_B3</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofSolarShingles_Buildable"]/costList</xpath>
    <value>
      <costList>
        <Glass>5</Glass>
        <ComponentIndustrial>4</ComponentIndustrial>
        <Mechanism>2</Mechanism>
        <ElectronicComponents>2</ElectronicComponents>
      </costList>
    </value>
  </Operation>

  <!-- Insulated and specialist roofs. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-CompositeInsulatedPanel_Buildable"]/costList</xpath>
    <value><costList><Steel>10</Steel></costList></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-CompositeInsulatedPanel_Buildable"]/costStuffCount</xpath>
    <value><costStuffCount>10</costStuffCount></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-CompositeInsulatedPanel_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Temperature_control_C2</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-LuxuryGlassPanel_Buildable"]/stuffCategories</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-LuxuryGlassPanel_Buildable"]/costStuffCount</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-LuxuryGlassPanel_Buildable"]</xpath>
    <value><costList><Glass>10</Glass><Silver>10</Silver></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-LuxuryGlassPanel_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Construction_B3</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-SterileTiledRoof_Buildable"]/costList</xpath>
    <value><costList><Glass>5</Glass><Silver>10</Silver></costList></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ThermalRadiatorRoof_Buildable"]/costList</xpath>
    <value>
      <costList>
        <Steel>10</Steel>
        <Silver>5</Silver>
        <Mechanism>2</Mechanism>
        <ElectronicComponents>2</ElectronicComponents>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ThermalRadiatorRoof_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Temperature_control_C3</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-Thermostat"]/costList</xpath>
    <value><costList><Steel>10</Steel><ElectronicComponents>2</ElectronicComponents></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-Thermostat"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Temperature_control_C3</li></researchPrerequisites></value>
  </Operation>

  <!-- Hull roofs take over the old HSK thick-stone and bunker-roof progression. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-HullPlating_Buildable"]/costList</xpath>
    <value><costList><Steel>40</Steel></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-HullPlating_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Roof_D2</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedHullPlating_Buildable"]/costList</xpath>
    <value><costList><ReinforcedConcrete>40</ReinforcedConcrete></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedHullPlating_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Roof_D3</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-SolarHullPlate_Buildable"]/costList</xpath>
    <value>
      <costList>
        <ReinforcedConcrete>40</ReinforcedConcrete>
        <Glass>5</Glass>
        <ComponentIndustrial>4</ComponentIndustrial>
        <Mechanism>2</Mechanism>
        <ElectronicComponents>2</ElectronicComponents>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-SolarHullPlate_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Roof_D3</li><li>SolarPanels</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedGlassPanel_Buildable"]/costList</xpath>
    <value><costList><Glass>10</Glass><Steel>20</Steel></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-ReinforcedGlassPanel_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Construction_B3</li><li>Roof_D2</li></researchPrerequisites></value>
  </Operation>

  <!-- Retractable roofs use HSK mechanisms/electronics instead of generic fabrication gates. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofLight_Buildable"]/costList</xpath>
    <value><costList><Steel>10</Steel><Mechanism>2</Mechanism><ElectronicComponents>2</ElectronicComponents></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofLight_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Electronics_C2</li><li>Roof_D2</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoof_Buildable"]/costList</xpath>
    <value><costList><Steel>20</Steel><Plasteel>10</Plasteel><Mechanism>4</Mechanism><ElectronicComponents>4</ElectronicComponents></costList></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoof_Buildable"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Electronics_C2</li><li>Roof_D3</li></researchPrerequisites></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofConsole"]/costList</xpath>
    <value>
      <costList>
        <Steel>100</Steel>
        <Plasteel>30</Plasteel>
        <ComponentIndustrial>5</ComponentIndustrial>
        <ComponentSpacer>1</ComponentSpacer>
        <Mechanism>10</Mechanism>
        <ElectronicComponents>10</ElectronicComponents>
      </costList>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RetractableRoofConsole"]/researchPrerequisites</xpath>
    <value><researchPrerequisites><li>Electronics_D1</li><li>Roof_D3</li></researchPrerequisites></value>
  </Operation>
</Patch>
