<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Early roofs: stop the free/three-item roofs from bypassing HSK's construction economy. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofThatch_Buildable"]</xpath>
    <value>
      <costList>
        <Hay>2</Hay>
      </costList>
    </value>
  </Operation>

  <!-- Preserve the HSK construction effects previously embedded in Stratum's roof Defs. -->
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SolarWeb.Stratum.Defs.StratumRoofDef[defName="SolarWeb-Stratum-RoofThatch"]/modExtensions/li[@Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension"]</xpath>
    <value Merge="true">
      <sustainerSound>Harvest_Standard</sustainerSound>
      <finishSound>Harvest_Standard_Finish</finishSound>
      <workEffect>ConstructWood</workEffect>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/SolarWeb.Stratum.Defs.StratumRoofDef[defName="SolarWeb-Stratum-RoofThatchHay"]/modExtensions/li[@Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension"]</xpath>
    <value Merge="true">
      <sustainerSound>Harvest_Standard</sustainerSound>
      <finishSound>Harvest_Standard_Finish</finishSound>
      <workEffect>ConstructWood</workEffect>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofThatchHay_Buildable"]</xpath>
    <value>
      <costList>
        <Hay>3</Hay>
      </costList>
    </value>
  </Operation>

  <!--   <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofShingle_Buildable"]/costStuffCount</xpath>
    <value>
      <costStuffCount>3</costStuffCount>
    </value>
  </Operation> -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofThatchHay_Buildable"]</xpath>
    <value>
      <researchPrerequisites>
        <li>Construction_B1</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofShingle_Buildable"]</xpath>
    <value>
      <researchPrerequisites>
        <li>Construction_B2</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <!-- HSK clay bricks use the Bricks stuff category rather than Stony. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofShingle_Buildable"]/stuffCategories</xpath>
    <value>
		<stuffCategories>
		  <li>Woody</li>
		  <li>Stony</li>
		  <li>Bricks</li>
		</stuffCategories>
    </value>
  </Operation>

  <!-- Preserve the old HSK transparent- and solar-roof material scale. -->
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofGlass_Buildable"]</xpath>
    <value>
		<stuffCategories>
			<li>Glass</li>
		</stuffCategories>
		<costStuffCount>5</costStuffCount>
      <costList/>
      <researchPrerequisites>
        <li>Construction_B3</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofSolarShingles_Buildable"]/costList</xpath>
    <value>
		<stuffCategories>
			<li>Glass</li>
		</stuffCategories>
		<costStuffCount>5</costStuffCount>
		<costList>
			<ComponentIndustrial>2</ComponentIndustrial>
			<Mechanism>2</Mechanism>
			<ElectronicComponents>1</ElectronicComponents>
		</costList>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-RoofSolarShingles_Buildable"]</xpath>
    <value Merge="true">
      <researchPrerequisites DeepReplace="true">
        <li>SolarPanels</li>
      </researchPrerequisites>
    </value>
  </Operation>

  <!-- Insulated roofs. -->
  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[defName="SolarWeb-Stratum-CompositeInsulatedPanel_Buildable"]</xpath>
    <value>
      <costList>
        <Steel>5</Steel>
      </costList>
      <costStuffCount>10</costStuffCount>
      <researchPrerequisites>
        <li>Temperature_control_C2</li>
      </researchPrerequisites>
    </value>
  </Operation>
</Patch>
