<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="SolarWeb_Stratum_RoofBuildableBase">
    <defName>SolarWeb-Stratum-RoofShake_Buildable</defName>
    <label>shake roof</label>
    <description>Simple wooden shakes. Good thermal insulation, but flammable.</description>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Beauty>0</Beauty>
      <Flammability>1.0</Flammability>
      <SolarWeb-Stratum-Insulation>0.8</SolarWeb-Stratum-Insulation>
      <SolarWeb-Stratum-ThermalConductivity>0.1</SolarWeb-Stratum-ThermalConductivity>
      <SolarWeb-Stratum-DamageThreshold>2</SolarWeb-Stratum-DamageThreshold>
      <SolarWeb-Stratum-ArmorRating>0.1</SolarWeb-Stratum-ArmorRating>
      <SolarWeb-Stratum-StuffArmorMultiplier>1.0</SolarWeb-Stratum-StuffArmorMultiplier>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>4</costStuffCount>
    <uiOrder>2015</uiOrder>
    <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>Construction_B1</li>
    </researchPrerequisites>
  </ThingDef>

  <SolarWeb.Stratum.Defs.StratumRoofDef>
    <defName>SolarWeb-Stratum-RoofShake</defName>
    <label>shake roof</label>
    <description>Simple wooden shakes. Good insulation, but flammable.</description>
    <isThickRoof>false</isThickRoof>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundPunchThrough>PunchThroughRoofMetal</soundPunchThrough>
    <modExtensions>
      <li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
        <buildableDef>SolarWeb-Stratum-RoofShake_Buildable</buildableDef>
        <graphicData>
          <texPath>Roofs/ShingleRoof</texPath>
          <isSeamless>true</isSeamless>
        </graphicData>
        <designationCategory>Structure</designationCategory>
      </li>
      <li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
        <Name>Shake Roof</Name>
        <Properties>
          <ThermalCapacity>500</ThermalCapacity>
          <ThermalConductivity>0.1</ThermalConductivity>
          <FaceGasPermeability>0</FaceGasPermeability>
          <RadiativeConductivity>0.20</RadiativeConductivity>
          <MaxPressureDeltaKpa>50</MaxPressureDeltaKpa>
        </Properties>
      </li>
    </modExtensions>
  </SolarWeb.Stratum.Defs.StratumRoofDef>

</Defs>