<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/RoofDef[defName="RoofConstructed"]</xpath>
    <attribute>Class</attribute>
    <value>SolarWeb.Stratum.Defs.StratumRoofDef</value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/RoofDef[defName="RoofRockThin"]</xpath>
    <attribute>Class</attribute>
    <value>SolarWeb.Stratum.Defs.StratumRoofDef</value>
  </Operation>

  <Operation Class="PatchOperationAttributeSet">
    <xpath>Defs/RoofDef[defName="RoofRockThick"]</xpath>
    <attribute>Class</attribute>
    <value>SolarWeb.Stratum.Defs.StratumRoofDef</value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RoofDef[defName="RoofConstructed"]/label</xpath>
    <value>
      <label>standard roof</label>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RoofDef[defName="RoofConstructed"]</xpath>
    <value>
      <modExtensions>
        <li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
          <buildableDef>SolarWeb-Stratum-RoofStandard_Buildable</buildableDef>
          <graphicData>
            <texPath>Roofs/GenericTile</texPath>
            <isSeamless>true</isSeamless>
            <color>(0.55, 0.55, 0.55)</color>
          </graphicData>
        </li>
        <li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
          <Name>Ancient Roof</Name>
          <Properties>
            <ThermalCapacity>1000</ThermalCapacity>
            <ThermalConductivity>0.8</ThermalConductivity>
            <FaceGasPermeability>0</FaceGasPermeability>
            <!-- Plain constructed roofing, not engineered hull: a moderate emitter, on par with
                 shingle and sterile tile. Deliberately well above HullPlating's 0.05, which is
                 reserved for insulated pressure hull. Not stuffable, so no stuff can override. -->
            <RadiativeConductivity>0.20</RadiativeConductivity>
            <MaxPressureDeltaKpa>150</MaxPressureDeltaKpa>
          </Properties>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RoofDef[defName="RoofRockThin"]</xpath>
    <value>
      <modExtensions>
        <li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
          <buildableDef>SolarWeb-Stratum-RoofThinRock_Buildable</buildableDef>
          <graphicData>
            <texPath>Roofs/WornRockThin</texPath>
            <isSeamless>true</isSeamless>
          </graphicData>
        </li>
        <li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
          <Name>Thin Rock Roof</Name>
          <!-- Stuffable with Stony. The stuff genuinely is the material, but the room does not
               radiate through the rock — that transport is conduction, already covered by
               ThermalConductivity. Without this, stone's 0.90 would override the value below
               and freeze every mountain base. -->
          <SurfaceIndependentOfStuff>true</SurfaceIndependentOfStuff>
          <Properties>
            <ThermalCapacity>3000</ThermalCapacity>
            <ThermalConductivity>0.1</ThermalConductivity>
            <FaceGasPermeability>0</FaceGasPermeability>
            <RadiativeConductivity>0.02</RadiativeConductivity>
            <MaxPressureDeltaKpa>200</MaxPressureDeltaKpa>
          </Properties>
        </li>
      </modExtensions>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RoofDef[defName="RoofRockThick"]</xpath>
    <value>
      <modExtensions>
        <li Class="SolarWeb.Stratum.DefModExtensions.BuildableRoofExtension">
          <buildableDef>SolarWeb-Stratum-RoofOverheadMountain_Buildable</buildableDef>
          <graphicData>
            <texPath>Roofs/WornRockThin</texPath>
            <color>(0.75, 0.75, 0.75)</color>
            <isSeamless>true</isSeamless>
          </graphicData>
        </li>
        <li Class="SolarWeb.Kalyphos.DefModExtensions.StructuralProperties" MayRequire="SolarWeb.Kalyphos">
          <Name>Overhead Mountain</Name>
          <!-- As thin rock, more so: stuffable Stony, and there is no sky to radiate to under
               a mountain at all. -->
          <SurfaceIndependentOfStuff>true</SurfaceIndependentOfStuff>
          <Properties>
            <ThermalCapacity>10000</ThermalCapacity>
            <ThermalConductivity>0</ThermalConductivity>
            <FaceGasPermeability>0</FaceGasPermeability>
            <RadiativeConductivity>0</RadiativeConductivity>
            <MaxPressureDeltaKpa>5000</MaxPressureDeltaKpa>
          </Properties>
        </li>
      </modExtensions>
    </value>
  </Operation>

</Patch>