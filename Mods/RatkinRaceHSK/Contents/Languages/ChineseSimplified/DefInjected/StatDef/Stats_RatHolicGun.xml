<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: ranged cooldown reduction -->
  <RK_Stat_RangeCoolDown.label>远程冷却时间缩减</RK_Stat_RangeCoolDown.label>
  <!-- EN: Reduces the cooldown time of ranged weapons. This stat is used by RatHolic Gun spooling effect. -->
  <RK_Stat_RangeCoolDown.description>远程武器冷却时间会根据此项的值降低。此属性供鼠族吱特林机枪的预热效果使用。</RK_Stat_RangeCoolDown.description>
  <!-- EN: {0} s -->
  <RK_Stat_RangeCoolDown.formatString>{0}秒</RK_Stat_RangeCoolDown.formatString>
  
  <!-- EN: ranged cooldown multiplier -->
  <RK_Stat_RangeCoolDownMultiplier.label>远程冷却时间乘数</RK_Stat_RangeCoolDownMultiplier.label>
  <!-- EN: Multiplies the cooldown time of ranged weapons. This stat is used by RatHolic Gun spooling effect with statFactors. -->
  <RK_Stat_RangeCoolDownMultiplier.description>远程武器冷却时间会乘以此项的值。此属性供鼠族吱特林机枪的预热效果使用。</RK_Stat_RangeCoolDownMultiplier.description>
  <!-- EN: {0}× -->
  <RK_Stat_RangeCoolDownMultiplier.formatString>{0}×</RK_Stat_RangeCoolDownMultiplier.formatString>
  
</LanguageData>