<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Custom melee effects keep their Ratkin behavior, but CE owns hit/parry/armor resolution. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ManeuverDef[defName="RK_Maneuver_ChainSword"]/verb</xpath>
    <value>
      <verb Class="NewRatkin.CombatExtended.VerbProperties_ChainSwordCE">
        <verbClass>NewRatkin.CombatExtended.Verb_ChainSwordCE</verbClass>
        <meleeDamageDef>RK_Damage_Torn</meleeDamageDef>
      </verb>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ManeuverDef[defName="RK_Maneuver_HalberdCleave"]/verb/verbClass</xpath>
    <value>
      <verbClass>NewRatkin.CombatExtended.Verb_HalberdCleaveCE</verbClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ManeuverDef[defName="RK_GunlanceExplosion_Normal"]/verb/verbClass</xpath>
    <value>
      <verbClass>NewRatkin.CombatExtended.Verb_GunlanceFiringCE</verbClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ManeuverDef[defName="RK_MeleeExplosion"]/verb/verbClass</xpath>
    <value>
      <verbClass>NewRatkin.CombatExtended.Verb_MeleeExplosionCE</verbClass>
    </value>
  </Operation>

  <!-- Pulse rifle: restore its light-burst/heavy-shot Ratkin modes on top of CE. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RK_PrototypePulseRifle"]/verbs</xpath>
    <value>
      <verbs>
        <li Class="CombatExtended.VerbPropertiesCE">
          <verbClass>NewRatkin.CombatExtended.Verb_PulseRifleShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_RK_PrototypePulseRifleLight</defaultProjectile>
          <warmupTime>1</warmupTime>
          <burstShotCount>4</burstShotCount>
          <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
          <range>27</range>
          <soundCast>PrototypePulse</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>9</muzzleFlashScale>
          <recoilAmount>1.3</recoilAmount>
          <label>Rapid Fire</label>
        </li>
      </verbs>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RK_PrototypePulseRifle"]/comps</xpath>
    <value>
      <comps Inherit="false">
        <li Class="CompProperties_Forbiddable" />
        <li>
          <compClass>NewRatkin.CompEquippable_PulseRifle</compClass>
        </li>
        <li Class="CompProperties_Styleable" />
        <li Class="CompProperties_Biocodable" />
        <li>
          <compClass>CompQuality</compClass>
        </li>
        <li Class="NewRatkin.CompProperties_WeaponGripType">
          <gripTypes>
            <li>TwoHand</li>
          </gripTypes>
        </li>
        <li Class="NewRatkin.CompProperties_PulseRifleFireMode">
          <projectileBurst>Bullet_RK_PrototypePulseRifleLight</projectileBurst>
          <projectileSingle>Bullet_RK_PrototypePulseRifleHeavy</projectileSingle>
          <rangeBurst>27</rangeBurst>
          <rangeSingle>35</rangeSingle>
          <burstShotCountBurst>4</burstShotCountBurst>
          <burstShotCountSingle>2</burstShotCountSingle>
          <ticksBetweenBurstShotsBurst>10</ticksBetweenBurstShotsBurst>
          <ticksBetweenBurstShotsSingle>15</ticksBetweenBurstShotsSingle>
          <warmupTimeBurst>1</warmupTimeBurst>
          <warmupTimeSingle>1.7</warmupTimeSingle>
          <statOffsetsSingle>
            <AccuracyTouch>-0.10</AccuracyTouch>
            <AccuracyShort>-0.10</AccuracyShort>
            <AccuracyMedium>0.15</AccuracyMedium>
            <AccuracyLong>0.25</AccuracyLong>
            <RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
          </statOffsetsSingle>
          <iconPathBurst>UI/Commands/RK_Icon_BurstShot</iconPathBurst>
          <iconPathSingle>UI/Commands/RK_Icon_Snipe</iconPathSingle>
        </li>
        <li Class="CombatExtended.CompProperties_AmmoUser">
          <magazineSize>20</magazineSize>
          <reloadTime>3.5</reloadTime>
          <ammoSet>AmmoSet_6x24mmCharged</ammoSet>
        </li>
      </comps>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Bullet_RK_PrototypePulseRifleLight"]</xpath>
    <value>
      <thingClass>CombatExtended.BulletCE</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_RK_PrototypePulseRifleLight"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>Bullet</damageDef>
        <damageAmountBase>12</damageAmountBase>
        <armorPenetrationSharp>12</armorPenetrationSharp>
        <armorPenetrationBlunt>45</armorPenetrationBlunt>
        <speed>88</speed>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Bullet_RK_PrototypePulseRifleHeavy"]</xpath>
    <value>
      <thingClass>CombatExtended.BulletCE</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_RK_PrototypePulseRifleHeavy"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>Bullet</damageDef>
        <damageAmountBase>25</damageAmountBase>
        <armorPenetrationSharp>20</armorPenetrationSharp>
        <armorPenetrationBlunt>90</armorPenetrationBlunt>
        <speed>88</speed>
        <spreadMult>0.6</spreadMult>
      </projectile>
    </value>
  </Operation>

  <!-- BFR: retain the Ratkin AP/HE toggle while using CE verbs and CE projectiles. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RK_Weapon_BFR"]/verbs</xpath>
    <value>
      <verbs>
        <li Class="CombatExtended.VerbPropertiesCE">
          <verbClass>NewRatkin.CombatExtended.Verb_BFRShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_BFR_AP</defaultProjectile>
          <soundCast>RK_Sound_BFRFire</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>12</muzzleFlashScale>
          <recoilAmount>2.2</recoilAmount>
          <warmupTime>2.5</warmupTime>
          <burstShotCount>1</burstShotCount>
          <range>44.9</range>
          <label>AP fire</label>
        </li>
      </verbs>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RK_Weapon_BFR"]/statBases</xpath>
    <value>
      <SightsEfficiency>1.2</SightsEfficiency>
      <ShotSpread>0.08</ShotSpread>
      <SwayFactor>1.4</SwayFactor>
      <Bulk>12</Bulk>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RK_Weapon_BFR"]/comps</xpath>
    <value>
      <li Class="CombatExtended.CompProperties_FireModes">
        <aiAimMode>AimedShot</aiAimMode>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RK_Weapon_BFR"]/tools</xpath>
    <value>
      <tools>
        <li Class="CombatExtended.ToolCE">
          <label>stock</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>10</power>
          <cooldownTime>3</cooldownTime>
          <armorPenetrationBlunt>4</armorPenetrationBlunt>
          <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
        </li>
        <li Class="CombatExtended.ToolCE">
          <label>barrel</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>10</power>
          <cooldownTime>3</cooldownTime>
          <armorPenetrationBlunt>4</armorPenetrationBlunt>
          <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
        </li>
      </tools>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_BFR_AP"]/thingClass</xpath>
    <value>
      <thingClass>CombatExtended.BulletCE</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_BFR_AP"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>RangedStab</damageDef>
        <damageAmountBase>25</damageAmountBase>
        <armorPenetrationSharp>30</armorPenetrationSharp>
        <armorPenetrationBlunt>110</armorPenetrationBlunt>
        <speed>95</speed>
        <suppressionFactor>1.5</suppressionFactor>
        <alwaysFreeIntercept>true</alwaysFreeIntercept>
        <flyOverhead>false</flyOverhead>
        <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
        <soundImpactAnticipate>Flying</soundImpactAnticipate>
        <soundAmbient>MortarRound_Ambient</soundAmbient>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_BFR_HE"]/thingClass</xpath>
    <value>
      <thingClass>NewRatkin.CombatExtended.Projectile_BFRProximityCE</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Bullet_BFR_HE"]/projectile</xpath>
    <value>
      <projectile Class="NewRatkin.CombatExtended.ProjectileProperties_BFRProximityCE">
        <damageDef>Bomb</damageDef>
        <damageAmountBase>22</damageAmountBase>
        <speed>75</speed>
        <suppressionFactor>1.5</suppressionFactor>
        <alwaysFreeIntercept>true</alwaysFreeIntercept>
        <flyOverhead>false</flyOverhead>
        <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
        <soundExplode>Shockwave</soundExplode>
        <soundImpactAnticipate>Flying</soundImpactAnticipate>
        <soundAmbient>MortarRound_Ambient</soundAmbient>
        <preDetonationDistance>2</preDetonationDistance>
        <sectorAngle>120</sectorAngle>
        <sectorRadius>3.7</sectorRadius>
        <explosionDamageFalloff>true</explosionDamageFalloff>
      </projectile>
    </value>
  </Operation>
</Patch>
