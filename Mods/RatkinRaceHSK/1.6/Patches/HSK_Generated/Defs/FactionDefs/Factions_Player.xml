<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<!-- Overrides for 1.6\Defs\FactionDefs\Factions_Player.xml -->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/FactionDef[@Name="RK_PlayerFactionBase"]</xpath>
		<value>
			<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
			<colorSpectrum>
				<li>(0, 0.737, 0.847)</li>
			</colorSpectrum>
			<raidLootValueFromPointsCurve>
				<points>
					<li>(35,     8)</li>
					<li>(100,   60)</li>
					<li>(1000, 250)</li>
					<li>(2000, 400)</li>
					<li>(4000, 500)</li>
				</points>
			</raidLootValueFromPointsCurve>
			<allowedCultures>
				<li>RK_Culture_Virtuard</li>
			</allowedCultures>
			<disallowedMemes>
				<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
			</disallowedMemes>
		</value>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/FactionDef[@Name="RK_PlayerFactionBase"]/melaninRange</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/FactionDef[@Name="RK_PlayerFactionBase"]/xenotypeSet</xpath>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/FactionDef[defName="RK_PlayerFaction"]</xpath>
		<value>
			<isPlayer>true</isPlayer>
			<basicMemberKind>RatkinColonist</basicMemberKind>
			<pawnSingular>Ratkin</pawnSingular>
			<pawnsPlural>colonists</pawnsPlural>
			<techLevel>Medieval</techLevel>
			<backstoryCategories>
				<li>Offworld</li>
			</backstoryCategories>
			<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
			<factionIconPath>Icon/RK_icon</factionIconPath>
			<playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
			<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
			<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
			<melaninRange>0~1</melaninRange>
			<xenotypeSet>
				<xenotypeChances>
					<RK_XenoType_Ratkin MayRequire="Ludeon.RimWorld.Biotech">0.7</RK_XenoType_Ratkin>
					<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0.1</Sanguophage>
					<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0.02</Dirtmole>
					<Hussar MayRequire="Ludeon.RimWorld.Biotech">0.02</Hussar>
					<Waster MayRequire="Ludeon.RimWorld.Biotech">0.02</Waster>
					<Pigskin MayRequire="Ludeon.RimWorld.Biotech">0.02</Pigskin>
					<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.02</Neanderthal>
					<Impid MayRequire="Ludeon.RimWorld.Biotech">0.02</Impid>
					<Genie MayRequire="Ludeon.RimWorld.Biotech">0.02</Genie>
					<Yttakin MayRequire="Ludeon.RimWorld.Biotech">0.02</Yttakin>
					<Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.02</Starjack>
				</xenotypeChances>
			</xenotypeSet>
			<startingResearchTags>
				<li>RK_ResearchTag_IndustrialBasic</li>
			</startingResearchTags>
			<startingTechprintsResearchTags>
				<li>RK_ResearchTag_IndustrialBasic</li>
			</startingTechprintsResearchTags>
			<apparelStuffFilter>
				<thingDefs>
					<li>Steel</li>
					<li>DevilstrandCloth</li>
					<li>RK_Wool_KingHamster</li>
					<li>FerrosiliconAlloy</li>
					<li>CupronickelAlloy</li>
					<li>SteelBar</li>
				</thingDefs>
			</apparelStuffFilter>
		</value>
	</Operation>
</Patch>