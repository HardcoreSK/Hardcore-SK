<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<!-- Overrides for 1.6\Defs\ThingsDefs\Apparel_DropOnly.xml -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Sack"]</xpath>
		<value>
			<ThingDef ParentName="RK_ApparelMakeableBase">
				<defName>RK_Sack</defName>
				<label>ratkin package</label>
				<description>등에 편하게 맬 수 있는 등짐가방입니다. 물건을 많이 넣을 수 있기때문에 도둑들이 애용합니다.</description>
				<graphicData>
					<texPath>Apparel/RK_Sack</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<recipeMaker Inherit="false">
		</recipeMaker>
				<costList>
					<Plasteel>10</Plasteel>
				</costList>
				<costStuffCount>180</costStuffCount>
				<stuffCategories>
					<li>Leathery</li>
					<li>Fabric</li>
				</stuffCategories>
				<techLevel>Medieval</techLevel>
				<statBases>
					<MaxHitPoints>115</MaxHitPoints>
					<WorkToMake>8000</WorkToMake>
					<Mass>0.5</Mass>
					<EquipDelay>1.5</EquipDelay>
					<Insulation_Cold>2</Insulation_Cold>
					<StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
				</statBases>
				<equippedStatOffsets>
					<CarryingCapacity>30</CarryingCapacity>
					<CarryBulk>35</CarryBulk>
					<MoveSpeed>-0.16</MoveSpeed>
					<WorkSpeedGlobal>-0.12</WorkSpeedGlobal>
					<GermResistance>0.02</GermResistance>
					<GermContainment>0.01</GermContainment>
				</equippedStatOffsets>
				<apparel>
					<countsAsClothingForNudity>false</countsAsClothingForNudity>
					<bodyPartGroups>
						<li>Shoulders</li>
					</bodyPartGroups>
					<defaultOutfitTags>
						<li>Worker</li>
						<li>Soldier</li>
					</defaultOutfitTags>
					<wornGraphicPath>Apparel/RK_Sack</wornGraphicPath>
					<layers>
						<li>Backpack</li>
					</layers>
					<tags>
						<li>RK_Package</li>
						<li>RK_Thief</li>
						<li>RK_Loadbearing</li>
					</tags>
				</apparel>
				<tradeability>Sellable</tradeability>
				<tradeTags Inherit="false">
		</tradeTags>
			</ThingDef>
		</value>
	</Operation>
