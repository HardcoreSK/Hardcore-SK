<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_HeavyShield"]</xpath>
		<value>
			<ThingDef ParentName="Shield_Base">
				<defName>RK_HeavyShield</defName>
				<label>ratkin heavy Shield</label>
				<description>금속 방패.</description>
				<graphicData>
					<texPath>Apparel/RK_HeavyShield</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<recipeMaker>
					<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
					<researchPrerequisite>PlateArmor</researchPrerequisite>
					<recipeUsers Inherit="false">
						<li>RK_FueledSmithy</li>
						<li>RK_ElectricSmithy</li>
					</recipeUsers>
					<defaultIngredientFilter>
						<disallowedThingDefs>
							<li>Gold</li>
							<li>Silver</li>
						</disallowedThingDefs>
					</defaultIngredientFilter>
				</recipeMaker>
				<costList>
					<Plasteel>60</Plasteel>
				</costList>
				<costStuffCount>120</costStuffCount>
				<stuffCategories>
					<li>StrongMetallic</li>
				</stuffCategories>
				<techLevel>Medieval</techLevel>
				<statBases>
					<MaxHitPoints>200</MaxHitPoints>
					<WorkToMake>35000</WorkToMake>
					<Mass>7</Mass>
					<Bulk>8</Bulk>
					<WornBulk>4</WornBulk>
					<StuffEffectMultiplierArmor>1.4</StuffEffectMultiplierArmor>
					<StuffEffectMultiplierInsulation_Cold>0.01</StuffEffectMultiplierInsulation_Cold>
					<StuffEffectMultiplierInsulation_Heat>0.01</StuffEffectMultiplierInsulation_Heat>
					<ArmorRating_Sharp>3.4</ArmorRating_Sharp>
					<ArmorRating_Blunt>8.1</ArmorRating_Blunt>
					<Flammability>0.3</Flammability>
					<EquipDelay>2</EquipDelay>
				</statBases>
				<equippedStatOffsets>
					<MoveSpeed>-0.01</MoveSpeed>
					<WorkSpeedGlobal>-0.01</WorkSpeedGlobal>
					<MeleeDodgeChance>-0.1</MeleeDodgeChance>
					<ReloadSpeed>-0.4</ReloadSpeed>
					<ShootingAccuracyPawn>-0.4</ShootingAccuracyPawn>
					<AimingAccuracy>-0.4</AimingAccuracy>
					<MeleeCritChance>-0.15</MeleeCritChance>
					<Suppressability>-0.55</Suppressability>
					<MeleeParryChance>1</MeleeParryChance>
				</equippedStatOffsets>
				<apparel>
					<countsAsClothingForNudity>false</countsAsClothingForNudity>
					<defaultOutfitTags>
						<li>Worker</li>
						<li>Soldier</li>
					</defaultOutfitTags>
					<wornGraphicPath>Apparel/RK_HeavyShield</wornGraphicPath>
					<tags>
						<li>RK_HeavyArmor</li>
					</tags>
					<renderNodeProperties>
						<li>
							<nodeClass>CombatExtended.PawnRenderNode_Apparel</nodeClass>
							<workerClass>CombatExtended.PawnRenderNodeWorker_Drafted</workerClass>
							<texPath>Apparel/RK_HeavyShield</texPath>
							<shaderTypeDef>CutoutComplex</shaderTypeDef>
							<parentTagDef>ApparelBody</parentTagDef>
							<drawData>
								<scale>0.75</scale>
								<defaultData>
									<layer>80</layer>
								</defaultData>
								<dataNorth>
									<layer>-5</layer>
									<offset>(-0.1, 0, -0.2)</offset>
								</dataNorth>
								<dataEast>
									<layer>-5</layer>
									<offset>(0, 0, -0.2)</offset>
									<rotationOffset>30</rotationOffset>
								</dataEast>
								<dataSouth>
									<offset>(0.1, 0, -0.2)</offset>
								</dataSouth>
								<dataWest>
									<offset>(0, 0, -0.2)</offset>
									<rotationOffset>-30</rotationOffset>
								</dataWest>
							</drawData>
						</li>
					</renderNodeProperties>
				</apparel>
				<thingCategories>
					<li>ShieldCat</li>
				</thingCategories>
				<modExtensions>
					<li Class="CombatExtended.ShieldDefExtension">
						<shieldCoverage>
							<li>LeftHand</li>
							<li>LeftArm</li>
							<li>LeftShoulder</li>
							<li>Torso</li>
						</shieldCoverage>
						<crouchCoverage>
							<li>Hands</li>
							<li>Arms</li>
							<li>Shoulders</li>
							<li>Torso</li>
							<li>Neck</li>
							<li>FullHead</li>
						</crouchCoverage>
					</li>
				</modExtensions>
			</ThingDef>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
