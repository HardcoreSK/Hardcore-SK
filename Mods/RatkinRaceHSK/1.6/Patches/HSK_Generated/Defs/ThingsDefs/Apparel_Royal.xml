<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<!-- Overrides for 1.6\Defs\ThingsDefs\Apparel_Royal.xml -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_RoyalCrown"]</xpath>
		<value>
			<ThingDef ParentName="RK_HatMakeableBase">
				<defName>RK_RoyalCrown</defName>
				<label>Ratkin royal crown</label>
				<description>금속제 왕관입니다.</description>
				<graphicData>
					<texPath>Apparel/RK_RoyalCrown</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<costList>
					<Plasteel>25</Plasteel>
				</costList>
				<costStuffCount>75</costStuffCount>
				<stuffCategories>
					<li>Metallic</li>
				</stuffCategories>
				<statBases>
					<MaxHitPoints>80</MaxHitPoints>
					<WorkToMake>12000</WorkToMake>
					<Mass>0.6</Mass>
					<EquipDelay>0.8</EquipDelay>
					<StuffEffectMultiplierArmor>0.11</StuffEffectMultiplierArmor>
					<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
					<ArmorRating_Blunt>1.1</ArmorRating_Blunt>
					<ArmorRating_Heat>0.11</ArmorRating_Heat>
				</statBases>
				<equippedStatOffsets>
					<SocialImpact>0.2</SocialImpact>
					<MoveSpeed>-0.05</MoveSpeed>
					<WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
					<NegotiationAbility>0.05</NegotiationAbility>
					<Suppressability>-0.05</Suppressability>
					<GermResistance>0.02</GermResistance>
					<GermContainment>0.02</GermContainment>
				</equippedStatOffsets>
				<apparel>
					<countsAsClothingForNudity>false</countsAsClothingForNudity>
					<bodyPartGroups>
						<li>UpperHead</li>
					</bodyPartGroups>
					<wornGraphicPath>Apparel/RK_RoyalCrown</wornGraphicPath>
					<layers>
						<li>Overhead</li>
					</layers>
					<defaultOutfitTags>
						<li>Worker</li>
						<li>Soldier</li>
					</defaultOutfitTags>
					<tags>
						<li>RK_Noble</li>
						<li>RK_3Tier</li>
						<li>Royal</li>
						<li>RoyalTier5</li>
						<li>RoyalTier6</li>
						<li>RoyalTier7</li>
					</tags>
				</apparel>
				<recipeMaker>
					<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
					<researchPrerequisite>PlateArmor</researchPrerequisite>
					<workSkill>Crafting</workSkill>
					<effectWorking>Smith</effectWorking>
					<soundWorking>Recipe_Smith</soundWorking>
					<recipeUsers Inherit="false">
						<li>RK_FueledSmithy</li>
						<li>RK_ElectricSmithy</li>
					</recipeUsers>
					<defaultIngredientFilter>
						<categories>
							<li>Root</li>
						</categories>
						<disallowedThingDefs>
							<li>Jade</li>
							<li>Uranium</li>
						</disallowedThingDefs>
					</defaultIngredientFilter>
				</recipeMaker>
			</ThingDef>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_RoyalRobe"]</xpath>
		<value>
			<ThingDef ParentName="RK_ApparelMakeableBase">
				<defName>RK_RoyalRobe</defName>
				<label>ratkin royal robe</label>
				<description>고풍스러운 귀족을 위한 외투입니다. 직물을 여러번 덧대어 튼튼하고 방풍이 잘되도록 만들었습니다.</description>
				<graphicData>
					<texPath>Apparel/RK_RoyalRobe</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<recipeMaker>
					<researchPrerequisite>Ratkin_Apparel_C1</researchPrerequisite>
				</recipeMaker>
				<costStuffCount>120</costStuffCount>
				<stuffCategories>
					<li>Fabric</li>
					<li>HF</li>
				</stuffCategories>
				<techLevel>Medieval</techLevel>
				<statBases>
					<MaxHitPoints>100</MaxHitPoints>
					<WorkToMake>10000</WorkToMake>
					<Mass>3</Mass>
					<Insulation_Cold>12</Insulation_Cold>
					<StuffEffectMultiplierArmor>0.36</StuffEffectMultiplierArmor>
					<ArmorRating_Sharp>1.0</ArmorRating_Sharp>
					<ArmorRating_Blunt>2.6</ArmorRating_Blunt>
					<ArmorRating_Heat>0.08</ArmorRating_Heat>
					<StuffEffectMultiplierInsulation_Cold>1.4</StuffEffectMultiplierInsulation_Cold>
					<EquipDelay>2.5</EquipDelay>
				</statBases>
				<equippedStatOffsets>
					<CarryBulk>5</CarryBulk>
					<MoveSpeed>-0.05</MoveSpeed>
					<WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
					<MentalBreakThreshold>-0.01</MentalBreakThreshold>
					<Suppressability>-0.15</Suppressability>
					<SocialImpact>0.2</SocialImpact>
					<TradePriceImprovement>0.1</TradePriceImprovement>
					<GermResistance>0.05</GermResistance>
					<GermContainment>0.03</GermContainment>
				</equippedStatOffsets>
				<apparel>
					<bodyPartGroups>
						<li>Torso</li>
						<li>Neck</li>
						<li>Shoulders</li>
						<li>Arms</li>
						<li>Legs</li>
					</bodyPartGroups>
					<defaultOutfitTags>
						<li>Worker</li>
						<li>Soldier</li>
					</defaultOutfitTags>
					<wornGraphicPath>Apparel/RK_RoyalRobe</wornGraphicPath>
					<layers>
						<li>Shell</li>
					</layers>
					<tags>
						<li>RK_Noble</li>
						<li>RK_3Tier</li>
						<li>Royal</li>
						<li>RoyalTier6</li>
						<li>RoyalTier7</li>
					</tags>
				</apparel>
			</ThingDef>
		</value>
	</Operation>
</Patch>