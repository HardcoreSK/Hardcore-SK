<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Backpack"]</xpath>
		<value>
			<ThingDef ParentName="RK_ApparelMakeableBase">
				<defName>RK_Backpack</defName>
				<label>backpack</label>
				<description>등에 맬 수 있는 가방입니다. 짐을 더 많이 나를 수 있게 해줍니다.</description>
				<graphicData>
					<texPath>Apparel/RK_Backpack</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<recipeMaker>
					<researchPrerequisite>Ratkin_Apparel_C1</researchPrerequisite>
				</recipeMaker>
				<costStuffCount>40</costStuffCount>
				<stuffCategories>
					<li>Leathery</li>
				</stuffCategories>
				<costList>
					<Plasteel>10</Plasteel>
				</costList>
				<statBases>
					<MaxHitPoints>65</MaxHitPoints>
					<WorkToMake>5500</WorkToMake>
					<Mass>0.3</Mass>
					<Insulation_Cold>2</Insulation_Cold>
					<StuffEffectMultiplierArmor>0.14</StuffEffectMultiplierArmor>
					<ArmorRating_Sharp>0.4</ArmorRating_Sharp>
					<ArmorRating_Blunt>0.95</ArmorRating_Blunt>
					<ArmorRating_Heat>0.07</ArmorRating_Heat>
					<StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
					<EquipDelay>2</EquipDelay>
				</statBases>
				<equippedStatOffsets>
					<CarryWeight>20</CarryWeight>
					<CarryBulk>25</CarryBulk>
					<MoveSpeed>-0.09</MoveSpeed>
					<WorkSpeedGlobal>-0.06</WorkSpeedGlobal>
					<GermResistance>0.03</GermResistance>
					<GermContainment>0.02</GermContainment>
				</equippedStatOffsets>
				<apparel>
					<countsAsClothingForNudity>false</countsAsClothingForNudity>
					<bodyPartGroups>
						<li>Shoulders</li>
					</bodyPartGroups>
					<defaultOutfitTags>
						<li>Worker</li>
						<li>Soldier</li>
					</defaultOutfitTags>
					<wornGraphicPath>Apparel/RK_Backpack</wornGraphicPath>
					<layers>
						<li>Backpack</li>
					</layers>
					<tags>
						<li>RK_Apparel</li>
						<li>RK_Backpack</li>
						<li>RK_2Tier</li>
						<li>RK_Loadbearing</li>
					</tags>
				</apparel>
			</ThingDef>
		</value>
	</Operation>
