<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Plate"]</xpath>
		<value>
			<ThingDef ParentName="RK_ApparelMakeableBase">
				<defName>RK_Plate</defName>
				<label>ratkin plate armor</label>
				<description>금속으로 만든 방어구입니다. 덧입을 수 있어 방어력을 한층 더 올릴 수 있습니다.</description>
				<graphicData>
					<texPath>Apparel/RK_Plate</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<recipeMaker>
					<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
					<researchPrerequisite>PlateArmor</researchPrerequisite>
					<recipeUsers Inherit="false">
						<li>RK_FueledSmithy</li>
						<li>RK_ElectricSmithy</li>
					</recipeUsers>
					<defaultIngredientFilter>
						<disallowedThingDefs>
							<li>Gold</li>
							<li>Silver</li>
						</disallowedThingDefs>
					</defaultIngredientFilter>
				</recipeMaker>
				<costList>
					<Plasteel>60</Plasteel>
				</costList>
				<costStuffCount>100</costStuffCount>
				<stuffCategories>
					<li>StrongMetallic</li>
				</stuffCategories>
				<techLevel>Medieval</techLevel>
				<statBases>
					<MaxHitPoints>220</MaxHitPoints>
					<WorkToMake>32500</WorkToMake>
					<Mass>8</Mass>
					<Bulk>8</Bulk>
					<WornBulk>3</WornBulk>
					<Insulation_Cold>5</Insulation_Cold>
					<Insulation_Heat>5</Insulation_Heat>
					<StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
					<StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
					<StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
					<ArmorRating_Sharp>6.5</ArmorRating_Sharp>
					<ArmorRating_Blunt>8.4</ArmorRating_Blunt>
					<Flammability>0.0</Flammability>
					<EquipDelay>7</EquipDelay>
				</statBases>
				<equippedStatOffsets>
					<CarryBulk>10</CarryBulk>
					<MoveSpeed>-0.5</MoveSpeed>
					<WorkSpeedGlobal>-0.15</WorkSpeedGlobal>
					<MentalBreakThreshold>-0.1</MentalBreakThreshold>
					<ShootingAccuracyPawn>-0.11</ShootingAccuracyPawn>
					<AimingDelayFactor>0.14</AimingDelayFactor>
					<MeleeHitChance>-0.12</MeleeHitChance>
					<MeleeWeapon_CooldownMultiplier>0.16</MeleeWeapon_CooldownMultiplier>
					<Suppressability>-0.20</Suppressability>
					<MeleeDodgeChance>-0.08</MeleeDodgeChance>
					<PainShockThreshold>0.1</PainShockThreshold>
					<GermResistance>0.05</GermResistance>
					<GermContainment>0.05</GermContainment>
				</equippedStatOffsets>
				<apparel>
					<bodyPartGroups>
						<li>Torso</li>
						<li>Neck</li>
						<li>Shoulders</li>
						<li>Arms</li>
						<li>Legs</li>
					</bodyPartGroups>
					<defaultOutfitTags>
						<li>Soldier</li>
					</defaultOutfitTags>
					<wornGraphicPath>Apparel/RK_Plate</wornGraphicPath>
					<layers>
						<li>Middle</li>
					</layers>
					<tags>
						<li>RK_Melee</li>
						<li>RK_Knight</li>
						<li>RK_2Tier</li>
						<li>RK_KnightCommander</li>
						<li>RK_HeavyArmor</li>
						<li>RoyalCombatGear</li>
					</tags>
				</apparel>
			</ThingDef>
		</value>
	</Operation>
