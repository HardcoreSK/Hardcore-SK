<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<!-- Overrides for 1.6\Defs\TraitDefs\Trait_Singular.xml -->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/TraitDef[defName="Faith"]</xpath>
		<value>
			<commonality>0.001</commonality>
			<allowOnHostileSpawn>false</allowOnHostileSpawn>
			<degreeDatas>
				<li>
					<label>faith</label>
					<description>{PAWN_nameDef}의 믿음은 확고합니다. 그 어떤 힘든 상황에서도 {PAWN_objective} 움직일 수 있게 해줍니다.</description>
					<statOffsets>
						<PainShockThreshold>0.10</PainShockThreshold>
						<MentalBreakThreshold>-0.15</MentalBreakThreshold>
						<CarryWeight>15</CarryWeight>
					</statOffsets>
					<marketValueFactorOffset>0.25</marketValueFactorOffset>
				</li>
			</degreeDatas>
			<conflictingTraits>
				<li>ShootingAccuracy</li>
				<li>Wimp</li>
			</conflictingTraits>
		</value>
	</Operation>
</Patch>