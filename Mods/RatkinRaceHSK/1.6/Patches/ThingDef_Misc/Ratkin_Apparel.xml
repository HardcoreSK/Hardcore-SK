<?xml version="1.0" encoding="utf-8" ?>

<Patch>
	<Operation Class="PatchOperationSequence">
		<success></success>
		<operations>
			<li Class="PatchOperationFindMod">
				<mods>
					<li>NewRatkinPlus</li>
					<li>Solaris.RatkinRaceMod</li>
				</mods>
			</li>

	<!--NOTE: Numerous pieces of apparel aren't patched here. Apparel without a specific value for Bulk or WornBulk
		defaults to '1' for both. So, smallaer pieces of clothing don't need patched.-->			

			<!-- ========== Winter Robe =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_WinterRobe"]/statBases</xpath>
				<value>
					<Bulk>6</Bulk>
					<WornBulk>4</WornBulk>					
				</value>
			</li>			

			<!-- ========== Cardigan =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_Cardigan"]/statBases</xpath>
				<value>
					<Bulk>4</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>

			<!-- ========== Cardigan =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_FlatColorCoat"]/statBases</xpath>
				<value>
					<Bulk>5</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>

			<!-- ========== Crossback =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_CrossBack"]/statBases</xpath>
				<value>
					<Bulk>2</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>

			<!-- ========== Backpack =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_Backpack"]/statBases</xpath>
				<value>
					<Bulk>3</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>

			<!-- ========== Outoor Backpack =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_OutdoorBackpack"]/statBases</xpath>
				<value>
					<Bulk>4</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>

			<!-- ========== Sack =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_Sack"]/statBases</xpath>
				<value>
					<Bulk>5</Bulk>
					<WornBulk>2</WornBulk>					
				</value>
			</li>

			<!-- ========== Santa Sack =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_SantaSack"]/statBases</xpath>
				<value>
					<Bulk>6</Bulk>
					<WornBulk>2</WornBulk>					
				</value>
			</li>

			<!-- ========== Combat Helmet =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_BulletProofHelmet"]/statBases</xpath>
				<value>
					<Bulk>4</Bulk>
					<WornBulk>1</WornBulk>					
				</value>
			</li>	

			<!-- ========== Plate Armor =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RK_Plate"]/statBases</xpath>
				<value>
					<Bulk>8</Bulk>
					<WornBulk>3</WornBulk>					
				</value>
			</li>

			<!-- ========== Plate Armor - Helm =========== -->
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="RK_PlateHelmA"]</xpath>
				<value>
					<statBases Merge="True">
						<Bulk>4</Bulk>
						<WornBulk>1</WornBulk>
					</statBases>
				</value>
			</li>

			<!-- ========== Plate Armor - Helm =========== -->
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="RK_PlateHelmB"]</xpath>
				<value>
					<statBases Merge="True">
						<Bulk>4</Bulk>
						<WornBulk>1</WornBulk>
					</statBases>
				</value>
			</li>

			<!-- ========== Plate Armor - Helm =========== -->
			<li Class="SK.PatchOperationReplaceExtended">
				<xpath>Defs/ThingDef[defName="RK_PlateHelmC"]</xpath>
				<value>
					<statBases Merge="True">
						<Bulk>4</Bulk>
						<WornBulk>1</WornBulk>
					</statBases>
				</value>
			</li>	

			<!-- ========== Add proper tags to loadbearing gear. =========== -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[
					defName="RK_SantaSack" or
					defName="RK_Backpack" or
					defName="RK_CrossBack" or
					defName="RK_OutdoorBackpack" or
					defName="RK_Sack"					
				]/apparel/tags</xpath>
				<value>
					<li>RK_Loadbearing</li>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>
