<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Biotech xenoType 적용을 위해 RK_Race_Ratkin의 statBases 제거 -->
	<!-- xenoType에서 스탯을 정의하므로 ThingDef_AlienRace의 statBases는 더 이상 필요하지 않음 -->
	<!-- bodyAddons도 xenoType에서 정의하므로 ThingDef_AlienRace의 bodyAddons 제거 -->
	<!-- Biotech/Patches is already conditionally loaded by LoadFolders.xml. -->
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/statBases</xpath>
		<match Class="PatchOperationRemove">
			<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/statBases</xpath>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/alienRace/generalSettings/alienPartGenerator/bodyAddons/li[path="Body/RK_Tail" or path="Body/RK_EarLeft" or path="Body/RK_EarRight"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/alienRace/generalSettings/alienPartGenerator/bodyAddons/li[path="Body/RK_Tail" or path="Body/RK_EarLeft" or path="Body/RK_EarRight"]</xpath>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>/Defs/AlienRace.RaceSettings[defName="RK_Race_Setting"]/universalBodyAddons/li[path="Things/Ratkin/BodyAddon/RK_Texture_Tail" or path="Things/Ratkin/BodyAddon/RK_Texture_EarLeft" or path="Things/Ratkin/BodyAddon/RK_Texture_EarRight"]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>/Defs/AlienRace.RaceSettings[defName="RK_Race_Setting"]/universalBodyAddons/li[path="Things/Ratkin/BodyAddon/RK_Texture_Tail" or path="Things/Ratkin/BodyAddon/RK_Texture_EarLeft" or path="Things/Ratkin/BodyAddon/RK_Texture_EarRight"]</xpath>
		</match>
	</Operation>
</Patch>
