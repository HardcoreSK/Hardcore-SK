<Patch>
    <Operation Class="PatchOperationAttributeSet">
        <xpath>Defs/ThingDef[defName="Human" or defName="CreepJoiner"]</xpath>
        <attribute>Class</attribute>
        <value>AlienRace.ThingDef_AlienRace</value>
    </Operation>
    
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/PawnRenderTreeDef//li[texPath="Things/Pawn/Humanlike/Apparel/SwaddledBaby/Swaddled_Child"]/nodeClass</xpath>
        <value>
            <nodeClass>AlienRace.AlienPawnRenderNode_Swaddle</nodeClass>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Human"]</xpath>
        <value>
            <alienRace IgnoreIfNoMatchingField="True">
                <generalSettings>
                    <allowHumanBios>true</allowHumanBios>
                    <corpseCategory>CorpsesHumanlike</corpseCategory>
                    <alienPartGenerator>
                        <headTypes>
                            <li>Male_AverageNormal</li>
                            <li>Male_AverageWide</li>
                            <li>Male_AveragePointy</li>
                            <li>Male_NarrowNormal</li>
                            <li>Male_NarrowPointy</li>
                            <li>Male_NarrowWide</li>
                            <li>Female_AverageNormal</li>
                            <li>Female_AverageWide</li>
                            <li>Female_AveragePointy</li>
                            <li>Female_NarrowNormal</li>
                            <li>Female_NarrowPointy</li>
                            <li>Female_NarrowWide</li>
                        </headTypes>
                        <bodyTypes>
                            <li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
                            <li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
                            <li>Male</li>
                            <li>Female</li>
                            <li>Thin</li>
                            <li>Hulk</li>
                            <li>Fat</li>
                        </bodyTypes>
                        <colorChannels></colorChannels>
                        <bodyAddons></bodyAddons>
                    </alienPartGenerator>
                </generalSettings>
                <graphicPaths>
                    <skinShader>CutoutSkin</skinShader>
                </graphicPaths>
                <thoughtSettings>
                    <cannotReceiveThoughts></cannotReceiveThoughts>
                    <canStillReceiveThoughts></canStillReceiveThoughts>
                </thoughtSettings>
                <relationSettings>
                    <renamer></renamer>
                </relationSettings>
                <raceRestriction>
                    <apparelList></apparelList>
                    <whiteApparelList></whiteApparelList>
                    <weaponList></weaponList>
                    <whiteWeaponList></whiteWeaponList>
                    <buildingList></buildingList>
                    <whiteBuildingList></whiteBuildingList>
                    <recipeList></recipeList>
                    <plantList></plantList>
                    <whitePlantList></whitePlantList>
                    <traitList></traitList>
                    <whiteTraitList></whiteTraitList>
                    <foodList></foodList>
                    <petList></petList>
                    <conceptList></conceptList>
                    <workGiverList></workGiverList>
					<xenotypeList MayRequire="Ludeon.RimWorld.Biotech">
						<li MayRequire="Ludeon.RimWorld.Biotech">Baseliner</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Sanguophage</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Dirtmole</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Hussar</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Hussar</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Waster</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Pigskin</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Neanderthal</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Impid</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Genie</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Yttakin</li>
						<li MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">Starjack</li>
						
						<li MayRequire="Ludeon.RimWorld.Biotech">Baseline_Nova</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Baseline_Dova</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Baseline_Norbal</li>
						<li MayRequire="Ludeon.RimWorld.Biotech">Baseline_Orassan</li>
					</xenotypeList>
                </raceRestriction>
            </alienRace>
        </value>
    </Operation>
</Patch>
