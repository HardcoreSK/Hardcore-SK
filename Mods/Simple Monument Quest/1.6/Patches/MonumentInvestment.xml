    <xpath>/Defs/StatDef[defName="Beauty"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="Beauty"]/parts</xpath>
      <value><li Class="ZuoYao.SimpleMonumentQuest.StatPart_SimpleMonumentBeauty" /></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="Beauty"]</xpath>
      <value><parts><li Class="ZuoYao.SimpleMonumentQuest.StatPart_SimpleMonumentBeauty" /></parts></value>
    </nomatch>
  </Operation>
