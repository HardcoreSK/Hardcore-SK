      <xpath>/Defs/StatDef[defName="MeditationFocusStrength"]/parts</xpath>
      <value><li Class="ZuoYao.SimpleMonumentQuest.StatPart_SimpleMonumentFocus" /></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="MeditationFocusStrength"]</xpath>
      <value><parts><li Class="ZuoYao.SimpleMonumentQuest.StatPart_SimpleMonumentFocus" /></parts></value>
    </nomatch>
  </Operation>
</Patch>
